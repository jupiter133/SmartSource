      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "Are pre-owned consoles worth it?",
            "answer": "<p>Yes. A tested pre-owned console plays the same games for less, with a 1-year warranty and free 30-day returns.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Are consoles tested before sale?",
            "answer": "<p>Yes. Every console is checked by our technicians before it goes on sale.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "What does refurbished mean?",
            "answer": "<p>A refurbished device has had a previous owner, then gone through our technicians: tested, repaired where needed, wiped, cleaned and graded. It works like new and comes with a 1-year warranty.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "What's the difference between refurbished and used?",
            "answer": "<p>Used means sold as-is. Refurbished means professionally checked, fixed and backed by a warranty and free 30-day returns.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "What warranty and returns do I get?",
            "answer": "<p>Every device comes with a 1-year warranty and free 30-day returns, for any reason.</p>"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "question": "What about my old device?",
            "answer": "<p>Trade it in. Get an instant quote on our trade-in page and put the value toward your next device.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
