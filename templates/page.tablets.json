        "q2": {
          "type": "question",
          "settings": {
            "question": "Which tablet should I choose?",
            "answer": "<p>iPad suits people already using Apple devices; Galaxy Tab and other Android tablets suit Android users. Both are tested the same way.</p>"
          }
