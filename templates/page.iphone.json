      "blocks": {
        "p1": {
          "type": "part",
          "settings": {
            "heading": "Why buy a refurbished or pre-owned iPhone from SmartSource?",
            "body": "<p>Every iPhone is checked by our team before it goes on sale, and comes with a <strong>1-year warranty</strong> and <strong>free 30-day returns</strong>.</p>"
          }
        },
        "p2": {
          "type": "part",
          "settings": {
            "heading": "What iPhones can you find?",
            "body": "<ul><li><a href=\"/collections/all/iphone-16\">iPhone 16</a> and <a href=\"/collections/all/iphone-15\">iPhone 15</a></li><li><a href=\"/collections/all/iphone-13\">iPhone 13</a> and <a href=\"/collections/all/iphone-12\">iPhone 12</a></li><li><a href=\"/collections/all/iphone-se\">iPhone SE</a>: compact and affordable</li></ul>"
          }
        },
        "p3": {
          "type": "part",
          "settings": {
            "heading": "Understanding grades",
            "body": "<p>Grades only describe how a device looks, from <strong>Premium</strong> (like new) to <strong>Fair</strong> (visible wear). Every grade is fully functional and covered by the same warranty.</p>"
          }
        }
      },
