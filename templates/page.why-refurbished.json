    "faq": {
      "type": "sell-faq",
      "settings": {
        "heading": "Questions people ask before buying refurbished",
        "schema": true
      },
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "Is refurbished the same as used?",
            "answer": "<p>No. Used means sold as-is by whoever had it. Refurbished means our technicians tested it, fixed anything that failed, wiped it, graded it and put a 1-year warranty on it.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "Will the battery be good?",
            "answer": "<p>Yes. Every battery is tested, and any battery below our health threshold is replaced before the device goes on sale.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "Is it unlocked?",
            "answer": "<p>Yes. Our phones are carrier unlocked and free of any iCloud or Google account lock, so you can use any carrier.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "What if something goes wrong?",
            "answer": "<p>You have 30 days to return it for free, for any reason. After that, our 1-year warranty covers any defect that isn't caused by damage.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "Does it come with a charger?",
            "answer": "<p>Each device ships with a compatible charging cable. Check the product page for what's in the box.</p>"
          }
        },
        "question_6": {
          "type": "question",
          "settings": {
            "question": "Why is it so much cheaper than new?",
            "answer": "<p>You skip the new-in-box markup. The device has had one owner before you, and that's it. It's tested and backed the same way.</p>"
          }
        }
      },
