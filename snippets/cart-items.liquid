{%- if cart.item_count > 0 -%}
  <ul class="cart-lines">
    {%- for item in cart.items -%}
      <li class="cart-line">
        {%- if item.image -%}{{ item.image | image_url: width: 160 | image_tag: loading: 'lazy' }}{%- endif -%}
        <div>
          <a href="{{ item.url }}">{{ item.product.title }}</a>
          {%- unless item.product.has_only_default_variant -%}<p class="muted">{{ item.variant.title }}</p>{%- endunless -%}
          <div class="qty">
            <button data-qty="{{ item.key }}" data-val="{{ item.quantity | minus: 1 }}" aria-label="Decrease">−</button>
            <span>{{ item.quantity }}</span>
            <button data-qty="{{ item.key }}" data-val="{{ item.quantity | plus: 1 }}" aria-label="Increase">+</button>
          </div>
        </div>
        <strong>{{ item.final_line_price | money }}</strong>
      </li>
    {%- endfor -%}
  </ul>
  <div class="cart-total"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div>
  <form action="{{ routes.cart_url }}" method="post"><button name="checkout" class="btn btn--dark btn--block">Checkout</button></form>
{%- else -%}
  <p class="muted">Your cart is empty.</p>
  <a class="btn btn--dark" href="{{ routes.all_products_collection_url }}">Shop deals</a>
{%- endif -%}
