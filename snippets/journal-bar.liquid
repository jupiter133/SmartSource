{%- comment -%} Sticky Journal bar: main sections, category chips, search, dark mode. Pass active: tag handle. {%- endcomment -%}
{%- assign jb = settings.journal_blog | default: 'journal' -%}
{%- assign jroot = '/blogs/' | append: jb -%}
{%- assign j_sections = 'Comparisons|How-To Guides|Repair Guides' | split: '|' -%}
{%- assign j_cats = 'News|Tech Experts|Gifting|Deals|Refurb 101|Phones|Laptops|Tablets|Gaming|Audio|Accessories|Trade-In' | split: '|' -%}
{{ 'journal.css' | asset_url | stylesheet_tag }}
<script src="{{ 'journal.js' | asset_url }}" defer></script>
<div class="jr jr-bar" data-jr-bar>
  <div class="page-width jr-bar__row">
    <a class="jr-bar__home{% if active == blank %} is-active{% endif %}" href="{{ jroot }}">Journal</a>
    <nav class="jr-bar__main" aria-label="Journal sections">
      {%- for t in j_sections -%}{%- assign h = t | handleize -%}
        <a href="{{ jroot }}/tagged/{{ h }}"{% if active == h %} class="is-active" aria-current="page"{% endif %}>{{ t | replace: ' Guides', '' }}</a>
      {%- endfor -%}
    </nav>
    <form class="jr-bar__search" action="{{ routes.search_url }}" role="search">
      <input type="hidden" name="type" value="article">
      <input type="search" name="q" placeholder="Search guides" aria-label="Search the Journal" value="{% if search.performed %}{{ search.terms | escape }}{% endif %}">
      <button type="submit" aria-label="Search">{% render 'icon', name: 'search' %}</button>
    </form>
  </div>
  <div class="page-width jr-chips" role="list">
    {%- for t in j_cats -%}{%- assign h = t | handleize -%}
      <a role="listitem" class="jr-chip{% if active == h %} is-active{% endif %}" href="{{ jroot }}/tagged/{{ h }}">{{ t }}</a>
    {%- endfor -%}
  </div>
</div>
