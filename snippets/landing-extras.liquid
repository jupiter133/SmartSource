{%- comment -%}
  Product rows for "view all" landing pages (Android, Laptops, Audio…).
  Params: tag (collection tag, e.g. "android"), label (e.g. "Android phones")
  Rows load from /collections/all/<tag>?sort_by=…&section_id=landing-rows-api.
{%- endcomment -%}
<div class="lx" data-lx data-tag="{{ tag }}">
  <section class="section page-width lx-row lx-row--ca" data-carousel>
    <div class="section__head lx__head">
      <div><h2><span class="lx__flag" aria-hidden="true">{% render 'flag', code: 'CA' %}</span> Canada's best deals on {{ label }}</h2>
      <div class="lx__tabs" role="tablist"><button type="button" class="is-on" data-lx-tab="condition:refurbished" role="tab" aria-selected="true">Refurbished</button><button type="button" data-lx-tab="condition:certified-pre-owned" role="tab" aria-selected="false">Certified pre-owned</button></div></div>
      {% render 'carousel-arrows' %}
    </div>
    <div class="carousel carousel--cards" data-track data-lx-load="best-selling" data-lx-cond="condition:refurbished"></div>
  </section>
  <section class="section page-width lx-row" data-carousel>
    <div class="section__head"><h2>Best sellers</h2>{% render 'carousel-arrows' %}</div>
    <div class="carousel carousel--cards" data-track data-lx-load="best-selling"></div>
  </section>
  <section class="section page-width lx-row" data-carousel>
    <div class="section__head"><h2><span class="lx__spark" aria-hidden="true">✦</span> Steal deals</h2>{% render 'carousel-arrows' %}</div>
    <div class="carousel carousel--cards" data-track data-lx-load="price-ascending"></div>
  </section>
</div>
<script>
(function(){var X=document.querySelector('[data-lx]');if(!X||X.dataset.ready)return;X.dataset.ready=1;var tag=X.dataset.tag;
function load(track){var cond=track.dataset.lxCond,t=tag+(cond?'+'+encodeURIComponent(cond.replace(':','-')).toLowerCase():'');
var url='/collections/all/'+tag+(cond?'+'+cond.replace(':','-'):'')+'?sort_by='+track.dataset.lxLoad+'&section_id=landing-rows-api';
track.innerHTML='<p class="lx__loading">Loading…</p>';
fetch(url).then(function(r){return r.ok?r.text():''}).then(function(h){var d=document.createElement('div');d.innerHTML=h;var cards=d.querySelectorAll('.card, article, a.card');var wrap=d.querySelector('.shopify-section')||d;
var html=wrap.innerHTML.trim();var row=track.closest('.lx-row');
if(!html||!wrap.querySelector('*')){track.innerHTML='';if(row.classList.contains('lx-row--ca')){track.innerHTML='<p class="lx__empty">Nothing here yet. Check back soon.</p>'}else{row.hidden=true}return}
track.innerHTML=html;row.hidden=false}).catch(function(){track.innerHTML=''})}
X.querySelectorAll('[data-lx-load]').forEach(load);
X.querySelectorAll('[data-lx-tab]').forEach(function(b){b.onclick=function(){X.querySelectorAll('[data-lx-tab]').forEach(function(o){o.classList.toggle('is-on',o===b);o.setAttribute('aria-selected',o===b)});var tr=X.querySelector('[data-lx-cond]');tr.dataset.lxCond=b.dataset.lxTab;load(tr)}})})();
</script>
