{%- comment -%}
  Shared phone grid (financing + postpaid tabs). Pass keys: sorted "order:handle" list of financing_device entries.
{%- endcomment -%}
<div class="mp-devgroup" data-mp-devgroup>
    <div class="mp-chips" role="group" aria-label="{{ 'plans.financing.filter' | t | escape }}">
      <button type="button" class="mp-chip is-active" aria-pressed="true" data-mp-brand="all">{{ 'plans.common.all' | t }}</button>
      <button type="button" class="mp-chip" aria-pressed="false" data-mp-brand="apple">Apple</button>
      <button type="button" class="mp-chip" aria-pressed="false" data-mp-brand="samsung">Samsung</button>
      <button type="button" class="mp-chip" aria-pressed="false" data-mp-brand="google">Google</button>
    </div>
    <div class="mp-devices" data-mp-devices>
      {%- for k in keys -%}
        {%- assign h = k | split: ':' | last -%}{%- assign d = shop.metaobjects.financing_device[h] -%}
        {%- if d == blank -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign min = -1
          assign pm = d.price_matrix.value
          for m in pm
            for s in m[1]
              for o in s[1]
                if o.monthly != blank
                  if min < 0 or o.monthly < min
                    assign min = o.monthly
                  endif
                endif
              endfor
            endfor
          endfor
          assign img = d.images.value | first
          assign durl = d.system.url | default: '#'
        -%}
        <a class="mp-device" href="{{ durl }}" data-brand="{{ d.brand.value | downcase }}">
          <span class="mp-device__img">
            {%- if img != blank -%}{{ img | image_url: width: 600 | image_tag: loading: 'lazy', widths: '240,360,480,600', sizes: '(min-width: 1200px) 260px, (min-width: 990px) 22vw, (min-width: 750px) 30vw, 45vw', alt: d.name.value }}{%- else -%}{% render 'plans-phone-art', label: d.name.value %}{%- endif -%}
            <span class="mp-device__pill">{{ 'plans.common.phone_pill' | t }}</span>
            {%- if d.badge != blank -%}<span class="mp-badge mp-badge--corner">{{ d.badge.value }}</span>{%- endif -%}
          </span>
          <span class="mp-device__brand">{{ d.brand.value }}</span>
          <span class="mp-device__name">{{ d.name.value }}</span>
          <span class="mp-device__price">{%- if min >= 0 -%}{%- capture ms -%}{% render 'plans-money', amount: min %}{%- endcapture -%}{{ 'plans.common.from_month' | t: price: ms }}</span><span class="mp-device__plan">{{ 'plans.common.with_eligible_plan' | t }}{%- else -%}{{ 'plans.common.request_pricing' | t }}{%- endif -%}</span>
        </a>
      {%- endfor -%}
    </div>
    <p class="muted" data-mp-noresults hidden>{{ 'plans.financing.empty' | t }}</p>
</div>

