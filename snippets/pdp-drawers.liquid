{%- comment -%} Product page slide-out panels: unlocked, returns/warranty, promise. {%- endcomment -%}
{%- assign plink = promise_link | default: '/pages/our-promise' -%}
<dialog class="sd" id="sd-unlocked" aria-labelledby="sd-unlocked-t">
  <div class="sd__bar"><p id="sd-unlocked-t">What are unlocked phones?</p><button type="button" data-sd-close aria-label="Close">✕</button></div>
  <div class="sd__body">
    <h2 class="sd__h">Unlocked phones: work with all carriers</h2>
    <p>An unlocked phone isn't tied to one carrier. Use it with Rogers, Bell, Telus, Freedom, Fido, Koodo, Virgin, Public Mobile or any other Canadian carrier, and switch whenever you want.</p>
    <p>Every phone we sell is unlocked. Pop in your SIM or set up an eSIM and you're done. <a href="/collections/all/smartphones">See all our unlocked phones</a></p>
    <a class="sd-card" href="/blogs/journal">
      <span class="sd-card__img" aria-hidden="true">{% render 'icon', name: 'phone' %}</span>
      <span class="sd-card__body"><small>Journal</small><strong>How to activate your phone</strong><span>Moving your SIM, setting up eSIM and transferring your data, step by step.</span><u>See more</u></span>
    </a>
  </div>
</dialog>

<dialog class="sd" id="sd-returns" aria-labelledby="sd-returns-t">
  <div class="sd__bar"><p id="sd-returns-t">Returns and warranty</p><button type="button" data-sd-close aria-label="Close">✕</button></div>
  <div class="sd__body">
    <h2 class="sd__h2">Free 30-day returns</h2>
    <div class="sd-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 14V4H4v10zM7 14l4 7c1.5 0 2.5-1 2.3-2.5L13 15h5.5a2 2 0 002-2.3l-1.1-6.5A2 2 0 0017.4 4H7"/></svg><div><h3>Changed your mind?</h3><p>Return it for any reason within 30 days of delivery. No awkward questions.</p></div></div>
    <div class="sd-item"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><div><h3>Easy to start</h3><p>Contact us from your account or drop it at one of our stores.</p></div></div>
    <div class="sd-item"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M15 9.5c-.6-1-1.7-1.5-3-1.5-1.7 0-3 .9-3 2s1.3 1.7 3 2 3 .9 3 2-1.3 2-3 2c-1.3 0-2.4-.5-3-1.5M12 6v12"/></svg><div><h3>Get your money back</h3><p>Your refund goes back to your original payment method once we receive the return.</p></div></div>
    <hr>
    <h2 class="sd__h2">1-year warranty</h2>
    <div class="sd-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18h12M8 18v-6a4 4 0 018 0v6M12 3v2M4.5 6.5l1.4 1.4M19.5 6.5l-1.4 1.4M3 21h18"/></svg><div><h3>Defects covered for a full year</h3><p>If something stops working from normal use in the first year, we repair or replace it.</p></div></div>
    <div class="sd-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg><div><h3>Send it in or bring it in</h3><p>Visit a store or ship it to us. We'll walk you through it.</p></div></div>
    <div class="sd-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.7 6.3a4 4 0 00-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 005.4-5.4l-2.4 2.4-2.4-.6-.6-2.4z"/></svg><div><h3>Repair or replacement on us</h3><p>Fixed by our own technicians, or replaced if a repair isn't possible. No charge.</p></div></div>
  </div>
</dialog>

<dialog class="sd" id="sd-promise" aria-labelledby="sd-promise-t">
  <div class="sd__bar"><p id="sd-promise-t">The SmartSource Promise</p><button type="button" data-sd-close aria-label="Close">✕</button></div>
  <div class="sd__body">
    <div class="sd__hero" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 2l8 3v6.5c0 5-3.4 8.6-8 10.5-4.6-1.9-8-5.5-8-10.5V5z" fill="#111"/><path d="M8.5 12.3l2.4 2.4 4.6-4.8" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
    <h2 class="sd__h">Guaranteed by the SmartSource Promise</h2>
    <hr>
    <div class="sd-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/></svg><div><h3>Refurbished in-house</h3><p>Every device is inspected, repaired and graded by our own technicians in the GTA.</p></div></div>
    <div class="sd-item"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/></svg><div><h3>Checked from top to bottom</h3><p>Battery, screen, cameras, ports and more are tested before anything is listed.</p></div></div>
    <div class="sd-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 14v-2a8 8 0 0116 0v2M4 14a2 2 0 002 2h1v-5H6a2 2 0 00-2 2zm16 0a2 2 0 01-2 2h-1v-5h1a2 2 0 012 2z"/></svg><div><h3>You check out, we check in</h3><p>1-year warranty, free 30-day returns and real people to help when you need it.</p></div></div>
  </div>
  <div class="sd__foot"><a class="sd__btn" href="{{ plink }}">Learn more</a></div>
</dialog>

<dialog class="sd sd--tradein" id="sd-tradein" aria-labelledby="sd-tradein-t">
  <div class="sd__bar"><p id="sd-tradein-t">Trade-in</p><button type="button" data-sd-close aria-label="Close">✕</button></div>
  <div class="sd__body" data-ti-offer>
    <h2 class="sd-ti__h">Want to get this for even less? Trade in your old tech for cash.</h2>
    {%- assign est = product.metafields.custom.tradein_estimate.value -%}
    <div class="sd-ti__card">
      <span class="sd-ti__tag">{% if est %}With trade-in estimate{% else %}Added to your cart{% endif %}</span>
      <div class="sd-ti__row">
        {%- if product.featured_image -%}{{ product.featured_image | image_url: width: 200 | image_tag: alt: '', loading: 'lazy' }}{%- endif -%}
        <div><p class="sd-ti__name">{{ product.title }}</p>{%- if est -%}<p class="sd-ti__price">{{ est | money_without_trailing_zeros }}<sup>*</sup></p>{%- else -%}<p class="sd-ti__sub">Trade in a phone, tablet, laptop or console and put the cash toward it.</p>{%- endif -%}</div>
      </div>
    </div>
    {%- if est -%}<p class="sd-ti__note">*Price shown is an estimate after trade-in. Your actual offer depends on the device you send.</p>{%- endif -%}
  </div>
  <div class="sd__body ti" data-ti-wiz hidden>
    <div class="ti__nav" data-ti-navbar hidden><button type="button" class="ti__back" data-ti-back aria-label="Back">←</button><span data-ti-step></span><span></span></div>
    <div data-ti-pane></div>
  </div>
  <div class="sd-ti__foot" data-ti-foot>
    <button type="button" class="sd-ti__btn" data-ti-start><strong>Yes</strong><span>Get a trade-in offer in just 2 min</span></button>
    <button type="button" class="sd-ti__btn" data-tradein-skip><strong>Skip trade-in</strong><span>View your cart</span></button>
  </div>
</dialog>

<dialog class="ac" id="sd-added" aria-label="Added to cart" data-pid="{{ product.id }}">
  <div class="ac__top"><span class="ac__ok">✓</span><strong>Added to cart</strong>{%- if product.featured_image -%}{{ product.featured_image | image_url: width: 80 | image_tag: alt: '', class: 'ac__thumb' }}{%- endif -%}<span class="ac__name">{{ product.title }}</span></div>
  <div class="ac__body">
    <section class="ac__row" data-ac-row="complementary" hidden><div class="ac__head"><h2>Goes well with</h2><div class="ac__arrows"><button type="button" data-ac-prev aria-label="Previous">‹</button><button type="button" data-ac-next aria-label="Next">›</button></div></div><div class="ac__track" data-ac-track></div></section>
    <section class="ac__row" data-ac-row="related" hidden><div class="ac__head"><h2>Others also bought</h2><div class="ac__arrows"><button type="button" data-ac-prev aria-label="Previous">‹</button><button type="button" data-ac-next aria-label="Next">›</button></div></div><div class="ac__track" data-ac-track></div></section>
  </div>
  <div class="ac__foot"><button type="button" class="ac__back" data-sd-close>Back</button><a class="ac__go" href="/cart">Go to cart</a></div>
</dialog>

{% render 'sell-catalog' %}
<script type="application/json" data-ti-config>{"live": {{ settings.sell_live | json }}}</script>
<script>
(function(){if(window.__sd)return;window.__sd=1;
function shut(d){d.classList.add('is-closing');setTimeout(function(){d.classList.remove('is-closing');d.close()},260)}
document.addEventListener('click',function(e){var o=e.target.closest('[data-sd-open]');if(o){var d=document.getElementById(o.dataset.sdOpen);if(d&&!d.open){d.showModal()}return}
var c=e.target.closest('[data-sd-close]');if(c){shut(c.closest('dialog'));return}
if(e.target.classList&&e.target.classList.contains('sd')&&e.target.open)shut(e.target)});
(function(){var D=document.getElementById('sd-tradein');if(!D)return;
var cat={};try{cat=JSON.parse(document.querySelector('[data-sell-catalog]').textContent)}catch(e){}
var cfg={};try{cfg=JSON.parse(document.querySelector('[data-ti-config]').textContent)}catch(e){}
var C=(cat.categories||[]).slice().sort(function(a,b){return a.s-b.s}),B=(cat.brands||[]).slice().sort(function(a,b){return a.s-b.s}),V=(cat.devices||[]);
var pane=D.querySelector('[data-ti-pane]'),nav=D.querySelector('[data-ti-navbar]'),stepEl=D.querySelector('[data-ti-step]'),st={},hist=[];
var CARRIERS=['Unlocked','Rogers','Bell','Telus','Freedom','Fido','Koodo','Virgin Plus','Other'];
function money(n){return '$'+Math.round(n).toLocaleString('en-CA')}
function maxFor(list){var m=0;list.forEach(function(d){(d.pr||[]).forEach(function(p){(p.p||[]).forEach(function(x){if(+x>m)m=+x})})});return m}
function h(tag,cls,txt){var e=document.createElement(tag);if(cls)e.className=cls;if(txt!=null)e.textContent=txt;return e}
function show(name,title,build){if(hist[hist.length-1]!==name)hist.push(name);nav.hidden=hist.length<2;stepEl.textContent=title||'';pane.innerHTML='';build(pane);pane.scrollTop=0}
function back(){hist.pop();var p=hist.pop();({cat:stepCat,brand:stepBrand,model:stepModel,storage:stepStorage,carrier:stepCarrier,screen:stepScreen,body:stepBody,func:stepFunc}[p]||stepCat)()}
function stepCat(){show('cat','',function(p){p.appendChild(h('h2','ti__h','What do you want to sell?'));
var sw=h('label','ti__search');var inp=h('input');inp.type='search';inp.placeholder='Search your device';sw.appendChild(inp);p.appendChild(sw);var res=h('div','ti__results');p.appendChild(res);
inp.oninput=function(){var q=inp.value.trim().toLowerCase();res.innerHTML='';if(q.length<2)return;V.filter(function(d){return d.n.toLowerCase().indexOf(q)>-1}).slice(0,8).forEach(function(d){var b=h('button','ti__opt ti__opt--row',d.n);b.type='button';b.onclick=function(){st.cat=d.c;st.brand=d.b;st.dev=d;stepStorage()};res.appendChild(b)})};
p.appendChild(h('h3','ti__sub','Select a category'));
if(!C.length){p.appendChild(h('p','ti__empty','Trade-in categories are coming soon.'));}
C.forEach(function(c){var ds=V.filter(function(d){return d.c===c.h});if(!ds.length&&V.length)return;var b=h('button','ti__cat');b.type='button';
var im=h('span','ti__catimg');if(c.i){var i=h('img');i.src=c.i;i.alt='';im.appendChild(i)}b.appendChild(im);b.appendChild(h('span','ti__catname',c.n));
if(cfg.live){var m=maxFor(ds);if(m)b.appendChild(h('span','ti__upto','Up to '+money(m)))}
b.onclick=function(){st.cat=c.h;stepBrand()};p.appendChild(b)})})}
function stepBrand(){var c=C.find(function(x){return x.h===st.cat})||{n:'device'};var bs=B.filter(function(b){return V.some(function(d){return d.c===st.cat&&d.b===b.h})});
show('brand','Brand',function(p){p.appendChild(h('h2','ti__h','What brand is your '+c.n.toLowerCase()+'?'));var sel=h('select','ti__select');sel.appendChild(new Option('Brand',''));bs.forEach(function(b){sel.appendChild(new Option(b.n,b.h))});sel.onchange=function(){if(sel.value){st.brand=sel.value;stepModel()}};p.appendChild(sel)})}
function stepModel(){var ds=V.filter(function(d){return d.c===st.cat&&d.b===st.brand}).sort(function(a,b){return (b.y-a.y)||(a.s-b.s)});
show('model','Model',function(p){p.appendChild(h('h2','ti__h',"What's the specific title of your model?"));var sel=h('select','ti__select');sel.appendChild(new Option('Model',''));ds.forEach(function(d){sel.appendChild(new Option(d.n,d.h))});
sel.onchange=function(){st.dev=ds.find(function(d){return d.h===sel.value});if(st.dev)stepStorage()};p.appendChild(sel);
p.appendChild(h('p','ti__hint','Not sure? Go to Settings > General > About. If your model isn\'t in the list, we can\'t take it right now.'))})}
function stepStorage(){var opts=(st.dev.pr||[]).map(function(x){return x.st}).filter(Boolean);if(!opts.length){stepCarrier();return}
show('storage','Storage',function(p){p.appendChild(h('h2','ti__h',"What's the storage capacity?"));var g=h('div','ti__grid');opts.forEach(function(o){var b=h('button','ti__opt',o);b.type='button';b.onclick=function(){st.storage=o;stepCarrier()};g.appendChild(b)});p.appendChild(g);p.appendChild(h('p','ti__hint','Not sure? Go to Settings > General > About.'))})}
function stepCarrier(){show('carrier','Carrier',function(p){p.appendChild(h('h2','ti__h','Is your device unlocked or locked to a carrier?'));var g=h('div','ti__grid');CARRIERS.forEach(function(o){var b=h('button','ti__opt',o);b.type='button';b.onclick=function(){st.carrier=o;stepScreen()};g.appendChild(b)});p.appendChild(g);
p.appendChild(h('p','ti__hint','A locked phone only works with one carrier. Unlocked phones work with any carrier.'));p.appendChild(h('p','ti__hint','iPhone: Settings > General > About > Carrier Lock. Android: try a SIM from another carrier. If you get signal, it\'s unlocked.'))})}
var LV=[{k:'cracked',n:'Cracked',r:3},{k:'used',n:'Used',r:2},{k:'good',n:'Good',r:1},{k:'flawless',n:'Flawless',r:0}];
var TXT={screen:{cracked:'The screen is cracked or broken, or has defective pixels (ghost touch, burn-in, dead pixels), or the touchscreen doesn\'t work.',used:'Visible signs of wear, including deep scratches. No cracks. The screen has no defective pixels and the touchscreen works.',good:'A few faint signs of wear, not noticeable from 20 cm away. No cracks. The screen has no defective pixels and the touchscreen works.',flawless:'Flawless, with no visible scratches. The screen has no defective pixels and the touchscreen works.'},
body:{cracked:'Visible signs of wear, including deep scratches, cracks and/or dents on the outside.',used:'Visible signs of wear, including deep scratches and/or dents that don\'t affect how it works. No cracks.',good:'A few faint signs of wear, not noticeable from 20 cm away. No cracks or dents.',flawless:'Flawless, with no visible scratches.'}};
function art(kind,lvl){var marks='';if(lvl==='used')marks='<path d="M150 70l60-40M260 120l50-25M120 180l40-15M300 40l30-25" stroke="#fff" stroke-opacity=".55" stroke-width="1.4"/><path d="M180 150l90-55" stroke="#fff" stroke-opacity=".35" stroke-width="1"/>';
if(lvl==='good')marks='<path d="M250 70l30-14M170 160l22-9" stroke="#fff" stroke-opacity=".35" stroke-width="1"/>';
if(lvl==='cracked')marks='<path d="M95 22l40 60 30 10 25 50 45 30M135 82l-20 60M190 142l60-10 40 40M165 92l70-40 40 10" stroke="#fff" stroke-opacity=".8" stroke-width="1.6" fill="none"/>';
var fill=kind==='screen'?'url(#tiS)':'#3e3f44',extra=kind==='screen'?'<circle cx="110" cy="58" r="9" fill="#55565c"/>':'<rect x="150" y="40" width="44" height="150" rx="22" fill="#2a2b2f" stroke="#55565c" stroke-width="3"/><circle cx="172" cy="68" r="9" fill="#5b8bd9"/><circle cx="172" cy="100" r="7" fill="#eee"/><circle cx="172" cy="130" r="9" fill="#5b8bd9"/><circle cx="172" cy="162" r="9" fill="#5b8bd9"/>';
return '<svg viewBox="0 0 360 240" aria-hidden="true"><defs><linearGradient id="tiS" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#9aa0ad"/><stop offset="1" stop-color="#6f737d"/></linearGradient></defs><path d="M70 260V70a60 60 0 0160-60h240v250z" fill="#111"/><path d="M80 260V74a52 52 0 0152-52h238v238z" fill="'+fill+'"/>'+extra+marks+'</svg>'}
function condStep(key,title,q){show(key,title,function(p){p.appendChild(h('h2','ti__h',q));LV.forEach(function(l){var b=h('button','ti__cond');b.type='button';if(st[key]===l.k)b.classList.add('is-on');var im=h('span','ti__condimg');im.innerHTML=art(key,l.k);b.appendChild(im);b.appendChild(h('strong',null,l.n));b.appendChild(h('span',null,TXT[key][l.k]));
b.onclick=function(){st[key]=l.k;key==='screen'?stepBody():stepFunc()};p.appendChild(b)})})}
function stepScreen(){condStep('screen','Screen condition','How does the screen look?')}
function stepBody(){condStep('body','Condition of sides and back','How do the sides and back look?')}
function stepFunc(){show('func','Functionality',function(p){p.appendChild(h('h2','ti__h','Is it functional?'));var ul=h('ul','ti__checks');
['The device turns on, turns off and charges. It has its battery, case and SIM tray.','The front and rear cameras work perfectly.','The speakers and microphones work perfectly.','Touch ID or Face ID works (if it has one).','Everything else works, including Wi-Fi, Bluetooth and buttons.','Important: iCloud, Google and any other accounts must be signed out, whether it works or not. We don\'t accept bent or water-damaged devices.'].forEach(function(t){ul.appendChild(h('li',null,t))});p.appendChild(ul);
var g=h('div','ti__grid');['Yes','No'].forEach(function(o){var b=h('button','ti__opt',o);b.type='button';b.onclick=function(){st.func=o==='Yes';stepDone()};g.appendChild(b)});p.appendChild(g)})}
function grade(){if(st.func===false)return 4;var r=Math.max((LV.find(function(l){return l.k===st.screen})||{r:0}).r,(LV.find(function(l){return l.k===st.body})||{r:0}).r);return [0,1,2,3][r]}
function stepDone(){show('done','Your trade-in offer',function(p){var pr=(st.dev.pr||[]).find(function(x){return x.st===st.storage})||(st.dev.pr||[])[0];var val=cfg.live&&pr?+pr.p[grade()]:0;
var card=h('div','ti__offer');var top=h('div','ti__offer-top');var ck=h('span','ti__ck','✓');top.appendChild(ck);top.appendChild(h('span','ti__offer-name',st.dev.n+(st.storage?' · '+st.storage:'')));var rm=h('button','ti__rm','Remove');rm.type='button';rm.onclick=function(){st={};hist=[];try{sessionStorage.removeItem('ss-tradein')}catch(e){}stepCat()};top.appendChild(rm);card.appendChild(top);
if(val){card.appendChild(h('p','ti__congrats','Congrats on your offer!'));card.appendChild(h('p','ti__val',money(val)));card.appendChild(h('p','ti__vallbl','Trade-in value'))}
else{card.appendChild(h('p','ti__congrats','You’re almost there!'));card.appendChild(h('p','ti__vallbl','Confirm a few details on the next page and we’ll send your exact offer.'))}
var ul=h('ul','ti__perks');['Paid fast once we check your device','Free shipping label, or drop it off at a store','Your data is wiped before resale'].forEach(function(t){ul.appendChild(h('li',null,t))});card.appendChild(ul);p.appendChild(card);
try{sessionStorage.setItem('ss-tradein',JSON.stringify({d:st.dev.h,n:st.dev.n,st:st.storage,c:st.carrier,s:st.screen,b:st.body,f:st.func,v:val}))}catch(e){}
var go=h('a','sd__btn',val?'Lock in my offer':'Continue to my quote');go.href='/pages/sell-your-device?sell_device='+encodeURIComponent(st.dev.h)+'#sell-quote';p.appendChild(go);
var cart=h('a','ti__cartlink','Go to my cart');cart.href='/cart';p.appendChild(cart)})}
D.addEventListener('click',function(e){if(e.target.closest('[data-ti-start]')){D.querySelector('[data-ti-offer]').hidden=true;D.querySelector('[data-ti-foot]').hidden=true;D.querySelector('[data-ti-wiz]').hidden=false;st={};hist=[];stepCat()}
if(e.target.closest('[data-ti-back]'))back()});
D.addEventListener('close',function(){D.querySelector('[data-ti-offer]').hidden=false;D.querySelector('[data-ti-foot]').hidden=false;D.querySelector('[data-ti-wiz]').hidden=true})})();
window.ssOpenAdded=function(){var d=document.getElementById('sd-added');if(!d)return false;d.showModal();if(d.dataset.loaded)return true;d.dataset.loaded=1;
var fmt=function(c){return '$'+(c/100).toFixed(2)};
function card(p){var v=(p.variants||[]).find(function(x){return x.available})||p.variants[0];var img=p.featured_image||'';if(img&&img.indexOf('//')===0)img='https:'+img;
var a=document.createElement('article');a.className='ac-card';a.innerHTML='<a class="ac-card__img" href="'+p.url+'">'+(img?'<img src="'+img+(img.indexOf('?')>-1?'&':'?')+'width=400" alt="" loading="lazy">':'')+'</a><a class="ac-card__t" href="'+p.url+'"></a><p class="ac-card__p">'+fmt(v.price)+'</p><button type="button" class="ac-card__add">+ Add to cart</button>';
a.querySelector('.ac-card__t').textContent=p.title;var b=a.querySelector('.ac-card__add');if(!v.available){b.disabled=true;b.textContent='Sold out'}
b.onclick=function(){b.disabled=true;fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:v.id,quantity:1})}).then(function(r){if(!r.ok)throw 0;b.textContent='✓ Added';b.classList.add('is-added')}).catch(function(){b.disabled=false;b.textContent='Try again'})};return a}
function fill(intent,fb){var row=d.querySelector('[data-ac-row="'+intent+'"]'),t=row.querySelector('[data-ac-track]');
fetch('/recommendations/products.json?product_id='+d.dataset.pid+'&intent='+intent+'&limit=10').then(function(r){return r.json()}).then(function(j){var ps=(j.products||[]);if(!ps.length&&fb)return fetch(fb).then(function(r){return r.json()}).then(function(k){return k.products||[]});return ps}).then(function(ps){ps=ps.filter(function(p){return String(p.id)!==d.dataset.pid});if(!ps.length)return;ps.forEach(function(p){t.appendChild(card(p))});row.hidden=false;
row.querySelector('[data-ac-prev]').onclick=function(){t.scrollBy({left:-t.clientWidth*.8,behavior:'smooth'})};row.querySelector('[data-ac-next]').onclick=function(){t.scrollBy({left:t.clientWidth*.8,behavior:'smooth'})}}).catch(function(){})}
fill('complementary','/collections/cases/products.json?limit=10');fill('related','/collections/audio/products.json?limit=10');return true};
document.querySelectorAll('dialog.sd,dialog.ac').forEach(function(d){d.addEventListener('cancel',function(e){e.preventDefault();shut(d)})})})();
</script>
