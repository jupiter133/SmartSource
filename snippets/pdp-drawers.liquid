{%- comment -%} Product page slide-out panels: unlocked, returns/warranty, promise. {%- endcomment -%}
{%- assign plink = promise_link | default: '/pages/our-promise' -%}
<dialog class="sd" id="sd-unlocked" aria-labelledby="sd-unlocked-t">
  <div class="sd__bar"><p id="sd-unlocked-t">What are unlocked phones?</p><button type="button" data-sd-close aria-label="Close">✕</button></div>
  <div class="sd__body">
    <h2 class="sd__h">Unlocked phones: work with all carriers</h2>
    <p>An unlocked phone isn't tied to one carrier. Use it with Rogers, Bell, Telus, Freedom, Fido, Koodo, Virgin, Public Mobile or any other Canadian carrier, and switch whenever you want.</p>
    <p>Every phone we sell is unlocked. Pop in your SIM or set up an eSIM and you're done. <a href="/collections/all/smartphones">See all our unlocked phones</a></p>
    <a class="sd-card" href="/blogs/journal">
      <span class="sd-card__img" aria-hidden="true">{% render 'icon', name: 'phone' %}</span>
      <span class="sd-card__body"><small>Journal</small><strong>How to activate your phone</strong><span>Moving your SIM, setting up eSIM and transferring your data, step by step.</span><u>See more</u></span>
    </a>
  </div>
</dialog>

<dialog class="sd" id="sd-returns" aria-labelledby="sd-returns-t">
  <div class="sd__bar"><p id="sd-returns-t">Returns and warranty</p><button type="button" data-sd-close aria-label="Close">✕</button></div>
  <div class="sd__body">
    <h2 class="sd__h2">Free 30-day returns</h2>
    <div class="sd-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 14V4H4v10zM7 14l4 7c1.5 0 2.5-1 2.3-2.5L13 15h5.5a2 2 0 002-2.3l-1.1-6.5A2 2 0 0017.4 4H7"/></svg><div><h3>Changed your mind?</h3><p>Return it for any reason within 30 days of delivery. No awkward questions.</p></div></div>
    <div class="sd-item"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><div><h3>Easy to start</h3><p>Contact us from your account or drop it at one of our stores.</p></div></div>
    <div class="sd-item"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M15 9.5c-.6-1-1.7-1.5-3-1.5-1.7 0-3 .9-3 2s1.3 1.7 3 2 3 .9 3 2-1.3 2-3 2c-1.3 0-2.4-.5-3-1.5M12 6v12"/></svg><div><h3>Get your money back</h3><p>Your refund goes back to your original payment method once we receive the return.</p></div></div>
    <hr>
    <h2 class="sd__h2">1-year warranty</h2>
    <div class="sd-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18h12M8 18v-6a4 4 0 018 0v6M12 3v2M4.5 6.5l1.4 1.4M19.5 6.5l-1.4 1.4M3 21h18"/></svg><div><h3>Defects covered for a full year</h3><p>If something stops working from normal use in the first year, we repair or replace it.</p></div></div>
    <div class="sd-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg><div><h3>Send it in or bring it in</h3><p>Visit a store or ship it to us. We'll walk you through it.</p></div></div>
    <div class="sd-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.7 6.3a4 4 0 00-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 005.4-5.4l-2.4 2.4-2.4-.6-.6-2.4z"/></svg><div><h3>Repair or replacement on us</h3><p>Fixed by our own technicians, or replaced if a repair isn't possible. No charge.</p></div></div>
  </div>
</dialog>

<dialog class="sd" id="sd-promise" aria-labelledby="sd-promise-t">
  <div class="sd__bar"><p id="sd-promise-t">The SmartSource Promise</p><button type="button" data-sd-close aria-label="Close">✕</button></div>
  <div class="sd__body">
    <div class="sd__hero" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 2l8 3v6.5c0 5-3.4 8.6-8 10.5-4.6-1.9-8-5.5-8-10.5V5z" fill="#111"/><path d="M8.5 12.3l2.4 2.4 4.6-4.8" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
    <h2 class="sd__h">Guaranteed by the SmartSource Promise</h2>
    <hr>
    <div class="sd-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/></svg><div><h3>Refurbished in-house</h3><p>Every device is inspected, repaired and graded by our own technicians in the GTA.</p></div></div>
    <div class="sd-item"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/></svg><div><h3>Checked from top to bottom</h3><p>Battery, screen, cameras, ports and more are tested before anything is listed.</p></div></div>
    <div class="sd-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 14v-2a8 8 0 0116 0v2M4 14a2 2 0 002 2h1v-5H6a2 2 0 00-2 2zm16 0a2 2 0 01-2 2h-1v-5h1a2 2 0 012 2z"/></svg><div><h3>You check out, we check in</h3><p>1-year warranty, free 30-day returns and real people to help when you need it.</p></div></div>
  </div>
  <div class="sd__foot"><a class="sd__btn" href="{{ plink }}">Learn more</a></div>
</dialog>

<dialog class="sd sd--tradein" id="sd-tradein" aria-labelledby="sd-tradein-t">
  <div class="sd__bar"><p id="sd-tradein-t">Trade-in</p><button type="button" data-sd-close aria-label="Close">✕</button></div>
  <div class="sd__body">
    <h2 class="sd-ti__h">Want to get this for even less? Trade in your old tech for cash.</h2>
    {%- assign est = product.metafields.custom.tradein_estimate.value -%}
    <div class="sd-ti__card">
      <span class="sd-ti__tag">{% if est %}With trade-in estimate{% else %}Added to your cart{% endif %}</span>
      <div class="sd-ti__row">
        {%- if product.featured_image -%}{{ product.featured_image | image_url: width: 200 | image_tag: alt: '', loading: 'lazy' }}{%- endif -%}
        <div><p class="sd-ti__name">{{ product.title }}</p>{%- if est -%}<p class="sd-ti__price">{{ est | money_without_trailing_zeros }}<sup>*</sup></p>{%- else -%}<p class="sd-ti__sub">Trade in a phone, tablet, laptop or console and put the cash toward it.</p>{%- endif -%}</div>
      </div>
    </div>
    {%- if est -%}<p class="sd-ti__note">*Price shown is an estimate after trade-in. Your actual offer depends on the device you send.</p>{%- endif -%}
  </div>
  <div class="sd-ti__foot">
    <a class="sd-ti__btn" href="/pages/sell-your-device"><strong>Yes</strong><span>Get a trade-in offer in just 2 min</span></a>
    <button type="button" class="sd-ti__btn" data-tradein-skip><strong>Skip trade-in</strong><span>View your cart</span></button>
  </div>
</dialog>

<script>
(function(){if(window.__sd)return;window.__sd=1;
function shut(d){d.classList.add('is-closing');setTimeout(function(){d.classList.remove('is-closing');d.close()},260)}
document.addEventListener('click',function(e){var o=e.target.closest('[data-sd-open]');if(o){var d=document.getElementById(o.dataset.sdOpen);if(d&&!d.open){d.showModal()}return}
var c=e.target.closest('[data-sd-close]');if(c){shut(c.closest('dialog'));return}
if(e.target.classList&&e.target.classList.contains('sd')&&e.target.open)shut(e.target)});
document.querySelectorAll('dialog.sd').forEach(function(d){d.addEventListener('cancel',function(e){e.preventDefault();shut(d)})})})();
</script>
