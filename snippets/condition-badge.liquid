{%- comment -%} Reads product tag condition:new|refurbished|used {%- endcomment -%}
{%- for tag in product.tags -%}
  {%- assign t = tag | downcase -%}
  {%- if t contains 'condition:' -%}
    {%- assign cond = t | remove: 'condition:' | strip -%}
    {%- unless cond == 'refurbished' and settings.show_refurb_badge != true -%}<span class="badge badge--{{ cond | handleize }}">{{ cond | capitalize }}</span>{%- endunless -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
