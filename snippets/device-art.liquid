{%- comment -%} Fallback device illustration. kind: phone|laptop|tablet|console|watch|audio|deal|hero. Auto-detects from `title` if kind blank. {%- endcomment -%}
{%- assign k = kind -%}
{%- if k == blank -%}
  {%- assign tt = title | downcase -%}
  {%- if tt contains 'mac' or tt contains 'laptop' or tt contains 'chromebook' or tt contains 'computer' -%}{%- assign k = 'laptop' -%}
  {%- elsif tt contains 'ipad' or tt contains 'tablet' or tt contains 'tab' -%}{%- assign k = 'tablet' -%}
  {%- elsif tt contains 'console' or tt contains 'xbox' or tt contains 'playstation' or tt contains 'ps5' or tt contains 'nintendo' or tt contains 'gaming' or tt contains 'retro' -%}{%- assign k = 'console' -%}
  {%- elsif tt contains 'watch' or tt contains 'fitness' -%}{%- assign k = 'watch' -%}
  {%- elsif tt contains 'airpod' or tt contains 'audio' or tt contains 'headphone' or tt contains 'speaker' or tt contains 'accessor' -%}{%- assign k = 'audio' -%}
  {%- elsif tt contains 'deal' -%}{%- assign k = 'deal' -%}
  {%- else -%}{%- assign k = 'phone' -%}
  {%- endif -%}
{%- endif -%}
{%- assign u = section.id | append: idx | append: k | handleize -%}
<svg class="device-art" viewBox="0 0 120 120" role="img" aria-label="{{ title | escape }}">
  <defs>
    <linearGradient id="a{{ u }}" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ff9ab0"/><stop offset=".5" stop-color="#7a3cff"/><stop offset="1" stop-color="#2bb3ff"/></linearGradient>
    <linearGradient id="b{{ u }}" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#9ff5c8"/><stop offset="1" stop-color="#2bb3ff"/></linearGradient>
  </defs>
  {%- case k -%}
  {%- when 'laptop' -%}<rect x="22" y="30" width="76" height="50" rx="4" fill="#1b1b22"/><rect x="26" y="34" width="68" height="42" fill="url(#a{{ u }})"/><path d="M12 82h96l-6 8H18z" fill="#c9c9d1"/>
  {%- when 'tablet' -%}<rect x="30" y="14" width="60" height="90" rx="7" fill="#1b1b22"/><rect x="34" y="18" width="52" height="82" rx="3" fill="url(#b{{ u }})"/>
  {%- when 'console' -%}<rect x="20" y="50" width="80" height="36" rx="18" fill="#1b1b22"/><circle cx="40" cy="68" r="7" fill="#555"/><circle cx="80" cy="64" r="4" fill="#E5232B"/><circle cx="88" cy="72" r="4" fill="#2bb3ff"/>
  {%- when 'watch' -%}<rect x="50" y="10" width="20" height="100" rx="7" fill="#2a2a33"/><rect x="38" y="36" width="44" height="50" rx="11" fill="#1b1b22"/><rect x="43" y="41" width="34" height="40" rx="7" fill="url(#a{{ u }})"/>
  {%- when 'audio' -%}<rect x="32" y="44" width="56" height="44" rx="18" fill="#fff" stroke="#bbb"/><path d="M32 62h56" stroke="#bbb"/>
  {%- when 'deal' -%}<rect x="14" y="34" width="56" height="38" rx="3" fill="#1b1b22"/><rect x="17" y="37" width="50" height="32" fill="url(#a{{ u }})"/><path d="M8 74h68l-4 6H12z" fill="#c9c9d1"/><rect x="74" y="26" width="30" height="62" rx="6" fill="#1b1b22"/><rect x="77" y="29" width="24" height="56" rx="4" fill="url(#b{{ u }})"/>
  {%- when 'hero' -%}<rect x="4" y="30" width="64" height="44" rx="3" fill="#1b1b22"/><rect x="8" y="34" width="56" height="36" fill="url(#a{{ u }})"/><path d="M-2 76h76l-5 6H3z" fill="#d9d9e0"/><rect x="60" y="40" width="36" height="52" rx="5" fill="#1b1b22"/><rect x="63" y="43" width="30" height="46" rx="2" fill="url(#b{{ u }})"/><rect x="94" y="22" width="22" height="46" rx="5" fill="#1b1b22"/><rect x="96" y="25" width="18" height="40" rx="3" fill="url(#a{{ u }})"/>
  {%- else -%}<rect x="40" y="12" width="40" height="96" rx="8" fill="#1b1b22"/><rect x="43" y="16" width="34" height="88" rx="6" fill="url(#a{{ u }})"/>
  {%- endcase -%}
</svg>
