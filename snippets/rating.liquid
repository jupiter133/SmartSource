{%- if settings.show_rating and product.metafields.reviews.rating.value != blank -%}
  {%- assign r = product.metafields.reviews.rating.value.rating | times: 1.0 -%}
  {%- assign full = r | floor -%}
  <div class="rating" aria-label="{{ r }} out of 5">
    <span class="stars" style="--r: {{ r | divided_by: 5.0 | times: 100 }}%">★★★★★</span>
    <span>{{ r | round: 1 }}/5{% if product.metafields.reviews.rating_count != blank %} ({{ product.metafields.reviews.rating_count }}){% endif %}</span>
  </div>
{%- endif -%}
