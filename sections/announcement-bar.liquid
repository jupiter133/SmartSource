{%- if section.settings.text != blank -%}
<div class="announcement" data-announcement>
  <p>{{ section.settings.text }} {% if section.settings.link_text != blank %}<a href="{{ section.settings.link }}">{{ section.settings.link_text }}</a>{% endif %}</p>
  <button class="announcement__close" aria-label="Close" data-close>&times;</button>
</div>
{%- endif -%}
{% schema %}
{ "name": "Announcement bar", "settings": [
  { "type": "text", "id": "text", "label": "Text", "default": "Trade-in prices are peaking." },
  { "type": "text", "id": "link_text", "label": "Link text", "default": "Cash in yours now" },
  { "type": "url", "id": "link", "label": "Link" }
]}
{% endschema %}
