{%- assign msgs = section.blocks -%}
{%- if msgs.size > 0 or section.settings.text != blank -%}
{%- assign n = msgs.size -%}
{%- assign step = section.settings.speed -%}
{%- assign total = step | times: n -%}
{%- assign slot = 100.0 | divided_by: n -%}
<div class="announcement{% if n > 1 %} announcement--rotate{% endif %}" id="Announcement-{{ section.id }}" data-announcement>
  {%- if n > 1 -%}
  <style>
    @keyframes ann-{{ section.id }}{
      0%{opacity:0;transform:translateY(70%)}
      {{ slot | times: 0.06 }}%{opacity:1;transform:none}
      {{ slot | times: 0.94 }}%{opacity:1;transform:none}
      {{ slot }}%{opacity:0;transform:translateY(-70%)}
      100%{opacity:0;transform:translateY(-70%)}
    }
    #Announcement-{{ section.id }} .announcement__msg{animation:ann-{{ section.id }} {{ total }}s linear infinite}
  </style>
  {%- endif -%}
  <div class="announcement__track" role="region" aria-label="Announcements">
    {%- if n == 0 -%}
      <p class="announcement__msg is-static">{{ section.settings.text }} {% if section.settings.link_text != blank %}<a href="{{ section.settings.link }}">{{ section.settings.link_text }}</a>{% endif %}</p>
    {%- else -%}
      {%- for block in msgs -%}
        <p class="announcement__msg{% if n == 1 %} is-static{% endif %}"{% if n > 1 %} style="animation-delay:{{ step | times: forloop.index0 }}s"{% endif %} {{ block.shopify_attributes }}>
          {%- if block.settings.emoji != blank -%}<span class="announcement__emoji" aria-hidden="true">{{ block.settings.emoji }}</span>{%- endif -%}
          <span>{{ block.settings.text }}</span>
          {%- if block.settings.link_text != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.link_text }} <span aria-hidden="true">→</span></a>{%- endif -%}
        </p>
      {%- endfor -%}
    {%- endif -%}
  </div>
  <button class="announcement__close" aria-label="Close announcement" data-close>&times;</button>
</div>
{%- endif -%}
{% schema %}
{ "name": "Announcement bar", "settings": [
  { "type": "range", "id": "speed", "label": "Seconds per message", "min": 4, "max": 20, "step": 1, "unit": "s", "default": 10 },
  { "type": "paragraph", "content": "Add messages as blocks. With 2 or more, they rotate. Hovering pauses the rotation." },
  { "type": "text", "id": "text", "label": "Fallback text (used only with no messages)", "default": "Trade-in prices are peaking." },
  { "type": "text", "id": "link_text", "label": "Fallback link text", "default": "Cash in yours now" },
  { "type": "url", "id": "link", "label": "Fallback link" }
],
"blocks": [{ "type": "message", "name": "Message", "settings": [
  { "type": "text", "id": "emoji", "label": "Emoji or icon", "default": "🔥", "info": "Paste any emoji, e.g. 🔥 🛡️ 🚚 📱 💸 ⚡" },
  { "type": "text", "id": "text", "label": "Text", "default": "Trade-in prices are peaking." },
  { "type": "text", "id": "link_text", "label": "Link text", "default": "Get my quote" },
  { "type": "url", "id": "link", "label": "Link" }
]}],
"presets": [{ "name": "Announcement bar" }] }
{% endschema %}
