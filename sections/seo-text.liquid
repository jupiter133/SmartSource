<section class="seo-text">
  <div class="page-width seo-text__inner">
    {%- for block in section.blocks -%}
      <div class="seo-text__part" {{ block.shopify_attributes }}>
        {%- if block.settings.heading != blank -%}<h2>{{ block.settings.heading }}</h2>{%- endif -%}
        <div class="rte">{{ block.settings.body }}</div>
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{ "name": "Long text (SEO)", "blocks": [{ "type": "part", "name": "Text block", "settings": [
  { "type": "text", "id": "heading", "label": "Heading" },
  { "type": "richtext", "id": "body", "label": "Text" }
]}], "presets": [{ "name": "Long text (SEO)", "blocks": [{"type":"part","settings":{"heading":"Why buy refurbished or pre-owned?","body":"<p>Write a few paragraphs here.</p>"}}] }] }
{% endschema %}
