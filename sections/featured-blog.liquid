{%- assign b = section.settings.blog -%}
<section class="section page-width" data-carousel>
  <div class="section__head">
    <h2>{{ section.settings.heading }}</h2>
    {%- if b -%}<a class="btn btn--dark btn--sm" href="{{ b.url }}">All articles →</a>{%- endif -%}
  </div>
  <div class="carousel blog-row" data-track>
    {%- for a in b.articles limit: section.settings.limit -%}
      <a class="post" href="{{ a.url }}">
        <div class="post__img">{%- if a.image -%}{{ a.image | image_url: width: 600 | image_tag: loading: 'lazy' }}{%- else -%}{{ 'image' | placeholder_svg_tag }}{%- endif -%}</div>
        <div class="post__body">
          {%- if a.tags.first -%}<span class="post__tag">{{ a.tags.first }}</span>{%- endif -%}
          <h3>{{ a.title }}</h3>
          <p class="muted">{{ a.excerpt_or_content | strip_html | truncate: 90 }}</p>
          <span class="post__meta">{{ a.published_at | date: '%b %d, %Y' }} · {{ a.content | strip_html | split: ' ' | size | divided_by: 200 | plus: 1 }} min read</span>
        </div>
      </a>
    {%- else -%}
      {%- for i in (1..3) -%}<div class="post"><div class="post__img">{{ 'image' | placeholder_svg_tag }}</div><div class="post__body"><h3>Pick a blog in the editor</h3></div></div>{%- endfor -%}
    {%- endfor -%}
  </div>
</section>
{% schema %}
{ "name": "Blog posts", "settings": [
  { "type": "text", "id": "heading", "label": "Heading", "default": "Tech Journal" },
  { "type": "blog", "id": "blog", "label": "Blog" },
  { "type": "range", "id": "limit", "label": "Posts", "min": 2, "max": 8, "step": 1, "default": 3 }
], "presets": [{ "name": "Blog posts" }] }
{% endschema %}
