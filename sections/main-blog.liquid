<section class="page-width section"><h1>{{ blog.title }}</h1>
  {%- paginate blog.articles by 12 -%}
  <div class="grid">{%- for a in blog.articles -%}<a class="card" href="{{ a.url }}">{%- if a.image -%}{{ a.image | image_url: width: 500 | image_tag: loading: 'lazy' }}{%- endif -%}<p class="card__title">{{ a.title }}</p><p class="muted">{{ a.published_at | date: '%b %d, %Y' }}</p></a>{%- endfor -%}</div>
  {%- if paginate.pages > 1 -%}<div class="pagination">{{ paginate | default_pagination }}</div>{%- endif -%}
  {%- endpaginate -%}
</section>
{% schema %}{ "name": "Blog" }{% endschema %}
