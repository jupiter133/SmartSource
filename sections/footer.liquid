<footer class="footer">
  <div class="page-width">
    <div class="footer__news">
      <div>
        <h2>{{ section.settings.news_heading }}</h2>
        <p class="footer__muted">{{ section.settings.news_text }}</p>
      </div>
      {%- form 'customer' -%}
        <div class="footer__form">
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="Email" required aria-label="Email">
        <button class="btn btn--accent">Sign up</button>
        {%- if form.posted_successfully? -%}<p class="footer__ok">You're in. Watch your inbox.</p>{%- endif -%}
        </div>
      {%- endform -%}
    </div>

    <div class="footer__main">
    <div class="footer__brand">
      <a href="{{ routes.root_url }}" class="footer__logo">
        {%- if section.settings.logo != blank -%}{{ section.settings.logo | image_url: width: 400 | image_tag: alt: shop.name, loading: 'lazy' }}{%- else -%}<img src="{{ 'logo-smartsource-white.png' | asset_url }}" alt="{{ shop.name | escape }}" width="180" height="44" loading="lazy">{%- endif -%}
      </a>
      {%- if section.settings.tagline != blank -%}<p class="footer__tagline">{{ section.settings.tagline }}</p>{%- endif -%}
      {%- capture social_links -%}
        {%- assign socials = 'instagram,tiktok,facebook,youtube,x,linkedin' | split: ',' -%}
        {%- for s in socials -%}
          {%- assign key = 'social_' | append: s -%}
          {%- if section.settings[key] != blank -%}<a href="{{ section.settings[key] }}" aria-label="{{ shop.name }} on {{ s | capitalize }}" target="_blank" rel="noopener">{% render 'icon', name: s %}</a>{%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if social_links != blank -%}
        <p class="footer__label">Follow us</p>
        <div class="footer__social">{{ social_links }}</div>
      {%- elsif request.design_mode -%}
        <p class="footer__hint">Add your social links in Footer settings to show icons here.</p>
      {%- endif -%}
      {%- if section.settings.store_text != blank -%}
        <a class="footer__store" href="{{ section.settings.store_link | default: '/pages/contact' }}">{% render 'icon', name: 'pin' %}<span>{{ section.settings.store_text }}</span></a>
      {%- endif -%}
    </div>
    <div class="footer__cols">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
        {%- when 'menu' -%}
          <div class="footer__col" {{ block.shopify_attributes }}>
            <p class="footer__heading">{{ block.settings.title | default: block.settings.menu.title }}</p>
            <ul>
              {%- if block.settings.links != blank -%}
                {%- assign lines = block.settings.links | newline_to_br | split: '<br />' -%}
                {%- for line in lines -%}
                  {%- assign parts = line | strip | split: '|' -%}
                  {%- assign label = parts.first | strip -%}
                  {%- if label == blank -%}{%- continue -%}{%- endif -%}
                  {%- assign url = parts.last | strip | replace: '/pages/phone-plans', '/pages/plans' -%}
                  {%- assign show = true -%}
                  {%- if url contains '/pages/' -%}{%- assign h = url | split: '/pages/' | last -%}{%- if pages[h].id == blank -%}{%- assign show = false -%}{%- endif -%}{%- endif -%}
                  {%- if show -%}<li><a href="{{ url }}">{{ label }}</a></li>{%- endif -%}
                {%- endfor -%}
              {%- else -%}
                {%- for link in block.settings.menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
              {%- endif -%}
            </ul>
            {%- if block.settings.show_payments -%}
              <p class="footer__label">Payments 100% secured</p>
              <div class="footer__pay">{%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag: class: 'pay-icon' }}{%- endfor -%}</div>
            {%- endif -%}
          </div>
        {%- when 'badges' -%}
          <div class="footer__badges" {{ block.shopify_attributes }}>
            {%- for i in (1..3) -%}
              {%- assign key = 'badge_' | append: i -%}
              {%- if block.settings[key] != blank -%}{{ block.settings[key] | image_url: width: 160 | image_tag: loading: 'lazy' }}{%- endif -%}
            {%- endfor -%}
          </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
    </div>

    <div class="footer__bottom">
      <div class="footer__legal">
        <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
        {%- for policy in shop.policies -%}<a href="{{ policy.url }}">{{ policy.title }}</a>{%- endfor -%}
      </div>
      {%- if section.settings.show_payments and shop.enabled_payment_types.size > 0 -%}
        <div class="footer__pay" aria-label="Accepted payments">{%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag: class: 'pay-icon' }}{%- endfor -%}</div>
      {%- endif -%}
      <div class="footer__apps">
        {%- if section.settings.google_play != blank -%}<a class="app-btn" href="{{ section.settings.google_play }}">{% render 'icon', name: 'play-store' %}<span><small>GET IT ON</small>Google Play</span></a>{%- endif -%}
        {%- if section.settings.app_store != blank -%}<a class="app-btn" href="{{ section.settings.app_store }}">{% render 'icon', name: 'apple' %}<span><small>Download on the</small>App Store</span></a>{%- endif -%}
      </div>
    </div>
    {%- if section.settings.wordmark -%}<div class="footer__wordmark" aria-hidden="true"><svg viewBox="0 0 1000 190" preserveAspectRatio="xMidYMax meet" focusable="false"><defs><linearGradient id="wm-{{ section.id }}" x1="0" x2="1"><stop offset="0" stop-color="var(--c-accent)"/><stop offset="1" stop-color="var(--c-accent-2)"/></linearGradient></defs><text x="500" y="160" text-anchor="middle" textLength="990" lengthAdjust="spacingAndGlyphs" fill="url(#wm-{{ section.id }})">{{ shop.name | escape }}</text></svg></div>{%- endif -%}
  </div>
</footer>
{% schema %}
{ "name": "Footer", "settings": [
  { "type": "text", "id": "news_heading", "label": "Newsletter heading", "default": "Stay in the loop with hot drops" },
  { "type": "text", "id": "news_text", "label": "Newsletter text", "default": "Be first to know about new arrivals, price drops, and tech news that matters." },
  { "type": "checkbox", "id": "wordmark", "label": "Show giant brand wordmark", "default": true },
  { "type": "header", "content": "Brand column" },
  { "type": "image_picker", "id": "logo", "label": "Footer logo", "info": "Use a light version for the dark footer. Defaults to the white SmartSource logo." },
  { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "Refurbished & certified pre-owned tech, tested by real technicians in Canada. 1-year warranty and free 30-day returns on every device." },
  { "type": "text", "id": "store_text", "label": "Store link text", "default": "Visit our stores in the GTA" },
  { "type": "url", "id": "store_link", "label": "Store link" },
  { "type": "checkbox", "id": "show_payments", "label": "Show payment icons in the bottom bar", "default": true },
  { "type": "header", "content": "Social" },
  { "type": "url", "id": "social_instagram", "label": "Instagram" },
  { "type": "url", "id": "social_tiktok", "label": "TikTok" },
  { "type": "url", "id": "social_youtube", "label": "YouTube" },
  { "type": "url", "id": "social_linkedin", "label": "LinkedIn" },
  { "type": "url", "id": "social_facebook", "label": "Facebook" },
  { "type": "url", "id": "social_x", "label": "X" },
  { "type": "header", "content": "Apps" },
  { "type": "url", "id": "google_play", "label": "Google Play link" },
  { "type": "url", "id": "app_store", "label": "App Store link" }
], "blocks": [
  { "type": "menu", "name": "Menu column", "settings": [
    { "type": "text", "id": "title", "label": "Heading" },
    { "type": "textarea", "id": "links", "label": "Links", "info": "One per line: Label | link. Links to pages that don't exist yet are hidden automatically. Leave blank to use the menu below instead." },
    { "type": "link_list", "id": "menu", "label": "Menu (used only if Links is blank)", "default": "footer" },
    { "type": "checkbox", "id": "show_payments", "label": "Show payment icons under this column", "default": false }
  ]},
  { "type": "badges", "name": "Trust badges", "limit": 1, "settings": [
    { "type": "image_picker", "id": "badge_1", "label": "Badge 1 (e.g. BBB)" },
    { "type": "image_picker", "id": "badge_2", "label": "Badge 2" },
    { "type": "image_picker", "id": "badge_3", "label": "Badge 3" }
  ]}
], "max_blocks": 6 }
{% endschema %}

