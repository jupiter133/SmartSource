<section class="section page-width sell-cta">
  <div class="sell-cta__card">
    <div>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{% render 'sell-text', text: section.settings.text %}</p>{%- endif -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <a class="btn btn--light btn--lg" href="{{ section.settings.button_link | default: '#sell-quote' }}"{% if section.settings.button_link == blank %} data-sell-start{% endif %}>{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Sell: final CTA",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready to get paid?" },
    { "type": "text", "id": "text", "label": "Text", "default": "Instant quote, free shipping label, paid within {payment_business_days} business days." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Get my instant offer" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Leave blank to jump to the quote wizard on this page." }
  ],
  "presets": [{ "name": "Sell: final CTA" }]
}
{% endschema %}
