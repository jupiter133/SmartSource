{%- comment -%} Simple "how it works": a centered title and a few white cards, each with a photo, a bold title and a short text. {%- endcomment -%}
<section class="section page-width sx sx-steps">
  <div class="sx-head">
    {%- if section.settings.heading != blank -%}<h2 class="sx-title">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.subtext != blank -%}<p class="sx-sub">{% render 'sell-text', text: section.settings.subtext %}</p>{%- endif -%}
  </div>
  <ol class="sx-steps__list" role="list">
    {%- for block in section.blocks -%}
      <li class="sx-card sx-step" {{ block.shopify_attributes }}>
        <div class="sx-step__img">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 990px) 380px, (min-width: 750px) 45vw, 92vw', alt: block.settings.image_alt | default: '' }}
          {%- elsif block.settings.asset_image != blank -%}
            <img src="{{ block.settings.asset_image | asset_url }}" alt="{{ block.settings.image_alt | escape }}" width="900" height="900" loading="lazy">
          {%- endif -%}
        </div>
        <div class="sx-step__body">
          <h3>{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p>{% render 'sell-text', text: block.settings.text %}</p>{%- endif -%}
        </div>
      </li>
    {%- endfor -%}
  </ol>
</section>

{% schema %}
{
  "name": "Sell: easy steps",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Just 3 easy steps" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "From quote to payment, here's how it works." },
    { "type": "paragraph", "content": "Text can use {quote_valid_days} and {payment_business_days} from Theme settings > Sell program." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "asset_image", "label": "Or theme asset photo", "info": "Filename in the theme assets folder, e.g. svc-trade-in.webp" },
        { "type": "text", "id": "image_alt", "label": "Photo description" },
        { "type": "text", "id": "title", "label": "Title", "default": "Get an offer" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [ { "name": "Sell: easy steps", "blocks": [ { "type": "step" }, { "type": "step" }, { "type": "step" } ] } ]
}
{% endschema %}
