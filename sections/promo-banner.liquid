<section class="section page-width">
  <a class="promo-banner" href="{{ section.settings.link }}" style="--pb-bg: {{ section.settings.bg }}">
    {%- if section.settings.image != blank -%}{{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'promo-banner__img' }}{%- else -%}<svg class="promo-banner__chart" viewBox="0 0 300 150" aria-hidden="true"><polyline points="0,140 80,60 120,100 190,30 230,70 290,5" fill="none" stroke="#39e639" stroke-width="10" stroke-linejoin="round" stroke-linecap="round"/></svg>{%- endif -%}
    <div class="promo-banner__text">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      {%- if section.settings.button_label != blank -%}<span class="btn btn--light">{{ section.settings.button_label }}</span>{%- endif -%}
    </div>
  </a>
</section>
{% schema %}
{ "name": "Promo banner", "settings": [
  { "type": "text", "id": "heading", "label": "Heading", "default": "Sell high." },
  { "type": "textarea", "id": "text", "label": "Text", "default": "Console trade-in prices are peaking. Yours could be worth up to $400." },
  { "type": "text", "id": "button_label", "label": "Button", "default": "Cash it in" },
  { "type": "url", "id": "link", "label": "Link" },
  { "type": "image_picker", "id": "image", "label": "Background image" },
  { "type": "color_background", "id": "bg", "label": "Background (if no image)", "default": "linear-gradient(110deg, #111 45%, #1f8a1f 100%)" }
], "presets": [{ "name": "Promo banner" }] }
{% endschema %}
