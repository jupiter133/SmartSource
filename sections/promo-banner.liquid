<section class="section page-width">
  <a class="promo-banner" href="{{ section.settings.link }}" style="--pb-bg: {{ section.settings.bg }}">
    {%- if section.settings.image != blank -%}{{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'promo-banner__img' }}{%- else -%}<span class="pb-art" aria-hidden="true">
      <svg class="pb-art__chart" viewBox="0 0 1000 420" preserveAspectRatio="xMaxYMid slice">
        <defs>
          <linearGradient id="pbLine" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#2bd94a" stop-opacity=".15"/><stop offset=".45" stop-color="#2bd94a" stop-opacity=".85"/><stop offset="1" stop-color="#2dff4f"/></linearGradient>
          <filter id="pbGlow" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="6" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
        </defs>
        <g stroke="#ffffff" stroke-opacity=".06" stroke-width="1">{%- for y in (1..7) -%}<line x1="0" x2="1000" y1="{{ y | times: 55 }}" y2="{{ y | times: 55 }}"/>{%- endfor -%}</g>
        <polyline points="150,440 380,190 480,300 640,130 700,220 760,170 900,40" fill="none" stroke="url(#pbLine)" stroke-width="22" stroke-linejoin="round" stroke-linecap="round" filter="url(#pbGlow)"/>
        <polygon points="935,8 945,92 858,48" fill="#2dff4f" filter="url(#pbGlow)"/>
        <text x="352" y="222" font-size="58" text-anchor="middle">🤑</text>
        <text x="640" y="152" font-size="42" text-anchor="middle">🤑</text>
        <text x="835" y="118" font-size="54" text-anchor="middle">🤑</text>
      </svg>
      <img class="pb-art__dev pb-art__dev--a" src="https://cdn.shopify.com/s/files/1/0760/0377/0529/files/ps5-product-thumbnail-01-en-14sep21.png?v=1791412844&width=500" alt="" loading="lazy">
      <img class="pb-art__dev pb-art__dev--b" src="{{ 'cat-iphone.webp' | asset_url }}" alt="" loading="lazy">
    </span>{%- endif -%}
    <div class="promo-banner__text">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      {%- if section.settings.button_label != blank -%}<span class="btn btn--light">{{ section.settings.button_label }}</span>{%- endif -%}
    </div>
  </a>
</section>
{% schema %}
{ "name": "Promo banner", "settings": [
  { "type": "text", "id": "heading", "label": "Heading", "default": "We buy your tech." },
  { "type": "textarea", "id": "text", "label": "Text", "default": "Phones, tablets, laptops and consoles. Get top dollar in Canada, paid fast." },
  { "type": "text", "id": "button_label", "label": "Button", "default": "Get my quote" },
  { "type": "url", "id": "link", "label": "Link" },
  { "type": "image_picker", "id": "image", "label": "Background image" },
  { "type": "color_background", "id": "bg", "label": "Background (if no image)", "default": "linear-gradient(110deg, #111 45%, #1f8a1f 100%)" }
], "presets": [{ "name": "Promo banner" }] }
{% endschema %}
