{%- comment -%} "By the numbers": a few cards, each a big number on a light tile with a short line. Use only facts you can stand behind. {%- endcomment -%}
<section class="section page-width sx sx-numbers">
  <div class="sx-head">
    {%- if section.settings.heading != blank -%}<h2 class="sx-title">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.subtext != blank -%}<p class="sx-sub">{% render 'sell-text', text: section.settings.subtext %}</p>{%- endif -%}
  </div>
  <ul class="sx-numbers__list" role="list">
    {%- for block in section.blocks -%}
      <li class="sx-card sx-number" {{ block.shopify_attributes }}>
        <div class="sx-number__tile" aria-hidden="true">
          <span class="sx-number__fig">{% render 'sell-text', text: block.settings.figure %}</span>
          {%- if block.settings.unit != blank -%}<span class="sx-number__unit">{{ block.settings.unit }}</span>{%- endif -%}
        </div>
        <p class="sx-number__text"><span class="visually-hidden">{% render 'sell-text', text: block.settings.figure %} {{ block.settings.unit }} </span>{% render 'sell-text', text: block.settings.text %}</p>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Sell: by the numbers",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "By the numbers" },
    { "type": "text", "id": "subtext", "label": "Subtext" }
  ],
  "blocks": [
    {
      "type": "figure",
      "name": "Number",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "figure", "label": "Number", "default": "21", "info": "Can use {quote_valid_days} or {payment_business_days}." },
        { "type": "text", "id": "unit", "label": "Unit", "default": "days" },
        { "type": "text", "id": "text", "label": "Line", "default": "to send your device after your quote" }
      ]
    }
  ],
  "presets": [ { "name": "Sell: by the numbers", "blocks": [ { "type": "figure" } ] } ]
}
{% endschema %}
