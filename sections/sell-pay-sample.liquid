{%- comment -%}
  "What we pay" sample for the main sell page: a few small tables (Phones, iPad, Apple Watch) with each model's top offer.
  Each table lists the device handles you choose (or, if blank, the top models of a brand and category), most valuable first.
  "Up to" = the top price across storages: brand new sealed where set, else Like New (same as the full price list).
  Rows open the quote wizard on this page with that model picked.
{%- endcomment -%}
{%- liquid
  assign quote_url = section.settings.quote_page | default: request.path
  assign groups = section.blocks | where: 'type', 'group'
  if settings.prices_updated_date != blank
    assign updated = settings.prices_updated_date
  else
    assign updated = 'now' | date: '%B %-d, %Y'
  endif
-%}
{%- capture tables -%}
  {%- if metaobjects.buyback_device.values.size > 0 -%}
  {%- paginate metaobjects.buyback_device.values by 250 -%}
    {%- for block in groups -%}
      {%- liquid
        assign want_brand = block.settings.brand | downcase | strip
        assign want_cat = block.settings.category | downcase | strip
        assign picks = ','
        assign lines = block.settings.handles | newline_to_br | replace: '<br />', ',' | split: ','
        for x in lines
          assign hx = x | strip | downcase
          if hx != blank
            assign picks = picks | append: hx | append: ','
          endif
        endfor
        assign row_limit = block.settings.limit | default: 5
        assign recs = ''
        for d in metaobjects.buyback_device.values
          if d.active.value == false
            continue
          endif
          if picks != ','
            assign key = ',' | append: d.system.handle | append: ','
            unless picks contains key
              continue
            endunless
          else
            assign b = d.brand.value.name.value | downcase | strip
            assign c = d.category.value.name.value | downcase | strip
            if c != want_cat
              continue
            endif
            if want_brand != blank and b != want_brand
              continue
            endif
          endif
          assign top = 0
          for pr in d.prices.value
            assign v = pr.price_like_new.value | default: 0 | times: 1.0
            if v > top
              assign top = v
            endif
            assign s = pr.price_new.value | default: 0 | times: 1.0
            if s > top
              assign top = s
            endif
          endfor
          if top <= 0
            continue
          endif
          assign pkey = 99999 | minus: top | round | prepend: '00000' | slice: -5, 5
          assign safe_name = d.name.value | replace: '~', '-' | replace: '¦', '-'
          assign rec = pkey | append: '~' | append: d.system.handle | append: '~' | append: safe_name | append: '~' | append: top
          assign recs = recs | append: '¦' | append: rec
        endfor
      -%}
      {%- if recs != blank -%}
        {%- assign sorted = recs | remove_first: '¦' | split: '¦' | sort -%}
        <div class="pay-group" {{ block.shopify_attributes }}>
          <h3 class="pay-group__title">{{ block.settings.title }}</h3>
          <div class="pay-group__cols" aria-hidden="true"><span>Model</span><span>Up to</span></div>
          <ul class="pay-list pay-list--one" role="list">
            {%- for r in sorted limit: row_limit -%}
              {%- assign f = r | split: '~' -%}
              <li>
                <a class="pay-row" href="{{ quote_url }}?sell_device={{ f[1] | url_encode }}#sell-quote" data-sell-start data-device="{{ f[1] | escape }}">
                  <span class="pay-row__model"><span class="pay-row__name">{{ f[2] }}</span></span>
                  <span class="pay-row__price"><span class="visually-hidden">Up to </span>{{ f[3] | times: 100 | round | money_without_trailing_zeros }}</span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    {%- endfor -%}
  {%- endpaginate -%}
  {%- endif -%}
{%- endcapture -%}

{%- if tables != blank or request.design_mode -%}
<section class="section page-width sell-pay sell-pay--sample" id="what-we-pay">
  <div class="sell-pay__head">
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.subtext != blank -%}<p class="muted">{% render 'sell-text', text: section.settings.subtext %}</p>{%- endif -%}
  </div>
  {%- if tables != blank -%}
    <div class="sell-pay__grid">{{ tables }}</div>
  {%- else -%}
    <p class="sell-pay__empty">No prices to show yet. Check each table's device handles, or its brand and category names, in the theme editor. (Only you see this message.)</p>
  {%- endif -%}
  <div class="sell-pay__foot">
    <p class="sell-pay__note">Prices updated {{ updated }}. {% render 'sell-text', text: section.settings.footnote %}</p>
    <div class="sell-pay__actions">
      {%- if section.settings.cta_label != blank -%}
        <a class="btn btn--accent btn--lg" href="{% if section.settings.quote_page != blank %}{{ section.settings.quote_page }}{% endif %}#sell-quote"{% if section.settings.quote_page == blank %} data-sell-start{% endif %}>{{ section.settings.cta_label }}</a>
      {%- endif -%}
      {%- if section.settings.all_label != blank -%}
        <a class="pay-viewall" href="{{ section.settings.all_page | default: '/pages/what-we-pay' }}">{{ section.settings.all_label }} <span aria-hidden="true">→</span></a>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Sell: what we pay (sample)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What SmartSource pays" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "A few of our current top offers. Pick yours for an exact quote." },
    { "type": "textarea", "id": "footnote", "label": "Footnote", "default": "\"Up to\" is the top storage, brand new sealed where we buy sealed, otherwise Like New. Final offer follows inspection.", "info": "Starts with \"Prices updated\" and the date from Theme settings > Sell program (today's date if that's empty)." },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Get my instant offer" },
    { "type": "url", "id": "quote_page", "label": "Page with the quote wizard", "info": "Leave blank when the wizard is on this page." },
    { "type": "text", "id": "all_label", "label": "Full price list link", "default": "See all prices" },
    { "type": "url", "id": "all_page", "label": "Full price list page", "info": "Defaults to /pages/what-we-pay" }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Table",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Phones" },
        { "type": "textarea", "id": "handles", "label": "Devices", "info": "Buyback device handles, one per line (e.g. iphone-17-pro-max). Leave blank to show the top models of the brand and category below." },
        { "type": "text", "id": "brand", "label": "Brand name", "info": "Only used when Devices is blank. Blank = every brand." },
        { "type": "text", "id": "category", "label": "Category name", "default": "Smartphone", "info": "Only used when Devices is blank." },
        { "type": "number", "id": "limit", "label": "Rows", "default": 5 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sell: what we pay (sample)",
      "blocks": [
        { "type": "group", "settings": { "title": "Phones", "category": "Smartphone", "limit": 7 } },
        { "type": "group", "settings": { "title": "iPad", "brand": "Apple", "category": "Tablet", "limit": 4 } },
        { "type": "group", "settings": { "title": "Apple Watch", "brand": "Apple", "category": "Smartwatch", "limit": 4 } }
      ]
    }
  ]
}
{% endschema %}
