<section class="section top-tech" data-carousel>
  <div class="top-tech__head page-width">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow-grad">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
  </div>
  <div class="carousel top-tech__track" data-track>
    {%- for block in section.blocks -%}
      {%- assign c = block.settings.collection -%}
      <a class="tech-card" href="{% if block.settings.link != blank %}{{ block.settings.link }}{% elsif c %}{{ c.url }}{% else %}#{% endif %}" style="--card-bg: {{ block.settings.bg }}" {{ block.shopify_attributes }}>
        <span class="tech-card__pill">{{ block.settings.label }}</span>
        <h3>{{ block.settings.title }}</h3>
        <span class="tech-card__img">
          {%- assign img = block.settings.image | default: c.featured_image -%}
          {%- if img != blank -%}{{ img | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '360px', alt: block.settings.label }}{%- elsif block.settings.asset_image != blank -%}<img src="{{ block.settings.asset_image | asset_url }}" alt="{{ block.settings.label | escape }}" width="800" height="800" loading="lazy">{%- else -%}{% render 'device-art', title: block.settings.label, idx: forloop.index %}{%- endif -%}
        </span>
      </a>
    {%- endfor -%}
  </div>
  <div class="page-width section__foot">{% render 'carousel-arrows' %}</div>
</section>
{% schema %}
{ "name": "Top tech cards", "settings": [
  { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "TRUSTED BY MANY, LOVED BY ALL" },
  { "type": "text", "id": "heading", "label": "Heading", "default": "Explore our Top Tech" }
], "blocks": [{ "type": "card", "name": "Card", "settings": [
  { "type": "text", "id": "asset_image", "label": "Theme asset image (advanced)", "info": "Filename in the theme's assets folder. Used only if no image or collection image is set." },
  { "type": "text", "id": "label", "label": "Pill label", "default": "IPHONES" },
  { "type": "text", "id": "title", "label": "Title", "default": "Seamless. Secure. Simply iPhone." },
  { "type": "image_picker", "id": "image", "label": "Image (transparent PNG)" },
  { "type": "collection", "id": "collection", "label": "Collection" },
  { "type": "url", "id": "link", "label": "Link override" },
  { "type": "color", "id": "bg", "label": "Card background", "default": "#F4F4F5" }
]}], "presets": [{ "name": "Top tech cards" }] }
{% endschema %}
