<section class="section page-width" data-carousel>
  <div class="section__head">
    <div><h2>{{ section.settings.heading }}</h2><p class="muted">{{ section.settings.subheading }}</p></div>
    {% render 'carousel-arrows' %}
  </div>
  <div class="carousel" data-track>
    {%- for block in section.blocks -%}
      <div class="reel" {{ block.shopify_attributes }} data-reel>
        {%- if block.settings.video != blank -%}
          {{ block.settings.video | video_tag: muted: true, loop: true, playsinline: true, preload: 'metadata', image_size: '600x' }}
        {%- elsif block.settings.poster != blank -%}
          {{ block.settings.poster | image_url: width: 600 | image_tag: loading: 'lazy' }}
        {%- else -%}<div class="reel__fill" style="--g: {% cycle '#d9c3b0,#7d6250', '#e8e8e8,#9a9aa5', '#9cbf8a,#c58b5a', '#c9b8f0,#f1d9e8', '#dcdcdc,#a7a2a8' %}"></div>{%- endif -%}
        {%- if block.settings.caption != blank -%}<span class="reel__caption">{{ block.settings.caption }}</span>{%- endif -%}
        <button class="reel__play" aria-label="Play">{% render 'icon', name: 'play' %}</button>
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{ "name": "Video reels (UGC)", "settings": [
  { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Circular Economy" },
  { "type": "text", "id": "subheading", "label": "Subheading", "default": "See how people are giving a new life to pre-owned tech." }
], "blocks": [{ "type": "reel", "name": "Reel", "settings": [
  { "type": "video", "id": "video", "label": "Video (Shopify-hosted)" },
  { "type": "image_picker", "id": "poster", "label": "Poster image (if no video)" },
  { "type": "text", "id": "caption", "label": "Caption" }
]}], "presets": [{ "name": "Video reels (UGC)", "blocks": [{"type":"reel","settings":{"caption":"all for under $1,000"}},{"type":"reel"},{"type":"reel"},{"type":"reel"},{"type":"reel"}] }] }
{% endschema %}
