{%- liquid
  assign ctags = ''
  for t in current_tags
    assign th = t | handleize
    assign ctags = ctags | append: th | append: ','
  endfor
  assign ctags = ctags | split: ','
  comment
    Shopify ignores a tag URL (e.g. /collections/all/macbook) when no product has that tag and shows everything.
    Detect that so the page keeps its heading/finder and shows an empty state instead of all products.
  endcomment
  assign req_tag = request.path | split: '/' | last | url_decode | downcase
  assign missing_tag = false
  if current_tags.size == 0 and collection.handle == 'all' and req_tag != 'all' and req_tag != blank and request.path contains '/collections/all/'
    assign missing_tag = true
    assign ctags = req_tag | split: '+'
  endif
-%}
{%- liquid
  assign tag_title = ''
  if current_tags.size > 0 or missing_tag
    assign tag_title = current_tags.first
    if missing_tag
      assign tag_title = ctags.first | replace: '-', ' ' | capitalize
    endif
    for b in section.blocks
      assign bh = b.settings.link | split: '/' | last | split: '?' | first
      if ctags contains bh
        assign tag_title = b.settings.label
      endif
    endfor
  endif
  if tag_title != blank
    assign page_heading = section.settings.prefix | append: ' ' | append: tag_title
  elsif collection.handle == 'all'
    assign page_heading = section.settings.all_title
  else
    assign page_heading = section.settings.prefix | append: ' ' | append: collection.title
  endif
  assign page_heading = page_heading | strip
-%}
{%- liquid
    assign ctx = ''
    for b in section.blocks
      if b.settings.parent != blank
        assign bh = b.settings.link | split: '/' | last | split: '?' | first
        if ctags contains b.settings.parent or ctags contains bh
          assign ctx = b.settings.parent
        endif
      endif
    endfor
    assign child_active = false
    for b in section.blocks
      if b.settings.parent == ctx and ctx != blank
        assign bh = b.settings.link | split: '/' | last | split: '?' | first
        if ctags contains bh
          assign child_active = true
        endif
      endif
    endfor
  -%}
{%- liquid
  assign hero_key = ctx
  if hero_key == blank and current_tags.size > 0
    assign hero_key = ctags.first
  endif
  if hero_key == blank
    assign hero_key = collection.handle
  endif
  assign hero_src = ''
  assign hero_default = ''
  assign lines = section.settings.hero_map | newline_to_br | split: '<br />'
  for line in lines
    assign pair = line | strip | split: ':'
    assign k = pair.first | strip | downcase
    assign v = line | strip | remove_first: pair.first | remove_first: ':' | strip
    if k == hero_key
      assign hero_src = v
    endif
    if k == 'default'
      assign hero_default = v
    endif
  endfor
  if hero_src == blank
    assign hero_src = hero_default
  endif
  if hero_src != blank
    unless hero_src contains '/'
      assign hero_src = hero_src | asset_url
    endunless
  endif
-%}
<div class="coll page-width" data-collection>
  <nav class="coll-crumbs" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">›</span>
    {%- if tag_title != blank -%}
      <a href="{{ collection.url }}">{{ collection.title }}</a><span aria-hidden="true">›</span><span aria-current="page">{{ tag_title }}</span>
    {%- else -%}
      <span aria-current="page">{{ collection.title }}</span>
    {%- endif -%}
  </nav>

  <section class="coll-hero coll-hero--{{ section.settings.hero_style }}">
    <div class="coll-hero__copy">
      {%- if section.settings.hero_eyebrow != blank -%}<p class="coll-hero__eyebrow">{{ section.settings.hero_eyebrow }}</p>{%- endif -%}
      <h1>{{ page_heading }}</h1>
      {%- if collection.description != blank and tag_title == blank -%}
        <div class="coll-hero__desc rte">{{ collection.description }}</div>
      {%- elsif section.settings.default_desc != blank -%}
        <p class="coll-hero__desc">{{ section.settings.default_desc }}</p>
      {%- endif -%}
      {%- if section.settings.show_trust -%}
        <ul class="coll-hero__trust">
          <li>{% render 'icon', name: 'shield' %}<span>{{ section.settings.trust_1 }}</span></li>
          <li>{% render 'icon', name: 'truck' %}<span>{{ section.settings.trust_2 }}</span></li>
          <li>{% render 'icon', name: 'swap' %}<span>{{ section.settings.trust_3 }}</span></li>
          <li>{% render 'icon', name: 'heart' %}<span>{{ section.settings.trust_4 }}</span></li>
        </ul>
      {%- endif -%}
    </div>
    {%- if hero_src != blank -%}
      <div class="coll-hero__art"><img src="{{ hero_src }}" alt="" width="900" height="700" fetchpriority="high"></div>
    {%- endif -%}
  </section>
  {%- if ctags contains 'macbook' -%}{% render 'laptop-finder', base: 'macbook', mac: true %}{%- elsif ctags contains 'laptops' -%}{% render 'laptop-finder', base: 'laptops', mac: false %}{%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="coll-chips" role="list">
      {%- if ctx != blank -%}
        {%- assign parent_label = ctx | replace: '-', ' ' | capitalize -%}
        {%- for b in section.blocks -%}
          {%- assign bh = b.settings.link | split: '/' | last | split: '?' | first -%}
          {%- if bh == ctx and b.settings.parent == blank -%}{%- assign parent_label = b.settings.label -%}{%- endif -%}
        {%- endfor -%}
        <a role="listitem" class="coll-chip{% unless child_active %} is-active{% endunless %}" href="{{ collection.url }}/{{ ctx }}"{% unless child_active %} aria-current="page"{% endunless %}>All {{ parent_label }}</a>
      {%- endif -%}
      {%- for b in section.blocks -%}
        {%- if b.settings.parent == ctx or ctx == blank and b.settings.parent == blank -%}
          {%- assign bh = b.settings.link | split: '/' | last | split: '?' | first -%}
          {%- assign on = false -%}{%- if ctags contains bh -%}{%- assign on = true -%}{%- endif -%}
          <a role="listitem" class="coll-chip{% if on %} is-active{% endif %}" href="{{ b.settings.link }}"{% if on %} aria-current="page"{% endif %} {{ b.shopify_attributes }}>{{ b.settings.label }}</a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- paginate collection.products by section.settings.per_page -%}
  <form class="coll-layout" action="{{ request.path }}" method="get" data-filter-form>
    <aside class="coll-filters" id="CollFilters" data-filter-drawer aria-label="Filters">
      <div class="coll-filters__top">
        <h2>Filters</h2>
        <button type="button" class="icon-btn coll-filters__close" data-filter-close aria-label="Close filters">{% render 'icon', name: 'close' %}</button>
      </div>
      {%- assign active_count = 0 -%}
      {%- for filter in collection.filters -%}
        {%- assign active_count = active_count | plus: filter.active_values.size -%}
        {%- if filter.type == 'price_range' and filter.min_value.value != nil or filter.type == 'price_range' and filter.max_value.value != nil -%}{%- assign active_count = active_count | plus: 1 -%}{%- endif -%}
      {%- endfor -%}
      {%- if active_count > 0 -%}
        <div class="coll-active">
          {%- for filter in collection.filters -%}
            {%- for v in filter.active_values -%}<a class="coll-active__pill" href="{{ v.url_to_remove }}">{{ v.label }} <span aria-hidden="true">×</span><span class="visually-hidden">Remove filter</span></a>{%- endfor -%}
            {%- if filter.type == 'price_range' -%}
              {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
                <a class="coll-active__pill" href="{{ filter.url_to_remove }}">{{ filter.min_value.value | default: 0 | money_without_trailing_zeros }}–{{ filter.max_value.value | default: filter.range_max | money_without_trailing_zeros }} <span aria-hidden="true">×</span><span class="visually-hidden">Remove filter</span></a>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          <a class="coll-active__clear" href="{{ request.path }}{% if collection.sort_by != blank %}?sort_by={{ collection.sort_by }}{% endif %}">Clear all</a>
        </div>
      {%- endif -%}
      {%- for filter in collection.filters -%}
        <details class="coll-filter"{% if forloop.index <= section.settings.open_filters or filter.active_values.size > 0 %} open{% endif %}>
          <summary>{{ filter.label }}<span class="coll-filter__plus" aria-hidden="true"></span></summary>
          <div class="coll-filter__body">
            {%- case filter.type -%}
              {%- when 'list', 'boolean' -%}
                {%- for v in filter.values -%}
                  <label class="coll-check{% if v.count == 0 and v.active == false %} is-empty{% endif %}">
                    <input type="checkbox" name="{{ v.param_name }}" value="{{ v.value }}"{% if v.active %} checked{% endif %}{% if v.count == 0 and v.active == false %} disabled{% endif %}>
                    {%- if filter.label contains 'olor' or filter.label contains 'olour' -%}<span class="swatch" data-swatch="{{ v.value | escape }}"></span>{%- endif -%}
                    <span class="coll-check__label">{{ v.label }}</span><span class="coll-check__count">{{ v.count }}</span>
                  </label>
                {%- endfor -%}
              {%- when 'price_range' -%}
                <div class="coll-price">
                  <label><span>Min</span><input type="number" inputmode="numeric" min="0" name="{{ filter.min_value.param_name }}" placeholder="0" value="{% if filter.min_value.value %}{{ filter.min_value.value | divided_by: 100 }}{% endif %}"></label>
                  <span aria-hidden="true">–</span>
                  <label><span>Max</span><input type="number" inputmode="numeric" min="0" name="{{ filter.max_value.param_name }}" placeholder="{{ filter.range_max | divided_by: 100 }}" value="{% if filter.max_value.value %}{{ filter.max_value.value | divided_by: 100 }}{% endif %}"></label>
                </div>
                <button type="submit" class="btn btn--sm btn--dark">Apply</button>
            {%- endcase -%}
          </div>
        </details>
      {%- else -%}
        <p class="coll-filters__none">Turn on filters in Shopify admin: Apps &gt; Search &amp; Discovery &gt; Filters. Add Price, Color, Storage and Condition.</p>
      {%- endfor -%}
      <div class="coll-filters__foot">
        <button type="submit" class="btn btn--dark btn--block">Show {{ collection.products_count }} result{% if collection.products_count != 1 %}s{% endif %}</button>
      </div>
    </aside>
    <div class="coll-filters__scrim" data-filter-close></div>

    <div class="coll-main">
      <div class="coll-bar">
        <p class="coll-bar__count">{{ collection.products_count }} product{% if collection.products_count != 1 %}s{% endif %}</p>
        {%- if section.settings.tradein_label != blank -%}
          <a class="coll-tradein" href="{{ section.settings.tradein_link | default: '/pages/sell-your-device' }}">{% render 'icon', name: 'swap' %}{{ section.settings.tradein_label }} <span aria-hidden="true">›</span></a>
        {%- endif -%}
        <div class="coll-bar__right">
          <button type="button" class="coll-bar__filter" data-filter-open aria-controls="CollFilters" aria-expanded="false">{% render 'icon', name: 'list' %}Filter{% if active_count > 0 %} <span class="coll-bar__badge">{{ active_count }}</span>{% endif %}</button>
          <label class="coll-sort"><span class="visually-hidden">Sort by</span>
            <select name="sort_by" data-autosubmit>
              {%- for o in collection.sort_options -%}<option value="{{ o.value }}"{% if o.value == collection.sort_by %} selected{% endif %}>{{ o.name }}</option>{%- endfor -%}
            </select>
          </label>
        </div>
      </div>

      <div class="coll-grid" id="coll-results">
        {%- if section.settings.show_promo -%}{%- unless paginate.current_page > 1 -%}
          <div class="coll-promo" style="--promo-bg: {{ section.settings.promo_bg }}">
            <span class="coll-promo__icon">{% render 'icon', name: 'shield' %}</span>
            <p class="coll-promo__title">{{ section.settings.promo_title }}</p>
            <p class="coll-promo__text">{{ section.settings.promo_text }}</p>
          </div>
        {%- endunless -%}{%- endif -%}
        {%- assign shown = 0 -%}{%- assign total = collection.products.size -%}
        {%- if missing_tag -%}<div class="coll-empty-tag"><p class="coll-empty-tag__h">Nothing in stock here right now</p><p>New stock lands every week. Check back soon, or <a href="{{ routes.all_products_collection_url }}">browse everything</a>.</p></div>{%- endif -%}
        {%- for product in collection.products -%}
          {%- if missing_tag -%}{%- break -%}{%- endif -%}
          {%- if product.type == 'Mail-in Repair' or product.type == 'Mail-in Diagnostic' -%}{%- continue -%}{%- endif -%}
          {% render 'product-card', product: product %}
          {%- assign shown = shown | plus: 1 -%}
          {%- unless paginate.current_page > 1 -%}
            {%- for w in (1..2) -%}
              {%- assign k = 'wide' | append: w | append: '_' -%}
              {%- assign kt = k | append: 'title' -%}{%- assign ka = k | append: 'after' -%}{%- assign kx = k | append: 'text' -%}{%- assign kl = k | append: 'link' -%}
              {%- assign kll = k | append: 'link_label' -%}{%- assign ki = k | append: 'icon' -%}{%- assign kimg = k | append: 'image' -%}{%- assign kas = k | append: 'asset' -%}{%- assign kart = k | append: 'art' -%}{%- assign kside = k | append: 'side' -%}
              {%- assign after = section.settings[ka] | plus: 0 -%}{%- assign need = after | plus: 2 -%}
              {%- if section.settings[kt] != blank and after > 0 and shown == after and total >= need -%}
                <a class="coll-wide coll-wide--{{ section.settings[kside] | default: 'auto' }}" href="{{ section.settings[kl] }}" style="--wide-bg: {{ section.settings.wide_bg }}">
                  <div class="coll-wide__copy">
                    <span class="coll-wide__icon">{% render 'icon', name: section.settings[ki] %}</span>
                    <p class="coll-wide__title">{{ section.settings[kt] }}</p>
                    <p class="coll-wide__text">{{ section.settings[kx] }}</p>
                    <span class="coll-wide__link">{{ section.settings[kll] }}</span>
                  </div>
                  <div class="coll-wide__art">
                    {%- if section.settings[kimg] != blank -%}{{ section.settings[kimg] | image_url: width: 700 | image_tag: loading: 'lazy', alt: '' }}
                    {%- elsif section.settings[kas] != blank -%}<img src="{{ section.settings[kas] | asset_url }}" alt="" width="600" height="600" loading="lazy">
                    {%- else -%}{% render 'device-art', kind: section.settings[kart], title: section.settings[kt] %}{%- endif -%}
                  </div>
                </a>
              {%- endif -%}
            {%- endfor -%}
          {%- endunless -%}
        {%- else -%}
          <div class="coll-empty">
            <p><strong>No devices match those filters.</strong></p>
            <a class="btn btn--dark btn--sm" href="{{ request.path }}">Clear filters</a>
          </div>
        {%- endfor -%}
      </div>

      {%- assign g_blog = blogs[settings.journal_blog] -%}
      {%- assign g_tag = '' -%}{%- assign g_key = ctags | first | default: collection.handle -%}
      {%- assign g_lines = section.settings.guide_map | newline_to_br | split: '<br />' -%}
      {%- for l in g_lines -%}{%- assign kv = l | split: ':' -%}{%- assign kk = kv[0] | strip -%}{%- if kk == g_key -%}{%- assign g_tag = kv[1] | strip -%}{%- endif -%}{%- endfor -%}
      {%- if g_tag != blank and g_blog -%}
        {%- for a in g_blog.articles limit: 50 -%}{%- if a.tags contains g_tag -%}
          <a class="coll-guide" href="{{ a.url }}">
            <span class="coll-guide__art"><span>{{ g_tag }}</span></span>
            <span class="coll-guide__body"><small>Journal · {{ g_tag }}</small><strong>{{ a.title }}</strong><span>{{ a.excerpt_or_content | strip_html | truncatewords: 26 }}</span></span>
            <span class="btn coll-guide__btn">Read guide</span>
          </a>
          {%- break -%}
        {%- endif -%}{%- endfor -%}
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <nav class="coll-pages" aria-label="Pagination">
          {%- if paginate.previous -%}<a class="coll-pages__btn" href="{{ paginate.previous.url }}" aria-label="Previous page">{% render 'icon', name: 'chev-left' %}</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}<a class="coll-pages__num" href="{{ part.url }}">{{ part.title }}</a>
            {%- elsif part.title == paginate.current_page -%}<span class="coll-pages__num is-current" aria-current="page">{{ part.title }}</span>
            {%- else -%}<span class="coll-pages__gap">{{ part.title }}</span>{%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a class="coll-pages__btn" href="{{ paginate.next.url }}" aria-label="Next page">{% render 'icon', name: 'chev-right' %}</a>{%- endif -%}
        </nav>
      {%- endif -%}
    </div>
  </form>
  {%- endpaginate -%}
  {%- if section.settings.show_reviews -%}
    {%- assign rv_scope = ctx | default: ctags.first | default: '' -%}
    {%- assign rv_heading = 'Customer reviews' -%}
    {% render 'coll-reviews', scope: rv_scope, heading: rv_heading %}
  {%- endif -%}
</div>

{% schema %}
{ "name": "Collection page", "settings": [
  { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 },
  { "type": "header", "content": "Heading" },
  { "type": "text", "id": "prefix", "label": "Title prefix", "default": "Pre-owned", "info": "Shown before the collection or category name, e.g. Pre-owned iPhone." },
  { "type": "text", "id": "all_title", "label": "Title on the all-products page", "default": "Shop all refurbished & certified pre-owned tech" },
  { "type": "textarea", "id": "default_desc", "label": "Description (when the collection has none)", "default": "Premium tech without the premium price. Every device is tested by our technicians, backed by a 1-year warranty and free 30-day returns." },
  { "type": "header", "content": "Hero banner" },
  { "type": "select", "id": "hero_style", "label": "Style", "options": [{"value":"dark","label":"Dark with colour glow"},{"value":"gradient","label":"Theme gradient"},{"value":"light","label":"Light"}], "default": "dark" },
  { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow", "default": "Refurbished & certified pre-owned" },
  { "type": "textarea", "id": "hero_map", "label": "Photo per category", "default": "default: tech-iphones.webp", "info": "One per line: tag: image. The image is a theme asset filename or a full image URL from Content > Files. Sub-pages (e.g. iPhone 15) use their parent's photo. 'default' is used everywhere else." },
  { "type": "header", "content": "Trust bar" },
  { "type": "checkbox", "id": "show_trust", "label": "Show trust bar", "default": true },
  { "type": "text", "id": "trust_1", "label": "Item 1", "default": "1-year warranty" },
  { "type": "text", "id": "trust_2", "label": "Item 2", "default": "Free standard shipping" },
  { "type": "text", "id": "trust_3", "label": "Item 3", "default": "Free 30-day returns" },
  { "type": "text", "id": "trust_4", "label": "Item 4", "default": "Real people, real support" },
  { "type": "header", "content": "Toolbar" },
  { "type": "text", "id": "tradein_label", "label": "Trade-in pill", "default": "Trade in to get it for less", "info": "Leave blank to hide." },
  { "type": "url", "id": "tradein_link", "label": "Trade-in link" },
  { "type": "range", "id": "open_filters", "label": "Filters open by default", "min": 0, "max": 6, "step": 1, "default": 2 },
  { "type": "header", "content": "Promo tile" },
  { "type": "checkbox", "id": "show_reviews", "label": "Show customer reviews (only when real reviews exist)", "default": true },
  { "type": "textarea", "id": "guide_map", "label": "Journal guide under the grid: tag: Journal tag", "default": "iphone: Phones\nsamsung: Phones\nandroid: Phones\nsmartphones: Phones\nipad: Tablets\ntablets: Tablets\nmacbook: Laptops\nlaptops: Laptops\nconsoles: Gaming\nplaystation: Gaming\nxbox: Gaming\nnintendo: Gaming\naudio: Audio\naccessories: Accessories\ncables: Accessories" },
  { "type": "header", "content": "Wide promo cards (in the product grid)" },
  { "type": "color", "id": "wide_bg", "label": "Card background", "default": "#FCE1EE" },
  { "type": "text", "id": "wide1_title", "label": "Card 1 title", "default": "Free case + screen protector" },
  { "type": "textarea", "id": "wide1_text", "label": "Card 1 text", "default": "Get both free with any eligible phone. Your new phone is protected from day one." },
  { "type": "text", "id": "wide1_link_label", "label": "Card 1 link text", "default": "See eligible phones" },
  { "type": "url", "id": "wide1_link", "label": "Card 1 link" },
  { "type": "select", "id": "wide1_icon", "label": "Card 1 icon", "default": "shield", "options": [{"value":"shield","label":"Shield"},{"value":"phone","label":"Phone"},{"value":"truck","label":"Truck"},{"value":"swap","label":"Swap"}] },
  { "type": "image_picker", "id": "wide1_image", "label": "Card 1 image" },
  { "type": "text", "id": "wide1_asset", "label": "Card 1 theme image file" },
  { "type": "select", "id": "wide1_art", "label": "Card 1 drawing (if no image)", "default": "case", "options": [{"value":"case","label":"Case"},{"value":"phone","label":"Phone"},{"value":"protector","label":"Screen protector"}] },
  { "type": "select", "id": "wide1_side", "label": "Card 1 side", "default": "left", "options": [{"value":"left","label":"Left"},{"value":"right","label":"Right"},{"value":"auto","label":"Wherever it fits"}] },
  { "type": "number", "id": "wide1_after", "label": "Card 1 shows after product #", "default": 5 },
  { "type": "text", "id": "wide2_title", "label": "Card 2 title", "default": "Bundle a phone plan" },
  { "type": "textarea", "id": "wide2_text", "label": "Card 2 text", "default": "Pair your phone with a mobile plan at a better price. We set it up so you leave connected." },
  { "type": "text", "id": "wide2_link_label", "label": "Card 2 link text", "default": "Learn more" },
  { "type": "url", "id": "wide2_link", "label": "Card 2 link", "default": "/collections/all" },
  { "type": "select", "id": "wide2_icon", "label": "Card 2 icon", "default": "phone", "options": [{"value":"shield","label":"Shield"},{"value":"phone","label":"Phone"},{"value":"truck","label":"Truck"},{"value":"swap","label":"Swap"}] },
  { "type": "image_picker", "id": "wide2_image", "label": "Card 2 image" },
  { "type": "text", "id": "wide2_asset", "label": "Card 2 theme image file", "default": "pdp-step-storage.webp" },
  { "type": "select", "id": "wide2_art", "label": "Card 2 drawing (if no image)", "default": "phone", "options": [{"value":"case","label":"Case"},{"value":"phone","label":"Phone"},{"value":"protector","label":"Screen protector"}] },
  { "type": "select", "id": "wide2_side", "label": "Card 2 side", "default": "left", "options": [{"value":"left","label":"Left"},{"value":"right","label":"Right"},{"value":"auto","label":"Wherever it fits"}] },
  { "type": "number", "id": "wide2_after", "label": "Card 2 shows after product #", "default": 11 },
  { "type": "checkbox", "id": "show_promo", "label": "Show promo tile first in the grid", "default": true },
  { "type": "text", "id": "promo_title", "label": "Title", "default": "Free 1-year warranty included" },
  { "type": "text", "id": "promo_text", "label": "Text", "default": "Repair or replacement on us, on every device." },
  { "type": "color", "id": "promo_bg", "label": "Background", "default": "#CDEFF7" }
],
"blocks": [{ "type": "chip", "name": "Quick link", "settings": [
  { "type": "text", "id": "label", "label": "Label", "default": "iPhone" },
