{%- assign slides = section.blocks | where: 'type', 'slide' -%}
{%- assign stats = section.blocks | where: 'type', 'stat' -%}
<section class="section page-width why-hero">
  {%- if slides.size > 0 -%}
  <div class="why-slider" data-slideshow data-autoplay="{% if section.settings.autoplay %}{{ section.settings.speed }}{% else %}0{% endif %}" role="region" aria-roledescription="carousel" aria-label="{{ section.settings.label | escape }}">
    <div class="why-slider__track" data-slides>
      {%- for block in slides -%}
        <div class="why-slide" id="WhySlide-{{ block.id }}" role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ slides.size }}" style="--slide-bg: {{ block.settings.bg }}; --slide-ink: {{ block.settings.ink }}" {{ block.shopify_attributes }}>
          <div class="why-slide__copy">
            {%- if block.settings.eyebrow != blank -%}<p class="why-slide__eyebrow">{{ block.settings.eyebrow }}</p>{%- endif -%}
            {%- if forloop.first -%}<h1>{{ block.settings.heading }}</h1>{%- else -%}<h2 class="why-slide__h">{{ block.settings.heading }}</h2>{%- endif -%}
            {%- if block.settings.text != blank -%}<div class="why-slide__text">{{ block.settings.text }}</div>{%- endif -%}
            <div class="why-hero__ctas">
              {%- if block.settings.button_label != blank -%}<a class="btn btn--dark btn--lg" href="{{ block.settings.button_link | default: '/collections/all' }}">{{ block.settings.button_label }}</a>{%- endif -%}
              {%- if block.settings.button2_label != blank -%}<a class="btn btn--lg" href="{{ block.settings.button2_link | default: '/pages/sell-your-device' }}">{{ block.settings.button2_label }}</a>{%- endif -%}
            </div>
          </div>
          <div class="why-slide__art">
            {%- if block.settings.image != blank -%}
              {%- if forloop.first -%}{%- assign load = 'eager' -%}{%- else -%}{%- assign load = 'lazy' -%}{%- endif -%}
              {{ block.settings.image | image_url: width: 1000 | image_tag: loading: load, sizes: '(min-width: 750px) 45vw, 100vw', alt: block.settings.heading }}
            {%- else -%}{% render 'device-art', kind: block.settings.art, title: block.settings.heading, section: section, idx: forloop.index %}{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
    {%- if slides.size > 1 -%}
      <div class="why-slider__controls">
        <button type="button" class="arrow" data-slide-prev aria-label="Previous slide">{% render 'icon', name: 'chev-left' %}</button>
        <div class="why-slider__dots">
          {%- for block in slides -%}<button type="button" class="why-dot{% if forloop.first %} is-active{% endif %}" data-slide-dot="{{ forloop.index0 }}" aria-controls="WhySlide-{{ block.id }}" aria-label="Go to slide {{ forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}></button>{%- endfor -%}
        </div>
        <button type="button" class="arrow arrow--dark" data-slide-next aria-label="Next slide">{% render 'icon', name: 'chev-right' %}</button>
      </div>
    {%- endif -%}
  </div>
  {%- endif -%}
  {%- if stats.size > 0 -%}
    <ul class="why-stats">
      {%- for block in stats -%}
        <li class="why-stat" {{ block.shopify_attributes }}><strong>{{ block.settings.value }}</strong><span>{{ block.settings.label }}</span></li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Why refurbished: hero",
  "settings": [
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate slides", "default": true },
    { "type": "range", "id": "speed", "label": "Seconds per slide", "min": 3, "max": 12, "step": 1, "unit": "s", "default": 6 },
    { "type": "text", "id": "label", "label": "Slideshow name (for screen readers)", "default": "Why refurbished" }
  ],
  "blocks": [
    { "type": "slide", "name": "Slide", "limit": 6, "settings": [
      { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WHY REFURBISHED" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Same phone. Way less money. No catch." },
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tested, repaired and graded by our technicians, then backed by a 1-year warranty.</p>" },
      { "type": "image_picker", "id": "image", "label": "Image", "info": "Transparent PNG works best. Leave blank for a built-in illustration." },
      { "type": "select", "id": "art", "label": "Illustration (when no image)", "options": [
        {"value":"hero","label":"Device lineup"},{"value":"phone","label":"Phone"},{"value":"laptop","label":"Laptop"},{"value":"tablet","label":"Tablet"},{"value":"watch","label":"Watch"},{"value":"deal","label":"Laptop + phone"}
      ], "default": "hero" },
      { "type": "color", "id": "bg", "label": "Background", "default": "#F3F0FF" },
      { "type": "color", "id": "ink", "label": "Text", "default": "#111111" },
      { "type": "text", "id": "button_label", "label": "Button", "default": "Shop refurbished" },
      { "type": "url", "id": "button_link", "label": "Button link" },
      { "type": "text", "id": "button2_label", "label": "Second button" },
      { "type": "url", "id": "button2_link", "label": "Second button link" }
    ] },
    { "type": "stat", "name": "Stat", "limit": 4, "settings": [
      { "type": "text", "id": "value", "label": "Value", "default": "1 year" },
      { "type": "text", "id": "label", "label": "Label", "default": "Warranty on every device" }
    ] }
  ],
  "presets": [{ "name": "Why refurbished: hero", "blocks": [
    { "type": "slide", "settings": { "eyebrow": "WHY REFURBISHED", "heading": "Same phone. Way less money. No catch.", "text": "<p>Every device is tested, repaired and graded by our technicians, then backed by a 1-year warranty. You get the tech you want without paying the new-in-box tax.</p>", "art": "hero", "bg": "#F3F0FF", "button_label": "Shop refurbished", "button2_label": "Trade in your old device" } },
    { "type": "slide", "settings": { "eyebrow": "TESTED, NOT GUESSED", "heading": "Checked up to 100 ways before it reaches you.", "text": "<p>Screen, battery, cameras, Face ID, charging, signal. Anything that fails gets fixed or the device doesn't make it.</p>", "art": "phone", "bg": "#E6F7EF", "button_label": "See how we refurbish", "button_link": "#how-we-refurbish" } },
    { "type": "slide", "settings": { "eyebrow": "ZERO RISK", "heading": "Don't love it? Send it back free.", "text": "<p>30 days to change your mind, plus a 1-year warranty after that. Buying used has never been this safe.</p>", "art": "deal", "bg": "#FDECEF", "button_label": "Shop now" } },
    { "type": "stat", "settings": { "value": "Up to 50%", "label": "Less than buying new" } },
    { "type": "stat", "settings": { "value": "1 year", "label": "Warranty on every device" } },
    { "type": "stat", "settings": { "value": "30 days", "label": "Free returns" } },
    { "type": "stat", "settings": { "value": "100-point", "label": "Quality inspection" } }
  ] }]
}
{% endschema %}
