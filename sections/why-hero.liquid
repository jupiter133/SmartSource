<section class="section page-width why-hero">
  <div class="why-hero__copy">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow-grad">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1>{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}<div class="why-hero__text">{{ section.settings.text }}</div>{%- endif -%}
    <div class="why-hero__ctas">
      {%- if section.settings.button_label != blank -%}<a class="btn btn--dark btn--lg" href="{{ section.settings.button_link | default: '/collections/all' }}">{{ section.settings.button_label }}</a>{%- endif -%}
      {%- if section.settings.button2_label != blank -%}<a class="btn btn--lg" href="{{ section.settings.button2_link | default: '/pages/sell-your-device' }}">{{ section.settings.button2_label }}</a>{%- endif -%}
    </div>
  </div>
  <div class="why-hero__art">
    {%- if section.settings.image != blank -%}{{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'eager', sizes: '(min-width: 990px) 45vw, 100vw' }}{%- else -%}{% render 'device-art', kind: 'hero', title: section.settings.heading, section: section, idx: 0 %}{%- endif -%}
  </div>
  {%- if section.blocks.size > 0 -%}
    <ul class="why-stats">
      {%- for block in section.blocks -%}
        <li class="why-stat" {{ block.shopify_attributes }}><strong>{{ block.settings.value }}</strong><span>{{ block.settings.label }}</span></li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Why refurbished: hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WHY REFURBISHED" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Same phone. Way less money. No catch." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every device is tested, repaired and graded by our technicians, then backed by a 1-year warranty. You get the tech you want without paying the new-in-box tax.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave blank for the built-in device illustration." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Shop refurbished" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button2_label", "label": "Second button", "default": "Trade in your old device" },
    { "type": "url", "id": "button2_link", "label": "Second button link" }
  ],
  "blocks": [
    { "type": "stat", "name": "Stat", "limit": 4, "settings": [
      { "type": "text", "id": "value", "label": "Value", "default": "1 year" },
      { "type": "text", "id": "label", "label": "Label", "default": "Warranty on every device" }
    ] }
  ],
  "presets": [{ "name": "Why refurbished: hero", "blocks": [
    { "type": "stat", "settings": { "value": "Up to 50%", "label": "Less than buying new" } },
    { "type": "stat", "settings": { "value": "1 year", "label": "Warranty on every device" } },
    { "type": "stat", "settings": { "value": "30 days", "label": "Free returns" } },
    { "type": "stat", "settings": { "value": "100-point", "label": "Quality inspection" } }
  ] }]
}
{% endschema %}
