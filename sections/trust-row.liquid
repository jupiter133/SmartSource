<section class="section page-width trust-row">
  <ul class="trust-row__list">
    {%- for block in section.blocks -%}
      <li {{ block.shopify_attributes }}><span class="trust-row__icon">{% render 'icon', name: block.settings.icon %}</span><span>{{ block.settings.text }}</span></li>
    {%- endfor -%}
  </ul>
</section>
{% schema %}
{ "name": "Trust row", "blocks": [{ "type": "item", "name": "Item", "settings": [
  { "type": "select", "id": "icon", "label": "Icon", "options": [{"value":"list","label":"Checklist"},{"value":"swap","label":"Returns"},{"value":"award","label":"Warranty"},{"value":"truck","label":"Shipping"},{"value":"shield","label":"Shield"},{"value":"unlock","label":"Unlocked"},{"value":"battery","label":"Battery"}], "default": "list" },
  { "type": "text", "id": "text", "label": "Text", "default": "Up to 100-point quality inspection" }
]}], "presets": [{ "name": "Trust row", "blocks": [
  {"type":"item","settings":{"icon":"list","text":"Up to 100-point quality inspection"}},
  {"type":"item","settings":{"icon":"swap","text":"Free 30-day returns"}},
  {"type":"item","settings":{"icon":"award","text":"1-year warranty"}}
]}] }
{% endschema %}
