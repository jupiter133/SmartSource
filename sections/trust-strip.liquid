<div class="trust-strip">
  <div class="trust-strip__inner{% if section.settings.marquee %} is-marquee{% endif %}">
    {%- for block in section.blocks -%}
      <div class="trust-item" {{ block.shopify_attributes }}><span class="trust-item__icon">{% render 'icon', name: block.settings.icon %}</span><span>{{ block.settings.text }}</span></div>
    {%- endfor -%}
    {%- if section.settings.marquee -%}
      {%- for block in section.blocks -%}
        <div class="trust-item trust-dup" aria-hidden="true"><span class="trust-item__icon">{% render 'icon', name: block.settings.icon %}</span><span>{{ block.settings.text }}</span></div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>
{% schema %}
{ "name": "Trust strip", "settings": [{ "type": "checkbox", "id": "marquee", "label": "Scroll on mobile", "default": true }],
  "blocks": [{ "type": "item", "name": "Item", "settings": [
    { "type": "select", "id": "icon", "label": "Icon", "options": [{"value":"shield","label":"Shield"},{"value":"cash","label":"Cash"},{"value":"percent","label":"Percent"},{"value":"check","label":"Check"},{"value":"truck","label":"Truck"},{"value":"swap","label":"Returns"}], "default": "shield" },
    { "type": "text", "id": "text", "label": "Text", "default": "Backed by 12-month warranty" }
  ]}], "max_blocks": 6,
  "presets": [{ "name": "Trust strip", "blocks": [
    {"type":"item","settings":{"icon":"shield","text":"Backed by 12-Month Warranty"}},
    {"type":"item","settings":{"icon":"cash","text":"30-Day Money-Back Guarantee"}},
    {"type":"item","settings":{"icon":"percent","text":"Up to 70% Off Retail Prices"}},
    {"type":"item","settings":{"icon":"check","text":"90+ Point Certified Inspection"}}
  ]}] }
{% endschema %}
