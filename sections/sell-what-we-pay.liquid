{%- comment -%}
  "What we pay": one tab per brand/category (blocks), each a list of models linking into the quote wizard.
  Everything comes from the buyback metaobjects, so price edits in Content > Metaobjects show up here automatically.
  One row per model, most valuable first. "Up to" = the top price (top storage): brand new sealed where set, else Like New;
  (no secondary used-price line).
{%- endcomment -%}
{%- liquid
  assign quote_url = section.settings.quote_page | default: request.path
  assign row_limit = section.settings.limit | default: 0
  assign view_all_url = section.settings.view_all_page | default: '/pages/what-we-pay'
  assign tabs = section.blocks | where: 'type', 'tab'
  comment
    One tab (brand pages): no tab bar, and the section heading replaces the panel heading.
  endcomment
  assign single = false
  if tabs.size == 1
    assign single = true
  endif
  if settings.prices_updated_date != blank
    assign updated = settings.prices_updated_date
  else
    assign updated = 'now' | date: '%B %-d, %Y'
  endif
-%}
{%- capture panels -%}
  {%- comment -%} Guard: paginate errors if the buyback_device type is missing or not storefront-readable. {%- endcomment -%}
  {%- if metaobjects.buyback_device.values.size > 0 -%}
  {%- paginate metaobjects.buyback_device.values by 250 -%}
    {%- for block in tabs -%}
      {%- liquid
        assign want_brand = block.settings.brand | downcase | strip
        assign want_cat = block.settings.category | downcase | strip
        assign recs = ''
        for d in metaobjects.buyback_device.values
          if d.active.value == false
            continue
          endif
          assign b = d.brand.value.name.value | downcase | strip
          assign c = d.category.value.name.value | downcase | strip
          if b != want_brand or c != want_cat
            continue
          endif
          assign best = 0
          assign sealed = 0
          for pr in d.prices.value
            assign v = pr.price_like_new.value | default: 0 | times: 1.0
            if v > best
              assign best = v
            endif
            assign s = pr.price_new.value | default: 0 | times: 1.0
            if s > sealed
              assign sealed = s
            endif
          endfor
          if best <= 0 and sealed <= 0
            continue
          endif
          comment
            Most valuable first (sealed-only models rank by their sealed price), newest first on ties.
          endcomment
          assign rank = best
          if sealed > rank
            assign rank = sealed
          endif
          assign pkey = 99999 | minus: rank | round | prepend: '00000' | slice: -5, 5
          assign yr = d.release_year.value | default: 0 | times: 1
          assign ykey = 9999 | minus: yr | prepend: '0000' | slice: -4, 4
          assign skey = d.sort_order.value | default: 999 | plus: 10000
          assign safe_name = d.name.value | replace: '~', '-' | replace: '¦', '-'
          assign rec = pkey | append: ykey | append: skey | append: '~' | append: d.system.handle | append: '~' | append: safe_name | append: '~' | append: best | append: '~' | append: sealed
          assign recs = recs | append: '¦' | append: rec
        endfor
      -%}
      {%- if recs != blank -%}
        {%- assign sorted = recs | remove_first: '¦' | split: '¦' | sort -%}
        <div class="pay-panel" id="pay-panel-{{ block.id }}"{% unless single %} role="tabpanel" aria-labelledby="pay-tab-{{ block.id }}"{% endunless %} data-pay-panel data-pay-key="{{ block.settings.label | handleize }}" {{ block.shopify_attributes }}{% unless forloop.first %} hidden{% endunless %}>
          <div class="pay-panel__head">
            {%- unless single and section.settings.heading != blank -%}<h3>How much is my {{ block.settings.noun }} worth?</h3>{%- endunless -%}
            <p class="muted">{{ section.settings.panel_line }}{% unless settings.sell_live %} <span class="wiz-preview-tag">Preview</span>{% endunless %}</p>
          </div>
          {%- if section.settings.group_series -%}
            {%- liquid
              comment
                Group by series (iPhone 17, Galaxy S25, Pixel 9, iPad Pro, ...). Rows are already most valuable first,
                so series come out ordered by their top value and models stay most valuable first inside each series.
              endcomment
              assign order = '¦'
              assign labeled = ''
              for r in sorted
                if row_limit > 0 and forloop.index > row_limit
                  break
                endif
                assign f = r | split: '~'
                capture lab
                  render 'sell-series', name: f[2]
                endcapture
                assign lab = lab | strip
                assign key = '¦' | append: lab | append: '¦'
                unless order contains key
                  assign order = order | append: lab | append: '¦'
                endunless
                assign labeled = labeled | append: '§' | append: lab | append: '¤' | append: r
              endfor
              assign series_list = order | remove_first: '¦' | split: '¦'
              assign items = labeled | remove_first: '§' | split: '§'
            -%}
            <div class="pay-series-grid">
              {%- for g in series_list -%}
                <section class="pay-series">
                  {%- if single and section.settings.heading != blank -%}<h3 class="pay-series__title">{{ g }}</h3>{%- else -%}<h4 class="pay-series__title">{{ g }}</h4>{%- endif -%}
                  <ul class="pay-list pay-list--one" role="list">
                    {%- for it in items -%}
                      {%- assign parts = it | split: '¤' -%}
                      {%- if parts[0] == g -%}{%- render 'sell-pay-row', rec: parts[1], quote_url: quote_url -%}{%- endif -%}
                    {%- endfor -%}
                  </ul>
                </section>
              {%- endfor -%}
            </div>
          {%- else -%}
          <ul class="pay-list" role="list">
            {%- for r in sorted -%}
              {%- if row_limit > 0 and forloop.index > row_limit -%}{%- break -%}{%- endif -%}
              {%- render 'sell-pay-row', rec: r, quote_url: quote_url -%}
            {%- endfor -%}
          </ul>
          {%- endif -%}
          {%- if row_limit > 0 and sorted.size > row_limit -%}
            <a class="pay-viewall" href="{% if block.settings.url != blank %}{{ block.settings.url }}{% else %}{{ view_all_url }}?tab={{ block.settings.label | handleize }}{% endif %}">View all {{ sorted.size }} {{ block.settings.noun }} prices <span aria-hidden="true">→</span></a>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  {%- endpaginate -%}
  {%- endif -%}
{%- endcapture -%}

{%- if panels != blank or request.design_mode -%}
<section class="section page-width sell-pay{% if single %} sell-pay--single{% endif %}" id="what-we-pay" data-pay>
  {%- if section.settings.heading != blank or section.settings.subtext != blank or section.settings.tagline != blank -%}
  <div class="sell-pay__head">
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.tagline != blank -%}<p class="sell-tagline">{{ section.settings.tagline }}</p>{%- endif -%}
    {%- if section.settings.subtext != blank -%}<p class="muted">{% render 'sell-text', text: section.settings.subtext %}</p>{%- endif -%}
  </div>
  {%- endif -%}

  {%- if panels != blank -%}
    {%- unless single -%}
    <div class="pay-tabs" role="tablist" aria-label="Device type" data-pay-tabs>
      {%- for block in tabs -%}
        <button type="button" class="pay-tab" role="tab" id="pay-tab-{{ block.id }}" aria-controls="pay-panel-{{ block.id }}" data-pay-key="{{ block.settings.label | handleize }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"{% unless forloop.first %} tabindex="-1"{% endunless %} data-pay-tab>{{ block.settings.label }}</button>
      {%- endfor -%}
    </div>
    {%- endunless -%}
    {{ panels }}
    <noscript><style>[data-pay-panel][hidden]{display:block!important}.pay-tabs{display:none}</style></noscript>
  {%- else -%}
    <p class="sell-pay__empty">No prices to show yet. Add Buyback device entries with prices in Content &gt; Metaobjects, and check each tab's brand and category names match. (Only you see this message in the theme editor.)</p>
  {%- endif -%}

  <div class="sell-pay__foot">
    <p class="sell-pay__note">Prices updated {{ updated }}. {% render 'sell-text', text: section.settings.footnote %}</p>
    {%- if section.settings.cta_label != blank -%}
      <a class="btn btn--accent btn--lg" href="{% if section.settings.quote_page != blank %}{{ section.settings.quote_page }}{% endif %}#sell-quote"{% if section.settings.quote_page == blank %} data-sell-start{% endif %}>{{ section.settings.cta_label }}</a>
    {%- endif -%}
  </div>
</section>
<script>
(function(){var R=document.currentScript.previousElementSibling;if(!R||!R.matches('[data-pay]'))return;
var tabs=[].slice.call(R.querySelectorAll('[data-pay-tab]'));
function pick(t,focus){tabs.forEach(function(x){var on=x===t;x.setAttribute('aria-selected',on);x.tabIndex=on?0:-1;var p=document.getElementById(x.getAttribute('aria-controls'));if(p)p.hidden=!on});if(focus)t.focus()}
tabs.forEach(function(t,i){t.addEventListener('click',function(){pick(t)});t.addEventListener('keydown',function(e){var k=e.key,j=k==='ArrowRight'?i+1:k==='ArrowLeft'?i-1:k==='Home'?0:k==='End'?tabs.length-1:null;if(j===null)return;e.preventDefault();pick(tabs[(j+tabs.length)%tabs.length],true)})});
// a tab whose brand has no priced models has no panel: hide it
tabs.forEach(function(t){if(!document.getElementById(t.getAttribute('aria-controls')))t.hidden=true});
var want=new URLSearchParams(location.search).get('tab');var wt=want&&tabs.find(function(t){return !t.hidden&&t.dataset.payKey===want});
var first=wt||tabs.find(function(t){return !t.hidden});if(first&&first.getAttribute('aria-selected')!=='true')pick(first)})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Sell: what we pay",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What we pay" },
    { "type": "text", "id": "tagline", "label": "Bold line under the heading", "default": "We pay top dollar for your tech in Canada." },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Current top offers for every model we buy. Pick yours for an exact quote." },
    { "type": "checkbox", "id": "group_series", "label": "Group models by series", "default": true, "info": "e.g. iPhone 17, Galaxy S25, Pixel 9, iPad Pro, Apple Watch Ultra. Series with the highest offers come first." },
    { "type": "text", "id": "panel_line", "label": "Line under each tab heading", "default": "Your exact offer depends on storage, carrier and condition." },
    { "type": "textarea", "id": "footnote", "label": "Footnote", "default": "\"Up to\" values are for the top storage option, brand new and sealed where we buy sealed, otherwise Like New. Your final offer follows inspection.", "info": "Starts with \"Prices updated\" and the date from Theme settings > Sell program (today's date if that's empty)." },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Get my instant offer" },
    { "type": "url", "id": "quote_page", "label": "Page with the quote wizard", "info": "Leave blank when the wizard is on this page." },
    { "type": "number", "id": "limit", "label": "Models shown per tab", "default": 9, "info": "0 = show every model. When there are more, a \"View all\" link opens the tab's link, or the full price page. With one tab, the tab bar is hidden." },
    { "type": "url", "id": "view_all_page", "label": "Full price list page", "info": "Defaults to /pages/what-we-pay" },
    { "type": "paragraph", "content": "Each tab lists every active device of one brand and category from Content > Metaobjects, most valuable first. Prices update automatically." }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "iPhone" },
        { "type": "text", "id": "noun", "label": "Heading device name", "default": "iPhone", "info": "Shown as: How much is my ___ worth?" },
        { "type": "text", "id": "brand", "label": "Brand name", "default": "Apple", "info": "Must match the buyback brand name." },
        { "type": "text", "id": "category", "label": "Category name", "default": "Smartphone", "info": "Must match the buyback category name." },
        { "type": "url", "id": "url", "label": "\"View all\" link", "info": "e.g. this brand's own sell page. Blank = the full price page." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sell: what we pay",
      "blocks": [
        { "type": "tab", "settings": { "label": "iPhone", "noun": "iPhone", "brand": "Apple", "category": "Smartphone" } },
        { "type": "tab", "settings": { "label": "Samsung", "noun": "Samsung Galaxy", "brand": "Samsung", "category": "Smartphone" } },
        { "type": "tab", "settings": { "label": "Pixel", "noun": "Google Pixel", "brand": "Google", "category": "Smartphone" } },
        { "type": "tab", "settings": { "label": "iPad", "noun": "iPad", "brand": "Apple", "category": "Tablet" } },
        { "type": "tab", "settings": { "label": "Apple Watch", "noun": "Apple Watch", "brand": "Apple", "category": "Smartwatch" } }
      ]
    }
  ]
}
{% endschema %}
