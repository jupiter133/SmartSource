{%- comment -%}
  "Trade in these devices for cash": tabs (iPhone, Other phones, Tablets, ...) with a plain list of every model we buy,
  most valuable first. Each link opens the quote wizard with that model picked. Long lists show "See more".
{%- endcomment -%}
{%- liquid
  assign quote_url = section.settings.quote_page | default: request.path
  assign tabs = section.blocks | where: 'type', 'tab'
  assign show_n = section.settings.show | default: 24
-%}
{%- capture panels -%}
  {%- if metaobjects.buyback_device.values.size > 0 -%}
  {%- paginate metaobjects.buyback_device.values by 250 -%}
    {%- for block in tabs -%}
      {%- liquid
        assign want_brand = block.settings.brand | downcase | strip
        assign not_brand = block.settings.exclude_brand | downcase | strip
        assign want_cat = block.settings.category | downcase | strip
        assign recs = ''
        for d in metaobjects.buyback_device.values
          if d.active.value == false
            continue
          endif
          assign b = d.brand.value.name.value | downcase | strip
          assign c = d.category.value.name.value | downcase | strip
          if want_cat != blank and c != want_cat
            continue
          endif
          if want_brand != blank and b != want_brand
            continue
          endif
          if not_brand != blank and b == not_brand
            continue
          endif
          assign top = 0
          for pr in d.prices.value
            assign v = pr.price_like_new.value | default: 0 | times: 1.0
            if v > top
              assign top = v
            endif
            assign s = pr.price_new.value | default: 0 | times: 1.0
            if s > top
              assign top = s
            endif
          endfor
          if top <= 0
            continue
          endif
          assign pkey = 99999 | minus: top | round | prepend: '00000' | slice: -5, 5
          assign safe_name = d.name.value | replace: '~', '-' | replace: '¦', '-'
          assign recs = recs | append: '¦' | append: pkey | append: '~' | append: d.system.handle | append: '~' | append: safe_name
        endfor
      -%}
      {%- if recs != blank -%}
        {%- assign sorted = recs | remove_first: '¦' | split: '¦' | sort -%}
        <div class="sx-dir__panel" id="SxDir-{{ block.id }}" role="tabpanel" aria-labelledby="SxDirTab-{{ block.id }}" data-dir-panel {{ block.shopify_attributes }}{% unless forloop.first %} hidden{% endunless %}>
          <ul class="sx-dir__list" role="list">
            {%- for r in sorted -%}
              {%- assign f = r | split: '~' -%}
              <li{% if forloop.index > show_n %} class="sx-dir__more" hidden{% endif %}><a href="{{ quote_url }}?sell_device={{ f[1] | url_encode }}#sell-quote" data-sell-start data-device="{{ f[1] | escape }}">{{ f[2] }}</a></li>
            {%- endfor -%}
          </ul>
          {%- if sorted.size > show_n -%}
            <button type="button" class="sx-dir__toggle" aria-expanded="false" data-dir-more>See more <span aria-hidden="true">↓</span></button>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  {%- endpaginate -%}
  {%- endif -%}
{%- endcapture -%}

{%- if panels != blank -%}
<section class="section page-width sx sx-dir" data-dir>
  {%- if section.settings.heading != blank -%}<h2 class="sx-title">{{ section.settings.heading }}</h2>{%- endif -%}
  <div class="sx-dir__tabs" role="tablist" aria-label="Device type">
    {%- for block in tabs -%}
      <button type="button" class="sx-dir__tab" role="tab" id="SxDirTab-{{ block.id }}" aria-controls="SxDir-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"{% unless forloop.first %} tabindex="-1"{% endunless %} data-dir-tab>{{ block.settings.label }}</button>
    {%- endfor -%}
  </div>
  {{ panels }}
</section>
<script>
(function(){var R=document.currentScript.previousElementSibling;if(!R||!R.matches('[data-dir]'))return;
var tabs=[].slice.call(R.querySelectorAll('[data-dir-tab]'));
tabs.forEach(function(t){if(!document.getElementById(t.getAttribute('aria-controls')))t.hidden=true});
function pick(t,focus){tabs.forEach(function(x){var on=x===t;x.setAttribute('aria-selected',on);x.tabIndex=on?0:-1;var p=document.getElementById(x.getAttribute('aria-controls'));if(p)p.hidden=!on});if(focus)t.focus()}
tabs.forEach(function(t,i){t.addEventListener('click',function(){pick(t)});t.addEventListener('keydown',function(e){var v=tabs.filter(function(x){return !x.hidden}),j=v.indexOf(t),k=e.key==='ArrowRight'?j+1:e.key==='ArrowLeft'?j-1:e.key==='Home'?0:e.key==='End'?v.length-1:null;if(k===null)return;e.preventDefault();pick(v[(k+v.length)%v.length],true)})});
var first=tabs.find(function(t){return !t.hidden});if(first&&first.getAttribute('aria-selected')!=='true')pick(first);
R.addEventListener('click',function(e){var b=e.target.closest('[data-dir-more]');if(!b)return;var p=b.closest('[data-dir-panel]');var open=b.getAttribute('aria-expanded')!=='true';
p.querySelectorAll('.sx-dir__more').forEach(function(li){li.hidden=!open});b.setAttribute('aria-expanded',open);b.firstChild.textContent=open?'See less ':'See more ';b.lastElementChild.textContent=open?'↑':'↓'})})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Sell: device directory",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Trade in these devices for cash" },
    { "type": "number", "id": "show", "label": "Models shown before \"See more\"", "default": 24 },
    { "type": "url", "id": "quote_page", "label": "Page with the quote wizard", "info": "Leave blank when the wizard is on this page." }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "iPhone" },
        { "type": "text", "id": "category", "label": "Category name", "default": "Smartphone", "info": "Must match the buyback category name." },
        { "type": "text", "id": "brand", "label": "Only this brand", "info": "Blank = every brand." },
        { "type": "text", "id": "exclude_brand", "label": "Leave out this brand", "info": "e.g. Apple for \"Other phones\"." }
      ]
    }
  ],
  "presets": [ { "name": "Sell: device directory", "blocks": [ { "type": "tab", "settings": { "label": "iPhone", "brand": "Apple" } } ] } ]
}
{% endschema %}
