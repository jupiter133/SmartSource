<section class="section page-width" data-carousel>
  <div class="section__head">
    <h2>{{ section.settings.heading }}</h2>
    {% render 'carousel-arrows' %}
  </div>
  <div class="carousel" data-track>
    {%- for block in section.blocks -%}
      {%- assign c = block.settings.collection -%}
      <a class="cat-tile" href="{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}{{ c.url }}{% endif %}" {{ block.shopify_attributes }}>
        <div class="cat-tile__img">
          {%- assign img = block.settings.image | default: c.featured_image -%}
          {%- if img != blank -%}{{ img | image_url: width: 240 | image_tag: loading: 'lazy' }}{%- else -%}{% render 'device-art', title: block.settings.title, section: section, idx: forloop.index %}{%- endif -%}
        </div>
        <span>{{ block.settings.title | default: c.title }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{ "name": "Category carousel", "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Shop our most wanted" } ],
  "blocks": [ { "type": "category", "name": "Category", "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "title", "label": "Title override" },
    { "type": "image_picker", "id": "image", "label": "Image override" },
    { "type": "url", "id": "link", "label": "Link override" }
  ]}],
  "presets": [{ "name": "Category carousel", "blocks": [
    {"type":"category","settings":{"title":"Great deals"}},{"type":"category","settings":{"title":"iPhone"}},{"type":"category","settings":{"title":"Android"}},
    {"type":"category","settings":{"title":"iPad"}},{"type":"category","settings":{"title":"MacBook"}},{"type":"category","settings":{"title":"Windows Laptops"}},{"type":"category","settings":{"title":"AirPods"}}
  ]}] }
{% endschema %}
