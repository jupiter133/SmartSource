<div class="ib-wrap">
  <div class="ib">
    {%- if section.settings.image != blank -%}{{ section.settings.image | image_url: width: 2400 | image_tag: class: 'ib__img', loading: 'lazy', alt: '', sizes: '100vw' }}{%- else -%}<span class="ib__img ib__img--ph" aria-hidden="true"></span>{%- endif -%}
    <div class="ib__body">
      {%- if section.settings.tag != blank -%}<span class="ib__tag">{{ section.settings.tag }}</span>{%- endif -%}
      <h2 class="ib__h">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="ib__p">{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}<a class="ib__btn" href="{{ section.settings.link }}">{{ section.settings.button_label }}</a>{%- endif -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Impact banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image", "info": "Wide photo, e.g. Earth from space. 2400×600 or larger." },
    { "type": "range", "id": "dim", "label": "Darken image", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 45 },
    { "type": "text", "id": "tag", "label": "Tag", "default": "CLEANER TECH STARTS HERE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every refurbished device keeps tech out of landfill." },
    { "type": "text", "id": "text", "label": "Text", "default": "Buy refurbished, trade in your old device, and help us keep e-waste down." },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "link", "label": "Button link" }
  ],
  "presets": [{ "name": "Impact banner" }]
}
{% endschema %}
{% style %}
#shopify-section-{{ section.id }} .ib__img{filter:brightness({{ 100 | minus: section.settings.dim }}%)}
{% endstyle %}
