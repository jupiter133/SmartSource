{%- liquid
  assign conditions = section.blocks | where: 'type', 'condition'
  assign stores = section.blocks | where: 'type', 'store'
  assign families = section.blocks | where: 'type', 'family'
  assign link_cards = section.blocks | where: 'type', 'link'

  comment
    Brand pages: lock the wizard to one buyback category (and brand), matched by name or handle, so it opens on the model grid.
    Blank = the full Device > Brand > Model flow.
  endcomment
  assign lock_cat = ''
  assign lock_brand = ''
  assign want_cat = section.settings.lock_category | downcase | strip
  assign want_brand = section.settings.lock_brand | downcase | strip
  if want_cat != blank
    for c in metaobjects.buyback_category.values limit: 50
      assign cn = c.name.value | downcase | strip
      if cn == want_cat or c.system.handle == want_cat
        assign lock_cat = c.system.handle
        break
      endif
    endfor
  endif
  if lock_cat != blank and want_brand != blank
    for b in metaobjects.buyback_brand.values limit: 50
      assign bn = b.name.value | downcase | strip
      if bn == want_brand or b.system.handle == want_brand
        assign lock_brand = b.system.handle
        break
      endif
    endfor
  endif
  assign min_step = 1
  if lock_cat != blank
    assign min_step = 2
    if lock_brand != blank
      assign min_step = 3
    endif
  endif
-%}
<section class="section page-width sell-wiz{% if min_step > 1 %} is-locked{% endif %}" id="sell-quote" data-sell-wizard data-section-id="{{ section.id }}">
  {%- if section.settings.heading != blank -%}
  <div class="sell-wiz__head">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow-grad">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.intro != blank -%}<p class="muted">{% render 'sell-text', text: section.settings.intro %}</p>{%- endif -%}
  </div>
  {%- else -%}
  <h2 class="visually-hidden">Get your instant offer</h2>
  {%- endif -%}

  <nav class="wiz-progress" aria-label="Quote steps" data-progress style="--wiz-steps: {{ 7 | minus: min_step }}">
    <ol role="list">
      {%- if families.size > 0 and min_step == 1 -%}
        {%- assign labels = 'Brand,Device,Model,Storage,Condition,Details' | split: ',' -%}
      {%- else -%}
        {%- assign labels = 'Device,Brand,Model,Storage,Condition,Details' | split: ',' -%}
      {%- endif -%}
      {%- for label in labels -%}
        <li{% if forloop.index < min_step %} hidden{% endif %}>
          <button type="button" class="wiz-progress__btn" data-goto="{{ forloop.index }}" disabled>
            <span class="wiz-progress__num" aria-hidden="true">{{ forloop.index | minus: min_step | plus: 1 | at_least: 1 }}</span>
            <span class="wiz-progress__label">{{ label }}</span>
          </button>
        </li>
      {%- endfor -%}
    </ol>
    <div class="wiz-progress__bar" aria-hidden="true"><span data-progress-fill></span></div>
  </nav>

  <div class="wiz-layout">
    <div class="wiz-main" data-wiz-main>
      <div class="wiz-step" data-step="1" role="group" aria-labelledby="WizStep1-{{ section.id }}"{% if min_step > 1 %} hidden{% endif %}>
        <h3 class="wiz-step__title" id="WizStep1-{{ section.id }}" tabindex="-1">What are you selling?</h3>
        <div class="wiz-search">
          <label class="visually-hidden" for="WizSearch-{{ section.id }}">Search for your device</label>
          <div class="wiz-search__box">
            {% render 'icon', name: 'search' %}
            <input id="WizSearch-{{ section.id }}" type="search" placeholder="{{ section.settings.search_placeholder | escape }}" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="WizSearchList-{{ section.id }}" data-wiz-search>
          </div>
          <ul class="sell-search__list" id="WizSearchList-{{ section.id }}" role="listbox" aria-label="Matching devices" hidden data-wiz-search-list></ul>
        </div>
        {%- unless families.size > 0 -%}<p class="wiz-or"><span>or pick a category</span></p>{%- endunless -%}
        <fieldset class="wiz-fieldset"><legend class="visually-hidden">Category</legend><div class="wiz-cards wiz-cards--cats" data-options="1"></div></fieldset>
      </div>

      <div class="wiz-step" data-step="2" role="group" aria-labelledby="WizStep2-{{ section.id }}" hidden>
        <h3 class="wiz-step__title" id="WizStep2-{{ section.id }}" tabindex="-1">{% if families.size > 0 %}Select device type{% else %}Select brand{% endif %}</h3>
        <fieldset class="wiz-fieldset"><legend class="visually-hidden">Brand</legend><div class="wiz-cards wiz-cards--brands" data-options="2"></div></fieldset>
      </div>

      <div class="wiz-step" data-step="3" role="group" aria-labelledby="WizStep3-{{ section.id }}"{% if min_step != 3 %} hidden{% endif %}>
        <h3 class="wiz-step__title" id="WizStep3-{{ section.id }}" tabindex="-1">{{ section.settings.model_title | default: 'Select model' }}</h3>
        {%- if section.settings.model_extras -%}
          <div class="wiz-search wiz-search--models" data-model-search hidden>
            <label class="visually-hidden" for="WizModelSearch-{{ section.id }}">{{ section.settings.model_search_placeholder | default: 'Find your device' }}</label>
            <div class="wiz-search__box">
              {% render 'icon', name: 'search' %}
              <input id="WizModelSearch-{{ section.id }}" type="search" placeholder="{{ section.settings.model_search_placeholder | default: 'Find your device' | escape }}" autocomplete="off" aria-controls="WizModels-{{ section.id }}">
            </div>
          </div>
        {%- endif -%}
        <fieldset class="wiz-fieldset"><legend class="visually-hidden">Model</legend><div class="wiz-cards wiz-cards--models" id="WizModels-{{ section.id }}" data-options="3"></div></fieldset>
        <p class="visually-hidden" aria-live="polite" data-model-status></p>
      </div>

      <div class="wiz-step" data-step="4" role="group" aria-labelledby="WizStep4-{{ section.id }}" hidden>
        <h3 class="wiz-step__title" id="WizStep4-{{ section.id }}" tabindex="-1">Storage</h3>
        <p class="wiz-step__sub" data-step-sub="4"></p>
        <fieldset class="wiz-fieldset"><legend class="visually-hidden">Storage</legend><div class="wiz-cards wiz-cards--storage" data-options="4"></div></fieldset>
      </div>

      <div class="wiz-step" data-step="5" role="group" aria-labelledby="WizStep5-{{ section.id }}" hidden>
        <h3 class="wiz-step__title" id="WizStep5-{{ section.id }}" tabindex="-1">Condition</h3>
        <p class="wiz-step__sub">Be honest. We check every device, and an accurate pick means no surprises.</p>
        <fieldset class="wiz-fieldset"><legend class="visually-hidden">Condition</legend><div class="wiz-conds" data-options="5"></div></fieldset>
        {%- if section.settings.show_value_chart -%}<div class="wiz-chart" data-wiz-chart hidden></div>{%- endif -%}
      </div>

      {%- form 'contact', id: 'SellWizardForm', class: 'wiz-form', data-wiz-form: '' -%}
        {%- if form.posted_successfully? -%}
          <div class="wiz-step wiz-done" data-step="7" data-posted role="group" aria-labelledby="WizDone-{{ section.id }}">
            <span class="wiz-done__icon">{% render 'icon', name: 'check' %}</span>
            <h3 class="wiz-step__title" id="WizDone-{{ section.id }}" tabindex="-1">{{ section.settings.success_heading }}</h3>
            <p class="wiz-done__ref" data-done-ref hidden>Your quote reference is <strong></strong></p>
            <ul class="wiz-done__items" role="list" data-done-items></ul>
            <p class="wiz-done__total" data-done-total hidden><span>Total</span><strong></strong></p>
            <p class="wiz-done__expiry" data-done-expiry hidden>Ship or drop off by <strong></strong>.</p>
            <h4>What happens next</h4>
            <div class="rte wiz-done__next">{% render 'sell-text', text: section.settings.next_steps %}</div>
            <button type="button" class="btn" data-restart>Start another quote</button>
          </div>
        {%- else -%}
          <div class="wiz-step" data-step="6" role="group" aria-labelledby="WizStep6-{{ section.id }}" hidden>
            <h3 class="wiz-step__title" id="WizStep6-{{ section.id }}" tabindex="-1">Your details</h3>
            {%- if form.errors -%}<div class="wiz-errors" role="alert" data-form-errors>{{ form.errors | default_errors }}</div>{%- endif -%}
            <div class="wiz-fields">
              <label class="field"><span>Full name</span><input type="text" name="contact[name]" autocomplete="name" required data-detail="name"></label>
              <label class="field"><span>Email</span><input type="email" name="contact[email]" autocomplete="email" required data-detail="email"></label>
              <label class="field field--full"><span>Phone <small class="muted">(optional)</small></span><input type="tel" name="contact[phone]" autocomplete="tel" data-detail="phone"></label>
            </div>
            <fieldset class="wiz-fieldset wiz-method">
              <legend>How will you send it?</legend>
              <div class="wiz-cards wiz-cards--method">
                <label class="wiz-card wiz-card--method">
                  <input type="radio" name="wiz-method" value="ship" data-detail="method">
                  <span class="wiz-card__check" aria-hidden="true">{% render 'icon', name: 'check' %}</span>
                  <span class="wiz-card__icon">{% render 'icon', name: 'truck' %}</span>
                  <span class="wiz-card__name">Ship it: free label</span>
                  <span class="wiz-card__meta">We email you a prepaid shipping label.</span>
                </label>
                <label class="wiz-card wiz-card--method">
                  <input type="radio" name="wiz-method" value="dropoff" data-detail="method">
                  <span class="wiz-card__check" aria-hidden="true">{% render 'icon', name: 'check' %}</span>
                  <span class="wiz-card__icon">{% render 'icon', name: 'store' %}</span>
                  <span class="wiz-card__name">Drop off in store</span>
                  <span class="wiz-card__meta">{% if settings.instore_instant_pay %}Get paid on the spot.{% else %}Bring it to any of our stores.{% endif %}</span>
                </label>
              </div>
            </fieldset>
            <label class="field field--full wiz-store" data-store-field hidden>
              <span>Which store?</span>
              <select name="wiz-store" data-detail="store">
                <option value="">Choose a store</option>
                {%- for store in stores -%}
                  <option value="{{ store.settings.name | escape }}">{{ store.settings.name }}{% if store.settings.address != blank %} · {{ store.settings.address }}{% endif %}</option>
                {%- endfor -%}
              </select>
            </label>
            <fieldset class="wiz-fieldset wiz-proof" data-proof>
              <legend>Proof of purchase <small class="muted">(optional)</small></legend>
              <p class="wiz-proof__rec" data-proof-rec hidden>Recommended for brand new / sealed devices.</p>
              <div class="wiz-cards wiz-cards--method wiz-cards--proof">
                <label class="wiz-card wiz-card--method wiz-card--proof">
                  <input type="radio" name="wiz-proof" value="yes" data-detail="proof">
                  <span class="wiz-card__check" aria-hidden="true"></span>
                  <span class="wiz-card__name">I have a receipt or invoice</span>
                </label>
                <label class="wiz-card wiz-card--method wiz-card--proof">
                  <input type="radio" name="wiz-proof" value="no" data-detail="proof">
                  <span class="wiz-card__check" aria-hidden="true"></span>
                  <span class="wiz-card__name">I don't have one</span>
                </label>
              </div>
              <div class="wiz-proof__more" data-proof-more hidden>
                <div class="wiz-drop" data-proof-drop>
                  {%- comment -%} No name attribute: the contact form can't carry files, so the file is never submitted. {%- endcomment -%}
                  <input type="file" id="WizProofFile-{{ section.id }}" class="wiz-drop__input visually-hidden" accept="image/*,application/pdf" aria-describedby="WizProofHelp-{{ section.id }}" data-proof-file>
                  <label class="wiz-drop__zone" for="WizProofFile-{{ section.id }}">
                    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8z"/><path d="M14 3v5h5M12 17v-6M9.5 13.5L12 11l2.5 2.5"/></svg>
                    <span><strong>Add a photo or PDF of your receipt</strong><small>Tap to choose a file, or drop it here</small></span>
                  </label>
                  <div class="wiz-drop__file" data-proof-chosen hidden>
                    <img class="wiz-drop__thumb" data-proof-thumb alt="" width="48" height="48" hidden>
                    <span class="wiz-drop__name" data-proof-name></span>
                    <button type="button" class="wiz-drop__clear" data-proof-clear>Remove</button>
                  </div>
                  <p class="wiz-drop__help" id="WizProofHelp-{{ section.id }}">We'll email you to collect it after you submit, so keep it handy. Files aren't sent with this form.</p>
                </div>
                <div class="wiz-fields wiz-fields--proof">
                  <label class="field"><span>Where did you buy it? <small class="muted">(optional)</small></span><input type="text" autocomplete="off" placeholder="Store or retailer" data-detail="purchased_from"></label>
                  <label class="field"><span>Purchase date <small class="muted">(optional)</small></span><input type="date" data-detail="purchase_date"></label>
                </div>
              </div>
            </fieldset>
            <p class="wiz-fine muted">{% render 'sell-text', text: section.settings.fine_print %}</p>
            <div data-hidden-fields></div>
          </div>
        {%- endif -%}
      {%- endform -%}
      <noscript><p class="wiz-noscript">The quote tool needs JavaScript. Please turn it on, or visit one of our stores for a quote.</p></noscript>
    </div>

    <aside class="wiz-summary" aria-label="Your quote" data-summary>
      <div class="wiz-sum">
        <div class="wiz-sum__device">
          <span class="wiz-sum__img" data-sum-img></span>
          <div>
            <strong data-sum-name>Pick your device</strong>
            <span class="wiz-sum__meta" data-sum-meta>Your offer updates as you go.</span>
          </div>
        </div>
        <dl class="wiz-sum__rows" data-sum-rows hidden></dl>
        <p class="wiz-sum__note" data-sum-note hidden></p>
        <div class="wiz-sum__pay">
          <span>{{ section.settings.pay_label }}</span>
          <strong data-sum-total aria-live="polite" aria-atomic="true">$0</strong>
        </div>
        <div class="wiz-sum__list" data-sum-list hidden>
          <p class="wiz-sum__list-title">Devices in this quote</p>
          <ul role="list" data-sum-items></ul>
        </div>
        {%- if section.settings.guarantee_title != blank -%}
          <div class="wiz-sum__guarantee">
            <span class="wiz-sum__guarantee-icon" aria-hidden="true"></span>
            <div>
              <strong>{{ section.settings.guarantee_title }}</strong>
              <p>{% render 'sell-text', text: section.settings.guarantee_text %}</p>
            </div>
          </div>
        {%- endif -%}
      </div>
      <div class="wiz-bar" data-bar>
        <div class="wiz-bar__pay" aria-hidden="true"><span>{{ section.settings.pay_label }}</span><strong data-bar-total>$0</strong></div>
        <div class="wiz-bar__btns">
          <button type="button" class="btn wiz-bar__prev" data-wiz-prev>Previous</button>
          <button type="button" class="btn btn--dark wiz-bar__next" data-wiz-next disabled>Next</button>
          <button type="button" class="btn btn--dark wiz-bar__next" data-getpaid hidden>Next</button>
          <button type="button" class="btn wiz-bar__add" data-addanother hidden><span class="wiz-long">Accept &amp; add another device</span><span class="wiz-short">+ Add another</span></button>
        </div>
      </div>
    </aside>
  </div>

  {%- comment -%} Catalog for the wizard. Categories and brands: up to 50 each. Devices: up to 250, each with its own Prices list. {%- endcomment -%}
  {% render 'sell-catalog' %}
  <script type="application/json" data-sell-config>
    {
      "live": {{ settings.sell_live | json }},
      "quoteDays": {{ settings.quote_valid_days | json }},
      "payDays": {{ settings.payment_business_days | json }},
      "freeReturn": {{ settings.free_return_on_decline | json }},
      "instorePay": {{ settings.instore_instant_pay | json }},
      "lock": {% if lock_cat != blank %}{"cat":{{ lock_cat | json }},"brand":{% if lock_brand != blank %}{{ lock_brand | json }}{% else %}null{% endif %}}{% else %}null{% endif %},
      "modelExtras": {{ section.settings.model_extras | json }},
      "modelBatch": {{ section.settings.model_batch | default: 11 | json }},
      "families": [
        {%- assign fsep = false -%}
        {%- for block in families -%}
          {%- liquid
            assign fc = ''
            assign fb = ''
            assign want = block.settings.category | downcase | strip
            for c in metaobjects.buyback_category.values limit: 50
              assign cn = c.name.value | downcase | strip
              if cn == want or c.system.handle == want
                assign fc = c.system.handle
                break
              endif
            endfor
            assign want = block.settings.brand | downcase | strip
            if want != blank
              for b in metaobjects.buyback_brand.values limit: 50
                assign bn = b.name.value | downcase | strip
                if bn == want or b.system.handle == want
                  assign fb = b.system.handle
                  break
                endif
              endfor
            endif
          -%}
          {%- if fc != blank -%}
            {%- if fsep -%},{%- endif -%}{%- assign fsep = true -%}
            {"id":{{ block.id | json }},"n":{{ block.settings.label | json }},"cat":{{ fc | json }},"brand":{% if fb != blank %}{{ fb | json }}{% else %}null{% endif %},"match":{{ block.settings.match | json }},"dev":{{ block.settings.image_device | strip | json }},"i":{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 400 | json }}{% else %}null{% endif %}}
          {%- endif -%}
        {%- endfor -%}
      ],
      "brandLogos": {
        {%- assign logo_brands = 'apple,google,microsoft,nintendo,samsung,sony' | split: ',' -%}
        {%- for lb in logo_brands -%}{{ lb | json }}:{{ 'logo-brand-' | append: lb | append: '.svg' | asset_url | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}
      },
      "working": {
        "title": {{ section.settings.working_title | json }},
        "sub": {{ section.settings.working_sub | json }},
        "items": [
          {%- assign wlines = section.settings.working_checklist | newline_to_br | split: '<br />' -%}
          {%- assign wsep = false -%}
          {%- for line in wlines -%}{%- assign item = line | strip -%}{%- if item != blank -%}{%- if wsep -%},{%- endif -%}{%- assign wsep = true -%}{{ item | json }}{%- endif -%}{%- endfor -%}
        ],
        "note": {{ section.settings.working_note | json }}
      },
      "chart": {% if section.settings.show_value_chart %}{"f": [{{ settings.sell_value_1m | default: 97 | json }}, {{ settings.sell_value_3m | default: 91 | json }}, {{ settings.sell_value_6m | default: 83 | json }}]}{% else %}null{% endif %},
      "links": [
        {%- for block in link_cards -%}
          {"n":{{ block.settings.label | json }},"t":{{ block.settings.text | json }},"u":{{ block.settings.url | json }},"i":{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 400 | json }}{% else %}null{% endif %}}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ],
      "conditions": [
        {%- for block in conditions -%}
          {%- assign lines = block.settings.checklist | newline_to_br | split: '<br />' -%}
          {"key":{{ block.settings.key | json }},"title":{{ block.settings.title | json }},"summary":{{ block.settings.summary | json }},"checklist":[
            {%- assign lsep = false -%}
            {%- for line in lines -%}{%- assign item = line | strip -%}{%- if item != blank -%}{%- if lsep -%},{%- endif -%}{%- assign lsep = true -%}{{ item | json }}{%- endif -%}{%- endfor -%}
          ]}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
</section>

<script src="{{ 'sell-chart.js' | asset_url }}" defer></script>
<script src="{{ 'sell-wizard.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Sell: quote wizard",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "INSTANT QUOTE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get your instant offer" },
    { "type": "text", "id": "intro", "label": "Intro", "default": "Five quick questions. Your quote is locked in for {quote_valid_days} days." },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search your model, e.g. iPhone 15 Pro" },
    { "type": "text", "id": "pay_label", "label": "Price label", "default": "You'll get paid" },
    { "type": "header", "content": "Brand page (lock to one device type)" },
    { "type": "paragraph", "content": "Leave both blank on the main sell page. Filled in, the wizard skips the Device and Brand steps and opens on that brand's models." },
    { "type": "text", "id": "lock_category", "label": "Category name", "info": "Must match a buyback category name, e.g. Smartphone, Tablet, Smartwatch." },
    { "type": "text", "id": "lock_brand", "label": "Brand name", "info": "Must match a buyback brand name, e.g. Apple, Samsung, Google." },
    { "type": "text", "id": "model_title", "label": "Model step heading", "placeholder": "Select model" },
    { "type": "checkbox", "id": "model_extras", "label": "Model step: show \"Get up to\" prices, a search box and Load more", "default": false, "info": "Models are listed most valuable first." },
    { "type": "text", "id": "model_search_placeholder", "label": "Model search placeholder", "default": "Find your device" },
    { "type": "number", "id": "model_batch", "label": "Models shown before Load more", "default": 11 },
    { "type": "header", "content": "\"Is it fully working?\" question" },
    { "type": "paragraph", "content": "Asked before the condition cards. Yes shows the conditions (without Defective); No prices the device as Defective." },
    { "type": "text", "id": "working_title", "label": "Heading", "default": "Is it fully working?" },
    { "type": "text", "id": "working_sub", "label": "Line under the heading", "default": "Check everything below before you answer." },
    { "type": "textarea", "id": "working_checklist", "label": "Checklist (one item per line)", "default": "It turns on and off and charges, and the battery, back cover and SIM tray are all there.\nFront and rear cameras work properly.\nSpeakers and microphones work properly.\nFace ID, Touch ID or the fingerprint sensor works, if it has one.\nEverything else works too: Wi-Fi, Bluetooth, buttons and the touchscreen." },
    { "type": "textarea", "id": "working_note", "label": "Important note", "default": "Important: sign out of iCloud, Google and any other accounts and remove them, working or not. We can't accept bent or water-damaged devices." },
    { "type": "header", "content": "Value over time chart" },
    { "type": "checkbox", "id": "show_value_chart", "label": "Show the estimated value chart on the condition step", "default": true, "info": "Uses the estimate percentages in Theme settings > Sell program." },
    { "type": "header", "content": "Guarantee card" },
    { "type": "text", "id": "guarantee_title", "label": "Title", "default": "Price Promise" },
    { "type": "textarea", "id": "guarantee_text", "label": "Text", "default": "Your quote is locked in for {quote_valid_days} days.[if_free_return] If inspection finds a different condition, accept the revised offer or get your device back free.[/if_free_return]" },
    { "type": "header", "content": "Details and confirmation" },
    { "type": "textarea", "id": "fine_print", "label": "Fine print under the form", "default": "Ship or drop off within {quote_valid_days} days of your quote. We pay within {payment_business_days} business days of receiving your device." },
    { "type": "text", "id": "success_heading", "label": "Confirmation heading", "default": "You're all set. Your quote is locked in." },
