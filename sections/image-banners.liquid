<section class="section page-width image-banners">
  {%- for block in section.blocks -%}
    {%- capture img_pos -%}object-position: {{ block.settings.focus_x }}% {{ block.settings.focus_y }}%{%- endcapture -%}
    <div class="image-banner{% if block.settings.image == blank and block.settings.asset_image == blank %} image-banner--art{% endif %}" style="--ib-bg: {{ block.settings.bg }}" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}
        {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'image-banner__img', sizes: '(min-width: 750px) 50vw, 100vw', alt: '', style: img_pos }}
      {%- elsif block.settings.asset_image != blank -%}
        <img class="image-banner__img" src="{{ block.settings.asset_image | asset_url }}" alt="" width="1200" height="1200" loading="lazy" style="{{ img_pos }}">
      {%- else -%}
        <div class="image-banner__art">{% render 'device-art', kind: block.settings.art, title: block.settings.heading, section: section, idx: forloop.index %}</div>
      {%- endif -%}
      <div class="image-banner__text">
        <h3>{{ block.settings.heading }}</h3>
        {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
        {%- if block.settings.button_label != blank -%}<a class="btn btn--light btn--sm" href="{{ block.settings.link }}">{{ block.settings.button_label }}</a>{%- endif -%}
      </div>
    </div>
  {%- endfor -%}
</section>
{% schema %}
{ "name": "Image banners", "max_blocks": 2,
  "blocks": [{ "type": "banner", "name": "Banner", "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Lifestyle photo, portrait or square. Text sits on the bottom-left, so keep that area dark." },
    { "type": "text", "id": "asset_image", "label": "Theme asset image (advanced)", "info": "Filename in the theme's assets folder. Used only if no image is picked above." },
    { "type": "range", "id": "focus_x", "label": "Image focus (left to right)", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "range", "id": "focus_y", "label": "Image focus (top to bottom)", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Game night, for less." },
    { "type": "text", "id": "text", "label": "Text", "default": "PS5 and Switch, refurbished and tested." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Shop gaming" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "select", "id": "art", "label": "Illustration (when no image)", "options": [
      {"value":"console","label":"Console"},{"value":"laptop","label":"Laptop"},{"value":"phone","label":"Phone"},{"value":"tablet","label":"Tablet"},{"value":"watch","label":"Watch"},{"value":"hero","label":"Device lineup"}
    ], "default": "console" },
    { "type": "color", "id": "bg", "label": "Background (when no image)", "default": "#14213D" }
  ]}],
  "presets": [{ "name": "Image banners", "blocks": [
    { "type": "banner", "settings": { "heading": "Game night, for less.", "text": "PS5 and Switch, refurbished and tested.", "button_label": "Shop gaming", "link": "/collections/all/consoles", "art": "console", "bg": "#14213D" } },
    { "type": "banner", "settings": { "heading": "Back to school, under budget.", "text": "MacBooks and iPads that won't wreck your wallet.", "button_label": "Shop laptops", "link": "/collections/all/macbook", "art": "laptop", "bg": "#3A1C3F" } }
  ]}] }
{% endschema %}
