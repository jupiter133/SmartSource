<section class="section page-width promo-cards">
  {%- for block in section.blocks -%}
    <div class="promo-card" {{ block.shopify_attributes }}>
      <div class="promo-card__img">
        {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy' }}{%- else -%}{{ 'product-2' | placeholder_svg_tag }}{%- endif -%}
      </div>
      <h3>{{ block.settings.heading }}</h3>
      <p>{{ block.settings.text }}</p>
      {%- if block.settings.button_label != blank -%}<a class="btn btn--dark btn--sm" href="{{ block.settings.link }}">{{ block.settings.button_label }}</a>{%- endif -%}
    </div>
  {%- endfor -%}
</section>
{% schema %}
{ "name": "Promo cards", "max_blocks": 3,
  "blocks": [{ "type": "card", "name": "Card", "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your kids will drop it. Pay less." },
    { "type": "text", "id": "text", "label": "Text", "default": "The iPhone 15, refurbished, for way less than new." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Save now" },
    { "type": "url", "id": "link", "label": "Link" }
  ]}],
  "presets": [{ "name": "Promo cards", "blocks": [{"type":"card"},{"type":"card","settings":{"heading":"Call your mom, on a budget.","text":"Bundle your phone with a mobile plan at an exclusive price.","button_label":"Learn more"}}] }] }
{% endschema %}
