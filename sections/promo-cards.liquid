<section class="section page-width promo-cards{% unless section.settings.overlap %} promo-cards--flat{% endunless %}">
  {%- for block in section.blocks -%}
    {%- liquid
      assign h = block.settings.heading
      assign tx = block.settings.text
      assign bl = block.settings.button_label
      assign lnk = block.settings.link
      assign aimg = block.settings.asset_image
      assign photo = false
      if h == 'Flagship camera. Mid-range price.' and block.settings.image == blank
        assign h = 'Cases that keep it looking new.'
        assign tx = 'Clear and frosted MagSafe cases for every iPhone.'
        assign bl = 'Shop cases'
        assign lnk = '/collections/all/cases'
        assign aimg = 'promo-cases.webp'
        assign photo = true
      endif
      if aimg == 'promo-cases.webp'
        assign photo = true
      endif
    -%}
    <div class="promo-card{% if photo %} promo-card--photo{% endif %}" {{ block.shopify_attributes }}>
      <div class="promo-card__img">
        {%- liquid
          assign fp = block.settings.product
          if fp == blank and photo == false
            assign lk = lnk | downcase
            if lk contains 'samsung'
              assign fp = all_products['samsung-galaxy-s25']
            elsif lk contains 'ipad'
              assign fp = all_products['ipad-air-11-inch-m2']
            endif
          endif
        -%}
        {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.heading }}{%- elsif photo == false and fp.featured_image -%}{{ fp.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.heading, class: 'promo-card__product' }}{%- elsif aimg != blank -%}<img src="{{ aimg | asset_url }}" alt="{{ h | escape }}" width="900" height="660" loading="lazy">{%- else -%}{% render 'device-art', kind: block.settings.art, title: block.settings.heading, section: section, idx: forloop.index %}{%- endif -%}
      </div>
      <h3>{{ h }}</h3>
      <p>{{ tx }}</p>
      {%- if bl != blank -%}<a class="btn btn--dark btn--sm" href="{{ lnk }}">{{ bl }}</a>{%- endif -%}
    </div>
  {%- endfor -%}
</section>
{% schema %}
{ "name": "Promo cards", "max_blocks": 3,
  "settings": [{ "type": "checkbox", "id": "overlap", "label": "Tuck up into the section above", "default": true, "info": "Turn off when this isn't right under a banner." }],
  "blocks": [{ "type": "card", "name": "Card", "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "product", "id": "product", "label": "Product (uses its photo)" },
    { "type": "text", "id": "asset_image", "label": "Theme asset image (advanced)", "info": "Filename in the theme's assets folder. Used only if no image is picked above." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your kids will drop it. Pay less." },
    { "type": "text", "id": "text", "label": "Text", "default": "The iPhone 15, refurbished, for way less than new." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Save now" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "select", "id": "art", "label": "Illustration (when no image)", "options": [{"value":"phone","label":"Phone"},{"value":"tablet","label":"Tablet"},{"value":"laptop","label":"Laptop"},{"value":"console","label":"Console"},{"value":"watch","label":"Watch"},{"value":"audio","label":"Audio"}], "default": "phone" }
  ]}],
  "presets": [{ "name": "Promo cards", "blocks": [{"type":"card"},{"type":"card","settings":{"heading":"Call your mom, on a budget.","text":"Bundle your phone with a mobile plan at an exclusive price.","button_label":"Learn more"}}] }] }
{% endschema %}
