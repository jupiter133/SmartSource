<section class="section page-width subcat subcat--{{ section.settings.style }}">
  {%- if section.settings.heading != blank -%}
    <div class="subcat__head">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="muted">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
  {%- endif -%}
  <div class="subcat__grid">
    {%- for block in section.blocks -%}
      <a class="subcat-tile" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
        <span class="subcat-tile__img" style="--tile-bg: {{ section.settings.tile_bg }}">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 400px, 50vw', alt: block.settings.title }}
          {%- elsif block.settings.asset_image != blank -%}
            <img src="{{ block.settings.asset_image | asset_url }}" alt="{{ block.settings.title | escape }}" width="800" height="600" loading="lazy">
          {%- else -%}
            {% render 'device-art', kind: block.settings.art, title: block.settings.title, section: section, idx: forloop.index %}
          {%- endif -%}
        </span>
        <span class="subcat-tile__title">{{ block.settings.title }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>
{%- liquid
  assign lx_tag = ''
  case page.handle
    when 'android'
      assign lx_tag = 'android'
      assign lx_label = 'Android phones'
    when 'laptops'
      assign lx_tag = 'laptops'
      assign lx_label = 'laptops'
    when 'audio'
      assign lx_tag = 'audio'
      assign lx_label = 'audio'
  endcase
-%}
{%- if lx_tag != blank -%}{% render 'landing-extras', tag: lx_tag, label: lx_label %}{%- endif -%}
{% schema %}
{ "name": "Landing: category tiles", "settings": [
  { "type": "text", "id": "heading", "label": "Heading", "default": "Shop laptops and more" },
  { "type": "text", "id": "subheading", "label": "Subheading", "default": "Tested and perfected to the core" },
  { "type": "select", "id": "style", "label": "Style", "options": [{"value":"big","label":"Big tiles"},{"value":"compact","label":"Compact cards"}], "default": "big" },
  { "type": "color", "id": "tile_bg", "label": "Tile background", "default": "#DDF4FA" }
], "blocks": [{ "type": "tile", "name": "Tile", "settings": [
  { "type": "text", "id": "title", "label": "Title", "default": "MacBooks" },
  { "type": "url", "id": "link", "label": "Link" },
  { "type": "image_picker", "id": "image", "label": "Image", "info": "Transparent PNG works best." },
  { "type": "text", "id": "asset_image", "label": "Theme asset image (advanced)" },
  { "type": "select", "id": "art", "label": "Illustration (when no image)", "options": [{"value":"phone","label":"Phone"},{"value":"laptop","label":"Laptop"},{"value":"tablet","label":"Tablet"},{"value":"console","label":"Console"},{"value":"watch","label":"Watch"},{"value":"audio","label":"Audio"},{"value":"case","label":"Case"},{"value":"cable","label":"Cable"},{"value":"protector","label":"Screen protector"}], "default": "laptop" }
]}], "presets": [{ "name": "Landing: category tiles" }] }
{% endschema %}
