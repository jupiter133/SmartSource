<section class="section page-width why-grades">
  <div class="why-head">
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="muted">{{ section.settings.text }}</p>{%- endif -%}
  </div>
  <div class="why-grades__grid">
    {%- for block in section.blocks -%}
      <div class="why-grade{% if block.settings.featured %} is-featured{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.featured -%}<span class="why-grade__tag">Most popular</span>{%- endif -%}
        <h3>{{ block.settings.name }}</h3>
        <p>{%- if block.settings.text != blank -%}{{ block.settings.text }}{%- else -%}{% render 'grade-desc', grade: block.settings.name %}{%- endif -%}</p>
      </div>
    {%- endfor -%}
  </div>
  {%- if section.settings.button_label != blank -%}
    <div class="why-grades__foot"><a class="btn btn--dark" href="{{ section.settings.button_link | default: '/collections/all' }}">{{ section.settings.button_label }} →</a></div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Why refurbished: grades",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick your grade. They all work like new." },
    { "type": "text", "id": "text", "label": "Text", "default": "Grades only describe how the device looks. Function, testing and warranty are the same across all of them." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Shop all devices" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "grade", "name": "Grade", "settings": [
      { "type": "text", "id": "name", "label": "Grade name", "default": "Excellent" },
      { "type": "text", "id": "text", "label": "Description", "info": "Leave blank to use the theme's standard description for this grade." },
      { "type": "checkbox", "id": "featured", "label": "Highlight", "default": false }
    ] }
  ],
  "presets": [{ "name": "Why refurbished: grades", "blocks": [
    { "type": "grade", "settings": { "name": "Premium" } },
    { "type": "grade", "settings": { "name": "Excellent", "featured": true } },
    { "type": "grade", "settings": { "name": "Good" } },
    { "type": "grade", "settings": { "name": "Fair" } }
  ] }]
}
{% endschema %}
