{%- if section.blocks.size > 0 or request.design_mode -%}
<section class="section page-width" data-carousel>
  <div class="section__head">
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.blocks.size > 0 -%}{% render 'carousel-arrows' %}{%- endif -%}
  </div>
  {%- if section.blocks.size == 0 -%}
    <p class="review-empty">Add real customer reviews here: click "Add review" in the theme editor. This section stays hidden on your store until it has at least one review.</p>
  {%- else -%}
  <div class="carousel review-row" data-track>
    {%- for block in section.blocks -%}
      <article class="review-card" {{ block.shopify_attributes }}>
        <div class="review-card__photo">
          {%- if block.settings.photo != blank -%}{{ block.settings.photo | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '340px', alt: '' }}{%- endif -%}
          <span class="review-card__name">{{ block.settings.name }}</span>
          <div class="review-card__body">
            <p class="review-card__text">{{ block.settings.text }}</p>
            <p class="review-card__stars" aria-label="{{ block.settings.rating }} out of 5 stars"><span aria-hidden="true">{% for i in (1..5) %}{% if i <= block.settings.rating %}★{% else %}☆{% endif %}{% endfor %}</span> {{ block.settings.rating }}/5</p>
          </div>
        </div>
        {%- if block.settings.product_title != blank -%}
          <a class="review-card__product" href="{{ block.settings.product_link | default: '#' }}">
            {%- if block.settings.product_image != blank -%}{{ block.settings.product_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
            <span>{{ block.settings.product_title }}</span>
          </a>
        {%- endif -%}
      </article>
    {%- endfor -%}
  </div>
  {%- endif -%}
</section>
{%- endif -%}
{% schema %}
{ "name": "Customer reviews", "settings": [
  { "type": "text", "id": "heading", "label": "Heading", "default": "What our customers say" },
  { "type": "paragraph", "content": "Only add genuine reviews from real customers, with their permission. The section is hidden until it has at least one review." }
], "blocks": [{ "type": "review", "name": "Review", "settings": [
  { "type": "image_picker", "id": "photo", "label": "Customer photo of the device" },
  { "type": "text", "id": "name", "label": "Customer name (first name + initial)", "default": "Jordan P." },
  { "type": "textarea", "id": "text", "label": "Review" },
  { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
  { "type": "text", "id": "product_title", "label": "Product bought", "info": "e.g. iPhone 13 128GB, Blue" },
  { "type": "image_picker", "id": "product_image", "label": "Product image" },
  { "type": "url", "id": "product_link", "label": "Product link" }
]}], "presets": [{ "name": "Customer reviews" }] }
{% endschema %}
