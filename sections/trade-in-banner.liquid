{%- liquid
  assign trade_url = section.settings.trade_link | default: '/pages/sell-your-device#sell-quote'
  assign new_price = section.settings.example_new | default: 0
  assign trade_value = section.settings.example_trade | default: 0
  assign you_pay = new_price | minus: trade_value
  if you_pay < 0
    assign you_pay = 0
  endif
-%}
<section class="section page-width trade-banner">
  <div class="trade-banner__card">
    <div class="trade-banner__copy">
      {%- if section.settings.show_bonus and section.settings.bonus_text != blank -%}
        <p class="trade-banner__bonus">{{ section.settings.bonus_text }}</p>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="trade-banner__text">{% render 'sell-text', text: section.settings.text %}</div>{%- endif -%}
      <ol class="trade-banner__flow" role="list">
        {%- for i in (1..3) -%}
          {%- assign key = 'step_' | append: i -%}
          {%- if section.settings[key] != blank -%}
            <li><span class="trade-banner__num" aria-hidden="true">{{ i }}</span>{{ section.settings[key] }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
      <div class="trade-banner__ctas">
        {%- if section.settings.cta_label != blank -%}
          <a class="btn btn--accent btn--lg" href="{{ trade_url }}"{% if section.settings.trade_link == blank %} data-sell-start{% endif %}>{{ section.settings.cta_label }}</a>
        {%- endif -%}
        {%- if section.settings.shop_label != blank -%}
          <a class="btn btn--lg trade-banner__shop" href="{{ section.settings.shop_link | default: routes.all_products_collection_url }}">{{ section.settings.shop_label }}</a>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.show_example and new_price > 0 -%}
      <div class="trade-calc" aria-label="Example trade-in">
        <p class="trade-calc__label">{{ section.settings.example_label }}</p>
        <div class="trade-calc__row"><span>New phone</span><strong>{{ new_price | times: 100 | money_without_trailing_zeros }}</strong></div>
        <div class="trade-calc__row trade-calc__row--minus"><span>Trade-in</span><strong>&minus;{{ trade_value | times: 100 | money_without_trailing_zeros }}</strong></div>
        <div class="trade-calc__row trade-calc__row--total"><span>You pay</span><strong>{{ you_pay | times: 100 | money_without_trailing_zeros }}</strong></div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Trade-in banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Trade in. Trade up." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Put your device's value toward any phone in our store, in person or as store credit online.</p>" },
    { "type": "text", "id": "step_1", "label": "Step 1", "default": "Get your value" },
    { "type": "text", "id": "step_2", "label": "Step 2", "default": "Pick your new phone" },
    { "type": "text", "id": "step_3", "label": "Step 3", "default": "Pay the difference" },
    { "type": "text", "id": "cta_label", "label": "Main button", "default": "Get trade-in value" },
    { "type": "url", "id": "trade_link", "label": "Main button link", "info": "Leave blank to open the quote wizard on this page, or /pages/sell-your-device if there's none." },
    { "type": "text", "id": "shop_label", "label": "Second button", "default": "Shop phones" },
    { "type": "url", "id": "shop_link", "label": "Second button link" },
    { "type": "header", "content": "Example calculation" },
    { "type": "checkbox", "id": "show_example", "label": "Show example", "default": true },
    { "type": "text", "id": "example_label", "label": "Label", "default": "Example" },
    { "type": "number", "id": "example_new", "label": "New phone price (CAD)", "default": 1099 },
    { "type": "number", "id": "example_trade", "label": "Trade-in value (CAD)", "default": 640 },
    { "type": "header", "content": "Bonus badge" },
    { "type": "checkbox", "id": "show_bonus", "label": "Show bonus badge", "default": false },
    { "type": "text", "id": "bonus_text", "label": "Badge text", "default": "+$50 bonus when you trade toward a purchase" }
  ],
  "presets": [{ "name": "Trade-in banner" }]
}
{% endschema %}
