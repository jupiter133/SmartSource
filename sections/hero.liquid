<section class="hero page-width-wide" style="--hero-bg: {% if section.settings.bg_style == 'solid' %}{{ section.settings.bg }}{% else %}var(--grad){% endif %}; --hero-ink: {{ section.settings.ink }}">
  <div class="hero__inner">
    <div class="hero__text">
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.subheading }}</p>
      {%- if section.settings.button_label != blank -%}<a class="btn btn--light" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{%- endif -%}
    </div>
    <div class="hero__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 750px) 55vw, 100vw' }}
      {%- else -%}{% render 'device-art', kind: 'hero', title: 'Devices', section: section %}{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Hero banner", "settings": [
  { "type": "text", "id": "heading", "label": "Heading", "default": "Meet the Smart Essentials." },
  { "type": "text", "id": "subheading", "label": "Subheading", "default": "Great price. Trusted quality. Hand-picked by our experts." },
  { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
  { "type": "url", "id": "button_link", "label": "Button link" },
  { "type": "image_picker", "id": "image", "label": "Image (transparent PNG works best)" },
  { "type": "select", "id": "bg_style", "label": "Background style", "options": [{"value":"gradient","label":"Theme gradient"},{"value":"solid","label":"Solid colour"}], "default": "gradient" },
  { "type": "color", "id": "bg", "label": "Solid background colour", "default": "#19C3E6" },
  { "type": "color", "id": "ink", "label": "Text", "default": "#FFFFFF" }
], "presets": [{ "name": "Hero banner" }] }
{% endschema %}
