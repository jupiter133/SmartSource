{%- assign n = 0 -%}
{%- capture cards -%}
{%- paginate metaobjects.customer_review.values by 250 -%}
{%- for r in metaobjects.customer_review.values -%}
  {%- if r.test_only.value and request.design_mode != true -%}{%- continue -%}{%- endif -%}
  {%- assign rating = r.rating.value | plus: 0 -%}
  {%- if rating < section.settings.min_rating or r.body.value == blank or r.date.value == blank -%}{%- continue -%}{%- endif -%}
  {%- assign rp = r.product.value -%}
  {%- if section.settings.photos_only and r.photos.value.size == 0 -%}{%- continue -%}{%- endif -%}
  {%- if n >= section.settings.limit -%}{%- break -%}{%- endif -%}
  {%- assign n = n | plus: 1 -%}
  {%- capture stars -%}{%- for i in (1..5) -%}<span{% if i > rating %} class="is-off"{% endif %}>★</span>{%- endfor -%}{%- endcapture -%}
  {%- assign pname = r.location.value -%}{%- if rp -%}{%- assign pname = rp.title -%}{%- endif -%}{%- if r.variant.value != blank -%}{%- assign pname = pname | append: ' - ' | append: r.variant.value -%}{%- endif -%}
  <article class="rs-card{% if r.photos.value.size == 0 %} rs-card--nophoto{% endif %}">
    <button type="button" class="rs-card__top" data-rs-open aria-label="Read review by {{ r.author.value | escape }}">
      {%- if r.photos.value.size > 0 -%}<span class="rs-card__bg">{{ r.photos.value.first | image_url: width: 700 | image_tag: loading: 'lazy', alt: '' }}</span>{%- endif -%}
      <span class="rs-card__name">{{ r.author.value }}</span>
      <span class="rs-card__txt">{{ r.body.value | strip_html | truncate: 150 }}</span>
      <span class="rs-card__stars">{{ stars }} <b>{{ rating }}/5</b></span>
    </button>
    <div class="rs-card__prod">
      {%- if rp and rp.featured_image -%}{{ rp.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
      <span>{{ pname }}</span>
    </div>
    <template data-rs-detail>
      {%- if r.photos.value.size > 0 -%}<div class="rs-m__gal">
        <div class="rs-m__main">{%- for ph in r.photos.value -%}{{ ph | image_url: width: 1400 | image_tag: loading: 'lazy', alt: 'Customer photo', data-rs-slide: forloop.index0 }}{%- endfor -%}</div>
        {%- if r.photos.value.size > 1 -%}<div class="rs-m__thumbs"><button type="button" class="rs-m__nav" data-rs-step="-1" aria-label="Previous photo">‹</button>{%- for ph in r.photos.value -%}<button type="button" class="rs-m__thumb" data-rs-go="{{ forloop.index0 }}">{{ ph | image_url: width: 160 | image_tag: alt: '' }}</button>{%- endfor -%}<button type="button" class="rs-m__nav" data-rs-step="1" aria-label="Next photo">›</button></div>{%- endif -%}
      </div>{%- endif -%}
      <div class="rs-m__panel">
        <div class="rs-m__head"><p class="rs-m__name">{{ r.author.value }}</p>{%- if r.verified.value -%}<span class="rs-m__badge">✓ Verified purchase</span>{%- endif -%}</div>
        <p class="rs-m__date">Reviewed {{ r.date.value | date: '%-m/%-d/%y' }}</p>
        <p class="rs-m__stars">{{ stars }} <b>{{ rating }}/5</b></p>
        {%- if r.title.value != blank -%}<p class="rs-m__title">{{ r.title.value }}</p>{%- endif -%}
        <p class="rs-m__body" data-rs-body>{{ r.body.value | escape | newline_to_br }}</p>
        <button type="button" class="rs-m__more" data-rs-more hidden>Show more</button>
        <div class="rv-prod">
          <div class="rv-prod__card">
            {%- if rp and rp.featured_image -%}{{ rp.featured_image | image_url: width: 80 | image_tag: class: 'rv-prod__img', alt: '' }}{%- endif -%}
            <div class="rv-prod__info">
              <p class="rv-prod__title">{% if rp %}<a href="{{ rp.url }}" class="rv-prod__name">{{ pname }}</a>{% else %}<span class="rv-prod__name">{{ pname }}</span>{% endif %}<span class="rs-m__i" aria-hidden="true">ⓘ</span></p>
              {%- if r.condition.value != blank -%}<p class="rs-m__line">Condition <b>{{ r.condition.value }}</b> <span class="rs-m__i" aria-hidden="true">ⓘ</span></p>{%- endif -%}
              <p class="rs-m__line">Purchased <b>{{ r.date.value | date: '%-m/%-d/%y' }}</b></p>
            </div>
          </div>
          <span class="rv-prod__helpful">{{ r.helpful.value | default: 0 }} 👍</span>
        </div>
      </div>
    </template>
  </article>
{%- endfor -%}
{%- endpaginate -%}
{%- endcapture -%}

{%- if n > 0 -%}
<div class="rs" id="rs-{{ section.id }}">
  <div class="rs__wrap">
    <div class="rs__head">
      <h2>{{ section.settings.title }}</h2>
      <div class="rs__arrows"><button type="button" data-rs-prev aria-label="Previous" disabled>‹</button><button type="button" data-rs-next aria-label="Next">›</button></div>
    </div>
    {%- if request.design_mode -%}<p class="rv-testnote">Test reviews show in the theme editor only. Shoppers only see real reviews.</p>{%- endif -%}
    <div class="rs__track" data-rs-track>{{ cards }}</div>
  </div>
  <dialog class="rs-m" data-rs-modal>
    <div class="rs-m__bar"><p data-rs-mtitle></p><button type="button" data-rs-close aria-label="Close">✕</button></div>
    <div class="rs-m__content" data-rs-content></div>
  </dialog>
</div>
<script>
(function(){var R=document.getElementById('rs-{{ section.id }}');if(!R)return;
var t=R.querySelector('[data-rs-track]'),p=R.querySelector('[data-rs-prev]'),nx=R.querySelector('[data-rs-next]'),m=R.querySelector('[data-rs-modal]'),c=R.querySelector('[data-rs-content]'),cur=0;
function st(){p.disabled=t.scrollLeft<=4;nx.disabled=t.scrollLeft+t.clientWidth>=t.scrollWidth-4}
function go(d){var k=t.querySelector('.rs-card');t.scrollBy({left:d*(k?k.offsetWidth+24:340),behavior:'smooth'})}
p.onclick=function(){go(-1)};nx.onclick=function(){go(1)};t.addEventListener('scroll',st,{passive:true});st();
function slide(i){var s=c.querySelectorAll('[data-rs-slide]');if(!s.length)return;cur=(i+s.length)%s.length;s.forEach(function(x,j){x.hidden=j!==cur});c.querySelectorAll('[data-rs-go]').forEach(function(b,j){b.classList.toggle('is-on',j===cur)})}
t.addEventListener('click',function(e){var b=e.target.closest('[data-rs-open]');if(!b)return;var card=b.closest('.rs-card');c.innerHTML=card.querySelector('[data-rs-detail]').innerHTML;c.classList.toggle('is-single',!c.querySelector('.rs-m__gal'));R.querySelector('[data-rs-mtitle]').textContent=card.querySelector('.rs-card__prod span').textContent;slide(0);m.showModal();var bd=c.querySelector('[data-rs-body]'),mb=c.querySelector('[data-rs-more]');if(bd&&mb){bd.classList.add('is-clamped');mb.hidden=bd.scrollHeight<=bd.clientHeight+2;mb.onclick=function(){bd.classList.remove('is-clamped');mb.hidden=true}}});
c.addEventListener('click',function(e){var g=e.target.closest('[data-rs-go]'),s=e.target.closest('[data-rs-step]');if(g)slide(+g.dataset.rsGo);if(s)slide(cur+ +s.dataset.rsStep)});
function shut(){m.classList.add('is-closing');setTimeout(function(){m.classList.remove('is-closing');m.close()},260)}R.querySelector('[data-rs-close]').onclick=shut;m.addEventListener('click',function(e){if(e.target===m)shut()});m.addEventListener('cancel',function(e){e.preventDefault();shut()})})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Review showcase",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Don't just take our word for it" },
    { "type": "range", "id": "limit", "label": "Max reviews", "min": 4, "max": 30, "step": 1, "default": 12 },
    { "type": "range", "id": "min_rating", "label": "Minimum rating", "min": 1, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "photos_only", "label": "Only reviews with customer photos", "default": false, "info": "Off: reviews without photos use the product image." }
  ],
  "presets": [{ "name": "Review showcase" }]
}
{% endschema %}
