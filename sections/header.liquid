{%- liquid
  assign help_url = section.settings.help_link | default: '/pages/contact'
  if help_url contains '/pages/'
    assign hh = help_url | split: '/pages/' | last | split: '?' | first
    if pages[hh].id == blank
      assign help_url = '/pages/contact'
    endif
  endif
-%}
<header class="header">
  {%- if section.settings.show_utility -%}
  <div class="header__utility-bar">
  <div class="header__utility page-width">
    <nav class="utility-links">
      {%- if section.settings.utility_menu == blank -%}
        <a href="/pages/our-promise">{% render 'icon', name: 'shield' %}Our Promise</a>
        <a href="/pages/why-refurbished">Why pre-owned</a>
        <a href="/blogs/journal">Tech Journal</a>
      {%- else -%}
        {%- for link in section.settings.utility_menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
      {%- endif -%}
    </nav>
    <div class="utility-right">
      {%- if section.settings.show_postal -%}
        <details class="utility-pop utility-postal" data-postal>
          <summary>{% render 'icon', name: 'pin' %}<span class="utility-underline" data-postal-label>Update postal code</span></summary>
          <div class="utility-pop__panel">
            <label for="PostalInput">Your postal code</label>
            <p class="utility-pop__hint">We'll use it to show delivery times and nearby stores.</p>
            <div class="utility-postal__row">
              <input id="PostalInput" type="text" inputmode="text" autocomplete="postal-code" maxlength="7" placeholder="e.g. M5V 2T6" data-postal-input>
              <button type="button" class="btn btn--dark btn--sm" data-postal-save>Save</button>
            </div>
            <p class="utility-pop__err" data-postal-err hidden>Enter a valid Canadian postal code, like M5V 2T6.</p>
          </div>
        </details>
      {%- endif -%}
      {%- form 'localization', class: 'utility-locale' -%}
        <div class="utility-locale__row">
        {%- assign cc = localization.country.iso_code -%}
        <details class="utility-pop utility-country">
          <summary aria-label="Country: {{ localization.country.name }} ({{ localization.country.currency.iso_code }})">
            <span class="utility-flag">{% render 'flag', code: cc %}</span>
            <span class="utility-chev" aria-hidden="true"></span>
          </summary>
          <div class="utility-pop__panel utility-country__panel">
            {%- if localization.available_countries.size > 1 -%}
              <p class="utility-pop__title">Ship to</p>
              {%- for c in localization.available_countries -%}
                <button type="submit" name="country_code" value="{{ c.iso_code }}" class="utility-country__opt{% if c.iso_code == cc %} is-active{% endif %}"><span class="utility-flag">{% render 'flag', code: c.iso_code %}</span>{{ c.name }} ({{ c.currency.iso_code }})</button>
              {%- endfor -%}
            {%- else -%}
              <p class="utility-pop__title">Shipping to {{ localization.country.name }}</p>
              <p class="utility-pop__hint">Prices in {{ localization.country.currency.iso_code }}.</p>
            {%- endif -%}
          </div>
        </details>
        <span class="utility-langs">
          {%- for l in localization.available_languages -%}
            {%- if l.iso_code == localization.language.iso_code -%}
              <span class="is-active">{{ l.endonym_name | capitalize }}</span>
            {%- else -%}
              <button type="submit" name="locale_code" value="{{ l.iso_code }}">{{ l.endonym_name | capitalize }}</button>
            {%- endif -%}
            {%- unless forloop.last -%}<span class="utility-sep" aria-hidden="true">|</span>{%- endunless -%}
          {%- endfor -%}
        </span>
        </div>
      {%- endform -%}
    </div>
  </div>
  </div>
  {%- endif -%}
  <div class="header__main page-width">
    <button class="icon-btn header__burger" aria-label="Menu" aria-controls="HeaderMenu" aria-expanded="false" data-menu-toggle>{% render 'icon', name: 'menu' %}</button>
    <a href="{{ routes.root_url }}" class="header__logo">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 400 | image_tag: width: section.settings.logo_width, alt: shop.name }}
      {%- else -%}<img src="{{ 'logo-smartsource.png' | asset_url }}" alt="{{ shop.name | escape }}" width="{{ section.settings.logo_width }}" height="{{ section.settings.logo_width | times: 220 | divided_by: 900 }}" style="width:{{ section.settings.logo_width }}px;height:auto">{%- endif -%}
    </a>
    <form action="{{ routes.search_url }}" class="header__search" role="search" data-search-box>
      <span class="header__search-field">
      {% render 'icon', name: 'search' %}
      <input type="search" name="q" placeholder="{{ section.settings.search_placeholder }}" value="{{ search.terms | escape }}" aria-label="Search" role="combobox" aria-expanded="false" aria-controls="SearchPanel" aria-autocomplete="list" autocomplete="off"{% if section.settings.search_words != blank %} data-search-anim{% endif %}>
      {%- if section.settings.search_words != blank -%}
        {%- assign sw = section.settings.search_words | split: ',' -%}
        {%- assign longest = '' -%}
        {%- for w in sw -%}{%- assign ws = w | strip -%}{%- if ws.size > longest.size -%}{%- assign longest = ws -%}{%- endif -%}{%- endfor -%}
        {%- assign n = sw.size -%}
        {%- assign step = 2.4 -%}
        {%- assign total = step | times: n -%}
        {%- assign slot = 100.0 | divided_by: n -%}
        <style>
          @keyframes search-word-{{ section.id }}{
            0%{opacity:0;transform:translateY(60%)}
            {{ slot | times: 0.12 }}%{opacity:1;transform:none}
            {{ slot | times: 0.88 }}%{opacity:1;transform:none}
            {{ slot }}%{opacity:0;transform:translateY(-60%)}
            100%{opacity:0;transform:translateY(-60%)}
          }
          #SearchAnim-{{ section.id }} .search-anim__word{animation:search-grad 4s linear infinite,search-word-{{ section.id }} {{ total }}s linear infinite}
        </style>
        <span class="search-anim" id="SearchAnim-{{ section.id }}" aria-hidden="true">{{ section.settings.search_prefix }} <span class="search-anim__words"><span class="search-anim__sizer">{{ longest }}</span>{%- for w in sw -%}<span class="search-anim__word" style="animation-delay:0s,{{ step | times: forloop.index0 }}s">{{ w | strip }}</span>{%- endfor -%}</span></span>
      {%- endif -%}
      </span>
      <input type="hidden" name="type" value="product">
      <div class="search-panel" id="SearchPanel" data-search-panel>
        <div class="search-panel__inner">
        <div data-search-idle>
          {%- if section.settings.search_chat_label != blank -%}
            <button type="button" class="search-panel__ask" data-search-chat data-href="{{ help_url }}">{% render 'icon', name: 'chat' %}<span>{{ section.settings.search_chat_label }}</span></button>
          {%- endif -%}
          <p class="search-panel__label">Popular searches</p>
          <ul class="search-panel__list" role="listbox" aria-label="Popular searches">
            {%- assign lines = section.settings.popular_searches | newline_to_br | split: '<br />' -%}
            {%- for line in lines -%}
              {%- assign parts = line | strip | split: '|' -%}
              {%- assign label = parts.first | strip -%}
              {%- if label == blank -%}{%- continue -%}{%- endif -%}
              {%- if parts.size > 1 -%}{%- assign href = parts.last | strip -%}{%- else -%}{%- assign q = label | url_param_escape -%}{%- assign href = routes.search_url | append: '?type=product&q=' | append: q -%}{%- endif -%}
              <li role="option"><a class="search-panel__item" href="{{ href }}"><span>{{ label }}</span></a></li>
            {%- endfor -%}
          </ul>
        </div>
        <div data-search-results hidden aria-live="polite"></div>
        </div>
      </div>
    </form>
    {%- if section.settings.tradein_label != blank -%}
      <a class="header__tradein" href="{{ section.settings.tradein_link | default: '/pages/sell-your-device' }}">{% render 'icon', name: 'cash' %}<span>{{ section.settings.tradein_label }}</span></a>
    {%- endif -%}
    <div class="header__actions">
      {%- if help_url != blank -%}<a class="header__text-link" href="{{ help_url }}">Need help?</a>{%- endif -%}
      {%- if shop.customer_accounts_enabled -%}
        <a class="icon-btn" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" aria-label="Account">{% render 'icon', name: 'user' %}</a>
      {%- endif -%}
      <a class="icon-btn cart-link" href="{{ routes.cart_url }}" aria-label="Cart" data-cart-open>
        {% render 'icon', name: 'bag' %}<span class="cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
  <nav class="header__nav-wrap" id="HeaderMenu" data-menu>
  <div class="header__nav page-width">
    <ul class="nav-scroll">
      {%- if section.settings.nav_source == 'builtin' or section.settings.main_menu == blank -%}
        {% render 'nav-default', section: section %}
      {%- else -%}
      {%- for link in section.settings.main_menu.links -%}
        {%- assign deal = false -%}{%- assign lt = link.title | downcase -%}{%- if section.settings.highlight_first and forloop.first and lt != 'home' -%}{%- assign deal = true -%}{%- endif -%}{%- if lt contains 'deal' -%}{%- assign deal = true -%}{%- endif -%}
        <li class="nav-item{% if link.links.size > 0 %} has-mega{% endif %}" data-nav-item>
          {%- liquid
            assign nav_url = link.url
            case lt
              when 'iphone', 'iphones'
                assign nav_url = '/pages/iphone'
              when 'android'
                assign nav_url = '/pages/android'
              when 'macbook', 'macbooks'
                assign nav_url = '/collections/macbook'
              when 'laptops'
                assign nav_url = '/pages/laptops'
              when 'tablets'
                assign nav_url = '/pages/tablets'
              when 'consoles'
                assign nav_url = '/pages/consoles'
              when 'smartwatches'
                assign nav_url = '/pages/smartwatches'
              when 'budget phones', 'budget'
                assign nav_url = '/pages/budget-phones'
              when 'audio'
                assign nav_url = '/pages/audio'
              when 'accessories'
                assign nav_url = '/pages/accessories'
            endcase
          -%}
          <a href="{% render 'page-url', url: nav_url %}" class="nav-link{% if deal %} nav-deal{% endif %}{% if link.active or link.child_active %} is-active{% endif %}" {% if link.links.size > 0 %}aria-haspopup="true" aria-expanded="false"{% endif %}>{% if deal %}✦ {% endif %}{{ link.title }}</a>
          {%- if link.links.size > 0 -%}
            <div class="mega" data-mega>
              <div class="mega__inner">
                {% render 'mega-side', section: section, title: link.title %}
                <div class="mega__main">
                  <div class="mega__head"><p class="mega__label">Categories</p><a href="{{ link.url }}" class="mega__all">See all</a></div>
                  <div class="mega__grid">
                    {%- for child in link.links -%}
                      {%- assign img = blank -%}
                      {%- case child.type -%}
                        {%- when 'collection_link' -%}{%- assign img = child.object.image | default: child.object.featured_image -%}
                        {%- when 'product_link' -%}{%- assign img = child.object.featured_image -%}
                      {%- endcase -%}
                      {%- capture tint -%}{% cycle '#FDE7EC', '#F6E6FB', '#DDF9EC', '#DCF7F4', '#EEEAFD' %}{%- endcapture -%}
                      <a class="mega-tile" href="{{ child.url }}">
                        <span class="mega-tile__img" style="--tint: {{ tint }}">
                          {%- if img != blank -%}{{ img | image_url: width: 400 | image_tag: loading: 'lazy', sizes: '200px', alt: child.title }}{%- else -%}{% render 'device-art', title: child.title, section: section, idx: forloop.index %}{%- endif -%}
                        </span>
                        <span class="mega-tile__title">{{ child.title }}</span>
                      </a>
                    {%- endfor -%}
                  </div>
                </div>
              </div>
            </div>
          {%- endif -%}
        </li>
      {%- else -%}
        <li><a href="/collections/all" class="nav-link nav-deal">✦ Steal Deals</a></li><li><a class="nav-link" href="/collections/all">iPhone</a></li><li><a class="nav-link" href="/collections/all">Android</a></li><li><a class="nav-link" href="/collections/all">MacBook</a></li><li><a class="nav-link" href="/collections/all">Laptops</a></li><li><a class="nav-link" href="/collections/all">Accessories</a></li>
      {%- endfor -%}
      {%- endif -%}
    </ul>
    <ul class="nav-side">
      {%- if section.settings.side_menu == blank -%}
        <li><a class="nav-link nav-side-link" href="/pages/sell-your-device"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 11a8 8 0 00-14.3-4.9L4 8"/><path d="M4 4v4h4"/><path d="M4 13a8 8 0 0014.3 4.9L20 16"/><path d="M20 20v-4h-4"/><path d="M12 9v6M9 12h6"/></svg>Trade in</a></li>
        <li><a class="nav-link nav-side-link" href="{{ routes.root_url | append: '/pages/plans' | replace: '//', '/' }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M11 18.5h2"/></svg>Mobile plans</a></li>
        <li><a class="nav-link nav-side-link" href="/pages/mail-in-repair"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 2.6v5.6c0 4.6-3 8.1-7 9.8-4-1.7-7-5.2-7-9.8V5.6z"/><path d="M8.8 12.2l2.2 2.2 4.2-4.4"/></svg>Mail-In Repair</a></li>
      {%- else -%}
        {%- for link in section.settings.side_menu.links -%}<li><a class="nav-link" href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
  </nav>
</header>
<div class="search-scrim" aria-hidden="true"></div>
{% schema %}
{ "name": "Header", "settings": [
  { "type": "image_picker", "id": "logo", "label": "Logo" },
  { "type": "range", "id": "logo_width", "label": "Logo width", "min": 80, "max": 300, "step": 10, "unit": "px", "default": 180 },
  { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search iPhone, PS5…" },
  { "type": "text", "id": "search_prefix", "label": "Animated placeholder: lead-in", "default": "Search for" },
  { "type": "textarea", "id": "popular_searches", "label": "Search dropdown: popular searches", "default": "iPhone | /collections/all/iphone\niPad | /collections/all/ipad\nMacBook | /collections/all/macbook\nSamsung Galaxy | /collections/all/samsung\nTrade in your tech | /pages/sell-your-device\nShop all deals | /collections/all?sort_by=price-ascending", "info": "One per line: Label | link. Leave out the link to run a search for that word." },
  { "type": "text", "id": "search_chat_label", "label": "Search dropdown: help row", "default": "Need help choosing? Chat with us", "info": "Opens live chat if installed, otherwise the help page. Leave blank to hide." },
  { "type": "text", "id": "search_words", "label": "Animated placeholder: rotating words", "default": "iPhone, Samsung, MacBook, PS5, AirPods, iPad, Apple Watch, Pixel", "info": "Comma-separated. Leave blank to use the plain placeholder above." },
  { "type": "select", "id": "nav_source", "label": "Category menu source", "options": [{"value":"builtin","label":"Built-in electronics menu"},{"value":"shopify","label":"My Shopify menu (below)"}], "default": "builtin", "info": "Built-in links filter by product tag (e.g. iphone, samsung, macbook)." },
  { "type": "link_list", "id": "main_menu", "label": "Category menu", "default": "main-menu" },
  { "type": "checkbox", "id": "highlight_first", "label": "Highlight first link as deals", "default": true },
  { "type": "link_list", "id": "side_menu", "label": "Right-side menu (Trade in, Services...)" },
  { "type": "checkbox", "id": "show_utility", "label": "Show utility row", "default": true },
  { "type": "checkbox", "id": "show_postal", "label": "Show \"Update postal code\"", "default": true },
  { "type": "link_list", "id": "utility_menu", "label": "Utility links (Promise, Blog...)" },
  { "type": "url", "id": "help_link", "label": "Help link" },
  { "type": "text", "id": "tradein_label", "label": "Sell button label", "default": "Sell device", "info": "Shows next to the search bar. Leave blank to hide." },
  { "type": "url", "id": "tradein_link", "label": "Trade-in button link", "info": "Defaults to /pages/sell-your-device." },
  { "type": "paragraph", "content": "Dropdowns: add child links under a main menu item (Navigation). Collection images become the tiles." }
], "blocks": [{ "type": "good_to_know", "name": "Dropdown: Good to know", "settings": [
  { "type": "select", "id": "icon", "label": "Icon", "options": [{"value":"swap","label":"Trade-in"},{"value":"tag","label":"Deal"},{"value":"award","label":"Warranty"},{"value":"truck","label":"Shipping"},{"value":"shield","label":"Secure"}], "default": "swap" },
  { "type": "text", "id": "title", "label": "Title", "default": "Trade-in" },
  { "type": "text", "id": "text", "label": "Text", "default": "Get up to $700 for your old device" },
  { "type": "url", "id": "link", "label": "Link" },
  { "type": "text", "id": "only_for", "label": "Only show under these menu items", "info": "Comma-separated, e.g. iPhone, Android, Tablets. Blank = all dropdowns." }
]}]}
{% endschema %}

