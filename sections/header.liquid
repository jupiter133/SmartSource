<header class="header">
  {%- if section.settings.show_utility -%}
  <div class="header__utility-bar">
  <div class="header__utility page-width">
    <nav class="utility-links">
      {%- if section.settings.utility_menu == blank -%}
        <a href="/pages/our-promise">{% render 'icon', name: 'shield' %}Our Promise</a>
        <a href="/pages/why-refurbished">Why refurbished</a>
        <a href="/blogs/news">Tech Journal</a>
      {%- else -%}
        {%- for link in section.settings.utility_menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
      {%- endif -%}
    </nav>
    <div class="utility-right">
      {%- form 'localization', class: 'utility-locale' -%}
        <span class="utility-loc">{% render 'icon', name: 'pin' %}<span>{{ localization.country.name }} ({{ localization.country.currency.iso_code }})</span></span>
        {%- if localization.available_countries.size > 1 -%}
          <select name="country_code" onchange="this.form.submit()" aria-label="Country">
            {%- for c in localization.available_countries -%}<option value="{{ c.iso_code }}" {% if c.iso_code == localization.country.iso_code %}selected{% endif %}>{{ c.name }} ({{ c.currency.iso_code }})</option>{%- endfor -%}
          </select>
        {%- endif -%}
        {%- if localization.available_languages.size > 1 -%}
          <input type="hidden" name="locale_code" value="{{ localization.language.iso_code }}" data-locale-input>
          <span class="utility-langs">
            {%- for l in localization.available_languages -%}
              <button type="submit" class="{% if l.iso_code == localization.language.iso_code %}is-active{% endif %}" onclick="this.form.querySelector('[data-locale-input]').value='{{ l.iso_code }}'">{{ l.endonym_name | capitalize }}</button>{% unless forloop.last %}<span>|</span>{% endunless %}
            {%- endfor -%}
          </span>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
  </div>
  {%- endif -%}
  <div class="header__main page-width">
    <button class="icon-btn header__burger" aria-label="Menu" aria-controls="HeaderMenu" aria-expanded="false" data-menu-toggle>{% render 'icon', name: 'menu' %}</button>
    <a href="{{ routes.root_url }}" class="header__logo">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 400 | image_tag: width: section.settings.logo_width, alt: shop.name }}
      {%- else -%}<span>{{ shop.name }}</span>{%- endif -%}
    </a>
    <form action="{{ routes.search_url }}" class="header__search" role="search" data-search-box>
      {% render 'icon', name: 'search' %}
      <input type="search" name="q" placeholder="{{ section.settings.search_placeholder }}" value="{{ search.terms | escape }}" aria-label="Search" role="combobox" aria-expanded="false" aria-controls="SearchPanel" aria-autocomplete="list" autocomplete="off"{% if section.settings.search_words != blank %} data-search-anim{% endif %}>
      {%- if section.settings.search_words != blank -%}
        <span class="search-anim" aria-hidden="true" data-words="{{ section.settings.search_words | escape }}">{{ section.settings.search_prefix }} <span class="search-anim__word">{{ section.settings.search_words | split: ',' | first | strip }}</span></span>
      {%- endif -%}
      <input type="hidden" name="type" value="product">
      <div class="search-panel" id="SearchPanel" data-search-panel hidden>
        <div data-search-idle>
          {%- if section.settings.search_chat_label != blank -%}
            <button type="button" class="search-panel__ask" data-search-chat data-href="{{ section.settings.help_link | default: '/pages/help' }}">{% render 'icon', name: 'chat' %}<span>{{ section.settings.search_chat_label }}</span></button>
          {%- endif -%}
          <p class="search-panel__label">Popular searches</p>
          <ul class="search-panel__list" role="listbox" aria-label="Popular searches">
            {%- assign lines = section.settings.popular_searches | newline_to_br | split: '<br />' -%}
            {%- for line in lines -%}
              {%- assign parts = line | strip | split: '|' -%}
              {%- assign label = parts.first | strip -%}
              {%- if label == blank -%}{%- continue -%}{%- endif -%}
              {%- if parts.size > 1 -%}{%- assign href = parts.last | strip -%}{%- else -%}{%- assign q = label | url_param_escape -%}{%- assign href = routes.search_url | append: '?type=product&q=' | append: q -%}{%- endif -%}
              <li role="option"><a class="search-panel__item" href="{{ href }}">{% render 'icon', name: 'search' %}<span>{{ label }}</span></a></li>
            {%- endfor -%}
          </ul>
        </div>
        <div data-search-results hidden aria-live="polite"></div>
      </div>
    </form>
    {%- if section.settings.tradein_label != blank -%}
      <a class="header__tradein" href="{{ section.settings.tradein_link | default: '/pages/sell-your-device' }}">{% render 'icon', name: 'swap' %}<span>{{ section.settings.tradein_label }}</span></a>
    {%- endif -%}
    <div class="header__actions">
      {%- if section.settings.help_link != blank -%}<a class="header__text-link" href="{{ section.settings.help_link }}">Need help?</a>{%- endif -%}
      {%- if shop.customer_accounts_enabled -%}
        <a class="icon-btn" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" aria-label="Account">{% render 'icon', name: 'user' %}</a>
      {%- endif -%}
      <a class="icon-btn cart-link" href="{{ routes.cart_url }}" aria-label="Cart" data-cart-open>
        {% render 'icon', name: 'bag' %}<span class="cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
  <nav class="header__nav-wrap" id="HeaderMenu" data-menu>
  <div class="header__nav page-width">
    <ul class="nav-scroll">
      {%- if section.settings.nav_source == 'builtin' or section.settings.main_menu == blank -%}
        {% render 'nav-default', section: section %}
      {%- else -%}
      {%- for link in section.settings.main_menu.links -%}
        {%- assign deal = false -%}{%- assign lt = link.title | downcase -%}{%- if section.settings.highlight_first and forloop.first and lt != 'home' -%}{%- assign deal = true -%}{%- endif -%}{%- if lt contains 'deal' -%}{%- assign deal = true -%}{%- endif -%}
        <li class="nav-item{% if link.links.size > 0 %} has-mega{% endif %}" data-nav-item>
          <a href="{{ link.url }}" class="nav-link{% if deal %} nav-deal{% endif %}{% if link.active or link.child_active %} is-active{% endif %}" {% if link.links.size > 0 %}aria-haspopup="true" aria-expanded="false"{% endif %}>{% if deal %}✦ {% endif %}{{ link.title }}</a>
          {%- if link.links.size > 0 -%}
            <div class="mega" data-mega>
              <div class="mega__inner">
                {% render 'mega-side', section: section, title: link.title %}
                <div class="mega__main">
                  <div class="mega__head"><p class="mega__label">Categories</p><a href="{{ link.url }}" class="mega__all">See all</a></div>
                  <div class="mega__grid">
                    {%- for child in link.links -%}
                      {%- assign img = blank -%}
                      {%- case child.type -%}
                        {%- when 'collection_link' -%}{%- assign img = child.object.image | default: child.object.featured_image -%}
                        {%- when 'product_link' -%}{%- assign img = child.object.featured_image -%}
                      {%- endcase -%}
                      {%- capture tint -%}{% cycle '#FDE7EC', '#F6E6FB', '#DDF9EC', '#DCF7F4', '#EEEAFD' %}{%- endcapture -%}
                      <a class="mega-tile" href="{{ child.url }}">
                        <span class="mega-tile__img" style="--tint: {{ tint }}">
                          {%- if img != blank -%}{{ img | image_url: width: 400 | image_tag: loading: 'lazy', sizes: '200px', alt: child.title }}{%- else -%}{% render 'device-art', title: child.title, section: section, idx: forloop.index %}{%- endif -%}
                        </span>
                        <span class="mega-tile__title">{{ child.title }}</span>
                      </a>
                    {%- endfor -%}
                  </div>
                </div>
              </div>
            </div>
          {%- endif -%}
        </li>
      {%- else -%}
        <li><a href="/collections/all" class="nav-link nav-deal">✦ Great deals</a></li><li><a class="nav-link" href="/collections/all">iPhone</a></li><li><a class="nav-link" href="/collections/all">Android</a></li><li><a class="nav-link" href="/collections/all">MacBook</a></li><li><a class="nav-link" href="/collections/all">Laptops</a></li><li><a class="nav-link" href="/collections/all">Accessories</a></li>
      {%- endfor -%}
      {%- endif -%}
    </ul>
    <ul class="nav-side">
      {%- if section.settings.side_menu == blank -%}
        <li><a class="nav-link nav-side-link" href="/pages/sell-your-device">{% render 'icon', name: 'swap' %}Trade in</a></li>
        <li><a class="nav-link nav-side-link" href="/pages/phone-plans">{% render 'icon', name: 'phone' %}Phone plans</a></li>
        <li><a class="nav-link nav-side-link" href="/pages/services">{% render 'icon', name: 'shield' %}Services</a></li>
      {%- else -%}
        {%- for link in section.settings.side_menu.links -%}<li><a class="nav-link" href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
  </nav>
</header>
{% schema %}
{ "name": "Header", "settings": [
  { "type": "image_picker", "id": "logo", "label": "Logo" },
  { "type": "range", "id": "logo_width", "label": "Logo width", "min": 80, "max": 300, "step": 10, "unit": "px", "default": 150 },
  { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search iPhone, PS5…" },
  { "type": "text", "id": "search_prefix", "label": "Animated placeholder: lead-in", "default": "Search for" },
  { "type": "textarea", "id": "popular_searches", "label": "Search dropdown: popular searches", "default": "iPhone | /collections/all/iphone\niPad | /collections/all/ipad\nMacBook | /collections/all/macbook\nSamsung Galaxy | /collections/all/samsung\nTrade in your tech | /pages/sell-your-device\nShop all deals | /collections/all?sort_by=price-ascending", "info": "One per line: Label | link. Leave out the link to run a search for that word." },
  { "type": "text", "id": "search_chat_label", "label": "Search dropdown: help row", "default": "Need help choosing? Chat with us", "info": "Opens live chat if installed, otherwise the help page. Leave blank to hide." },
  { "type": "text", "id": "search_words", "label": "Animated placeholder: rotating words", "default": "iPhone, MacBook, PS5, AirPods, Galaxy S25, iPad, Apple Watch, Pixel", "info": "Comma-separated. Leave blank to use the plain placeholder above." },
  { "type": "select", "id": "nav_source", "label": "Category menu source", "options": [{"value":"builtin","label":"Built-in electronics menu"},{"value":"shopify","label":"My Shopify menu (below)"}], "default": "builtin", "info": "Built-in links filter by product tag (e.g. iphone, samsung, macbook)." },
  { "type": "link_list", "id": "main_menu", "label": "Category menu", "default": "main-menu" },
  { "type": "checkbox", "id": "highlight_first", "label": "Highlight first link as deals", "default": true },
  { "type": "link_list", "id": "side_menu", "label": "Right-side menu (Trade in, Services...)" },
  { "type": "checkbox", "id": "show_utility", "label": "Show utility row", "default": true },
  { "type": "link_list", "id": "utility_menu", "label": "Utility links (Promise, Blog...)" },
  { "type": "url", "id": "help_link", "label": "Help link" },
  { "type": "text", "id": "tradein_label", "label": "Trade-in button label", "default": "Trade-in", "info": "Shows next to the search bar. Leave blank to hide." },
  { "type": "url", "id": "tradein_link", "label": "Trade-in button link", "info": "Defaults to /pages/sell-your-device." },
  { "type": "paragraph", "content": "Dropdowns: add child links under a main menu item (Navigation). Collection images become the tiles." }
], "blocks": [{ "type": "good_to_know", "name": "Dropdown: Good to know", "settings": [
  { "type": "select", "id": "icon", "label": "Icon", "options": [{"value":"swap","label":"Trade-in"},{"value":"tag","label":"Deal"},{"value":"award","label":"Warranty"},{"value":"truck","label":"Shipping"},{"value":"shield","label":"Secure"}], "default": "swap" },
  { "type": "text", "id": "title", "label": "Title", "default": "Trade-in" },
  { "type": "text", "id": "text", "label": "Text", "default": "Get up to $700 for your old device" },
  { "type": "url", "id": "link", "label": "Link" },
  { "type": "text", "id": "only_for", "label": "Only show under these menu items", "info": "Comma-separated, e.g. iPhone, Android, Tablets. Blank = all dropdowns." }
]}]}
{% endschema %}
