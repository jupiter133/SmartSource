[
  {
    "name": "theme_info",
    "theme_name": "SmartSource",
    "theme_version": "1.0.0",
    "theme_author": "SmartSource",
    "theme_documentation_url": "https://help.shopify.com",
    "theme_support_url": "https://help.shopify.com"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (gradient start)",
        "default": "#19C3E6",
        "info": "Used for buttons, banners, hero and highlights."
      },
      {
        "type": "color",
        "id": "color_accent_2",
        "label": "Accent 2 (gradient end)",
        "default": "#FF4FA3"
      },
      {
        "type": "color",
        "id": "color_accent_text",
        "label": "Text on accent",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#0E0E0E"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Page background",
        "default": "#F6F6F8"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Card background",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_highlight",
        "label": "Highlight (pills, badges)",
        "default": "#E6DBFF"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Deal / sale color",
        "default": "#D4256A"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1200
      },
      {
        "type": "range",
        "id": "radius",
        "label": "Corner radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 12
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Products",
    "settings": [
      {
        "type": "paragraph",
        "content": "Condition badges come from product tags: condition:new, condition:refurbished, condition:used. Compare-at price is shown as the 'new' price."
      },
      {
        "type": "checkbox",
        "id": "show_refurb_badge",
        "label": "Show \"Refurbished\" badge on product cards",
        "default": false,
        "info": "Off: only New and Used get a badge, since everything else is refurbished."
      },
      {
        "type": "checkbox",
        "id": "show_new_price",
        "label": "Show compare-at price as \"new\" price",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_rating",
        "label": "Show ratings (uses reviews.rating metafield)",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "cart_drawer",
        "label": "Open cart drawer on add",
        "default": true
      }
    ]
  },
  {
    "name": "Sell program",
    "settings": [
      {
        "type": "paragraph",
        "content": "One place for the buyback terms. The Sell page, FAQ, quote wizard and confirmation screen all read these. In any text field on the Sell page you can write {quote_valid_days}, {payment_business_days} or {prices_updated_date}, and wrap a sentence in [if_free_return]...[/if_free_return] or [if_instore_pay]...[/if_instore_pay] to show it only when that option is on."
      },
      {
        "type": "checkbox",
        "id": "sell_live",
        "label": "Buyback Live",
        "default": true,
        "info": "OFF = offers show 'Preview offer, not final' and customers can't submit a quote. Turn on once your real buyback prices are loaded."
      },
      {
        "type": "range",
        "id": "quote_valid_days",
        "label": "Quote valid / ship within (days)",
        "min": 7,
        "max": 60,
        "step": 1,
        "unit": "d",
        "default": 21
      },
      {
        "type": "range",
        "id": "payment_business_days",
        "label": "Payment after we receive it (business days)",
        "min": 1,
        "max": 30,
        "step": 1,
        "unit": "d",
        "default": 5
      },
      {
        "type": "checkbox",
        "id": "free_return_on_decline",
        "label": "Free return if customer declines a revised offer",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "instore_instant_pay",
        "label": "Pay in-store drop-offs on the spot",
        "default": true
      },
      {
        "type": "text",
        "id": "prices_updated_date",
        "label": "Prices last updated",
        "info": "Shown under the price list, e.g. October 6, 2026. Leave blank to hide."
      },
      {
        "type": "header",
        "content": "Value over time chart (estimates)"
      },
      {
        "type": "paragraph",
        "content": "The \"Best time to sell\" chart shows today's offer and estimated future values: today's value times these percentages. It always says future values are estimates."
      },
      {
        "type": "range",
        "id": "sell_value_1m",
        "label": "Estimated value in 1 month",
        "min": 50,
        "max": 100,
        "step": 1,
        "unit": "%",
        "default": 97
      },
      {
        "type": "range",
        "id": "sell_value_3m",
        "label": "Estimated value in 3 months",
        "min": 50,
        "max": 100,
        "step": 1,
        "unit": "%",
        "default": 91
      },
      {
        "type": "range",
        "id": "sell_value_6m",
        "label": "Estimated value in 6 months",
        "min": 50,
        "max": 100,
        "step": 1,
        "unit": "%",
        "default": 83
      }
    ]
  },
  {
    "name": "Journal",
