[
  {
    "name": "theme_info",
    "theme_name": "SmartSource",
    "theme_version": "1.0.0",
    "theme_author": "SmartSource",
    "theme_documentation_url": "https://help.shopify.com",
    "theme_support_url": "https://help.shopify.com"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (gradient start)",
        "default": "#19C3E6",
        "info": "Used for buttons, banners, hero and highlights."
      },
      {
        "type": "color",
        "id": "color_accent_2",
        "label": "Accent 2 (gradient end)",
        "default": "#FF4FA3"
      },
      {
        "type": "color",
        "id": "color_accent_text",
        "label": "Text on accent",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#0E0E0E"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Page background",
        "default": "#F6F6F8"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Card background",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_highlight",
        "label": "Highlight (pills, badges)",
        "default": "#E6DBFF"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Deal / sale color",
        "default": "#D4256A"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "label": "Page width",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "default": 1200
      },
      {
        "type": "range",
        "id": "radius",
        "label": "Corner radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 12
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Products",
    "settings": [
      {
        "type": "paragraph",
        "content": "Condition badges come from product tags: condition:new, condition:refurbished, condition:used. Compare-at price is shown as the 'new' price."
      },
      {
        "type": "checkbox",
        "id": "show_refurb_badge",
        "label": "Show \"Refurbished\" badge on product cards",
        "default": false,
        "info": "Off: only New and Used get a badge, since everything else is refurbished."
      },
      {
        "type": "checkbox",
        "id": "show_new_price",
        "label": "Show compare-at price as \"new\" price",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_rating",
        "label": "Show ratings (uses reviews.rating metafield)",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "cart_drawer",
        "label": "Open cart drawer on add",
        "default": true
      }
    ]
  },
  {
    "name": "Sell program",
    "settings": [
      {
        "type": "paragraph",
        "content": "One place for the buyback terms. The Sell page, FAQ, quote wizard and confirmation screen all read these. In any text field on the Sell page you can write {quote_valid_days}, {payment_business_days} or {prices_updated_date}, and wrap a sentence in [if_free_return]...[/if_free_return] or [if_instore_pay]...[/if_instore_pay] to show it only when that option is on."
      },
      {
        "type": "range",
        "id": "quote_valid_days",
        "label": "Quote valid / ship within (days)",
        "min": 7,
        "max": 60,
        "step": 1,
        "unit": "d",
        "default": 21
      },
      {
        "type": "range",
        "id": "payment_business_days",
        "label": "Payment after we receive it (business days)",
        "min": 1,
        "max": 30,
        "step": 1,
        "unit": "d",
        "default": 5
      },
      {
        "type": "checkbox",
        "id": "free_return_on_decline",
        "label": "Free return if customer declines a revised offer",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "instore_instant_pay",
        "label": "Pay in-store drop-offs on the spot",
        "default": true
      },
      {
        "type": "text",
        "id": "prices_updated_date",
        "label": "Prices last updated",
        "info": "Shown under the price list, e.g. October 6, 2026. Leave blank to hide."
      }
    ]
  },
  {
    "name": "Journal",
    "settings": [
      {
        "type": "header",
        "content": "Journal (blog)"
      },
      {
        "type": "text",
        "id": "journal_blog",
        "label": "Blog handle",
        "default": "journal"
      },
      {
        "type": "url",
        "id": "journal_repair_url",
        "label": "Repair service link"
      },
      {
        "type": "paragraph",
        "content": "Authors: tag a post author-<handle> (e.g. author-editors) and set the post's author name to match."
      },
      {
        "type": "header",
        "content": "Author 1"
      },
      {
        "type": "text",
        "id": "author_1_handle",
        "label": "Handle",
        "default": "editors"
      },
      {
        "type": "text",
        "id": "author_1_name",
        "label": "Name (must match post author)",
        "default": "SmartSource Editors"
      },
      {
        "type": "text",
        "id": "author_1_role",
        "label": "Role",
        "default": "Buying guides & comparisons"
      },
      {
        "type": "textarea",
        "id": "author_1_bio",
        "label": "Bio",
        "default": "We compare devices the way you'd compare them: price, battery, camera, and how long it'll last. No spec-sheet worship."
      },
      {
        "type": "textarea",
        "id": "author_1_credentials",
        "label": "Credentials (one per line)"
      },
      {
        "type": "image_picker",
        "id": "author_1_image",
        "label": "Photo"
      },
      {
        "type": "header",
        "content": "Author 2"
      },
      {
        "type": "text",
        "id": "author_2_handle",
        "label": "Handle",
        "default": "repair-bench"
      },
      {
        "type": "text",
        "id": "author_2_name",
        "label": "Name (must match post author)",
        "default": "SmartSource Repair Bench"
      },
      {
        "type": "text",
        "id": "author_2_role",
        "label": "Role",
        "default": "Repair technicians"
      },
      {
        "type": "textarea",
        "id": "author_2_bio",
        "label": "Bio",
        "default": "The team that tests, grades and repairs every device we sell. If a fix is safe to do at home, we'll show you. If it isn't, we'll say so."
      },
      {
        "type": "textarea",
        "id": "author_2_credentials",
        "label": "Credentials (one per line)"
      },
      {
        "type": "image_picker",
        "id": "author_2_image",
        "label": "Photo"
      },
      {
        "type": "header",
        "content": "Author 3"
      },
      {
        "type": "text",
        "id": "author_3_handle",
        "label": "Handle"
      },
      {
        "type": "text",
        "id": "author_3_name",
        "label": "Name (must match post author)"
      },
      {
        "type": "text",
        "id": "author_3_role",
        "label": "Role"
      },
      {
        "type": "textarea",
        "id": "author_3_bio",
        "label": "Bio"
      },
      {
        "type": "textarea",
        "id": "author_3_credentials",
        "label": "Credentials (one per line)"
      },
      {
        "type": "image_picker",
        "id": "author_3_image",
        "label": "Photo"
      },
      {
        "type": "header",
        "content": "Author 4"
      },
      {
        "type": "text",
        "id": "author_4_handle",
        "label": "Handle"
      },
      {
        "type": "text",
        "id": "author_4_name",
        "label": "Name (must match post author)"
      },
      {
        "type": "text",
        "id": "author_4_role",
        "label": "Role"
      },
      {
        "type": "textarea",
